#!/bin/bash

# 🔒 Target server credentials
REMOTE_USER="pxy"
REMOTE_PASS="Pxy@tatlako00"

# 🌐 Predefined server mapping
BHANU_IP="20.219.143.148"
LAKSHMI_IP="40.80.88.158"
BITTU_IP="20.235.105.173"

# 🔍 Check if sshpass is installed, install based on OS if missing
if ! command -v sshpass &> /dev/null; then
    echo "⚠️ sshpass is not installed. Detecting OS..."
    # 🍏 macOS Detection
    if [ "$(uname)" == "Darwin" ]; then
        if ! command -v brew &> /dev/null; then
            echo "❌ Error: Homebrew is not installed. Please install Homebrew (https://brew.sh) to automate this setup."
            exit 1
        else
            echo "⚙️ Installing sshpass via Homebrew on macOS..."
            brew install esolitos/ipa/sshpass
        fi
    # 🐧 Linux Detection
    elif [ "$(expr substr $(uname -s) 1 5)" == "Linux" ]; then
        echo "⚙️ Installing sshpass on Linux..."
        if [ -f /etc/debian_version ]; then
            sudo apt-get update && sudo apt-get install -y sshpass
        elif [ -f /etc/redhat-release ]; then
            sudo yum install -y sshpass
        else
            echo "❌ Unsupported Linux distribution. Please install sshpass manually."
            exit 1
        fi
    else
        echo "❌ Unknown Operating System. Please install sshpass manually."
        exit 1
    fi
fi

while true; do
    clear
    echo "================================="
    echo "   ⬛📈📉  PXY SYSTEM MENU  ®️   "
    echo "================================="
    echo "1) Go to Bhanu ☀️"
    echo "2) Go to Lakshmi 🪷"
    echo "3) Go to Bittu 🐻"
    echo "e) Go-Out / Exit 🚪"
    echo "================================="
    
    read -p "Select an option [1-3 or Enter to Exit]: " CHOICE

    # Check if the user pressed Enter (empty input) or 'e'
    if [ -z "$CHOICE" ] || [ "$CHOICE" == "e" ]; then
        echo "👋 Exiting... Goodbye!"
        exit 0
    fi

    case $CHOICE in
        1)
            REMOTE_HOST="$BHANU_IP"
            SERVER_NAME="Bhanu ☀️"
            ;;
        2)
            REMOTE_HOST="$LAKSHMI_IP"
            SERVER_NAME="Lakshmi 🪷"
            ;;
        3)
            REMOTE_HOST="$BITTU_IP"
            SERVER_NAME="Bittu 🐻"
            ;;
        *)
            echo "❌ Invalid choice. Press Enter to try again."
            read
            continue
            ;;
    esac

    # 🚀 Execute SSH Connection
    echo "🚀 Connecting to $SERVER_NAME ($REMOTE_HOST)..."
    sshpass -p "$REMOTE_PASS" ssh -o StrictHostKeyChecking=no "$REMOTE_USER@$REMOTE_HOST"

    # 🛑 Pause after session ends before returning to menu
    echo "🔌 Session closed. Press Enter to return to menu."
    read
done
