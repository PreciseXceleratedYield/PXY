#!/bin/bash
# PXY Linux server selection menu. No embedded passwords or sudo.
set -u
REMOTE_USER="${PXY_SSH_USER:-pxy}"
BHANU_IP="20.219.143.148"
LAKSHMI_IP="40.80.88.158"
BITTU_IP="20.235.105.173"

is_local_server() {
    local target="$1" ips
    ips=$(hostname -I 2>/dev/null || :)
    case " $ips " in *" $target "*) return 0 ;; esac
    # Cloud hosts may expose their public IP only via their SSH connection.
    case "${SSH_CONNECTION:-}" in
      *" $target "*) return 0 ;;
    esac
    return 1
}

while true; do
    clear
    echo "================================="
    echo "   ⬛📈📉  PXY SYSTEM MENU  ®️"
    echo "================================="
    echo "1) Go to Bhanu ☀️"
    echo "2) Go to Lakshmi 🪷"
    echo "3) Go to Bittu 🐻"
    echo "e) Go-Out / Exit 🚪"
    echo "================================="
    read -r -p "Select an option [1-3 or Enter to Exit]: " CHOICE || exit 0
    case "$CHOICE" in
      ""|e|E) echo "👋 Exiting... Goodbye!"; exit 0 ;;
      1) REMOTE_HOST="$BHANU_IP"; SERVER_NAME="Bhanu ☀️" ;;
      2) REMOTE_HOST="$LAKSHMI_IP"; SERVER_NAME="Lakshmi 🪷" ;;
      3) REMOTE_HOST="$BITTU_IP"; SERVER_NAME="Bittu 🐻" ;;
      *) echo "Invalid choice."; read -r -p "Press Enter to continue..." _ || :; continue ;;
    esac
    if is_local_server "$REMOTE_HOST"; then
      echo "Already on $SERVER_NAME. No SSH connection needed."
      read -r -p "Press Enter to return to menu..." _ || :
      continue
    fi
    echo "Connecting to $SERVER_NAME ($REMOTE_HOST)..."
    ssh -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
    read -r -p "Session closed. Press Enter to return to menu..." _ || :
done
