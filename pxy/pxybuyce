#!/bin/bash
set -e
# ------------------------------
# Run exepxy.py from ~/pxy/sys/exe
# ------------------------------

# Go to exe folder
cd "$HOME/pxy/sys/exe" || { echo "Directory ~/pxy/sys/exe not found"; exit 1; }

# Optional: activate virtual environment if needed
#source ~/pxy/env/bin/activate

# Run the Python script with argument 1 to execute option 1 directly
python3 exeforcepxy.py 1

# Optional: print completion
echo "exeforcepxy.py option 1 execution finished."
