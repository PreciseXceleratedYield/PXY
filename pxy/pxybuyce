#!/bin/bash
# REMOVED 'set -e' to prevent the script from killing the calling engine on errors

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Verify Path Helper existence
if [ -f "$SCRIPT_DIR/pxyresolve" ]; then
    source "$SCRIPT_DIR/pxyresolve"
elif [ -f "$HOME/.local/bin/pxyresolve" ]; then
    source "$HOME/.local/bin/pxyresolve"
else
    echo "[⚠️ ERROR] PXY path helper not found." >&2
    exit 0
fi

# Locate the core application directory
PXY_APP_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[⚠️ ERROR] Could not locate the PXY application directory." >&2
    exit 0
}

ENGINE_DIR="$PXY_APP_DIR/sys/exe"

# Verify that the direct order router utility exists
if [ ! -f "$ENGINE_DIR/exeexacpxy.py" ]; then
    echo "[⚠️ ERROR] Direct order router utility not found: $ENGINE_DIR/exeexacpxy.py" >&2
    exit 0
fi

cd "$ENGINE_DIR" || { echo "[⚠️ ERROR] Could not enter engine directory: $ENGINE_DIR" >&2; exit 0; }

# Extract the calculated numeric offset parameter ($1) passed by execbuypxy.py
OFFSET="${1:-0}"
shift # Shift arguments to pass the remaining flags safely to Python

echo "🔄 Firing Direct CE Order Route via exeexacpxy.py (Offset: $OFFSET)..."

# Safe execution block: Route straight to the order router tool for CE side
python3 exeexacpxy.py --side CE --offset "$OFFSET" "${@}"
PYTHON_EXIT_CODE=$?

if [ $PYTHON_EXIT_CODE -ne 0 ]; then
    echo "❌ BASH ERROR: Direct CE entry failed with exit code $PYTHON_EXIT_CODE. Parent engine loop preserved." >&2
else
    echo "✅ CE entry script execution finished cleanly."
fi

# Always exit 0 to guarantee that the master calling loop stays alive
exit 0

