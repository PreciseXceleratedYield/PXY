//@version=5
indicator("Supertrend 3:3 & Trend Following Flips (Surgical Mode 0)", overlay=true, precision=2)

// --- INPUTS ---
atrPeriod = input.int(3, title="ATR Length")
atrMult   = input.float(3.0, title="ATR Multiplier")
smaPeriod = input.int(50, title="SMA Period") // Kept at 50 as requested, ignored in signal logic

// --- MODE 0 SURGICAL FLIPPED CANDLE GEOMETRY ---
// Get completed previous standard candle details (RESTORED EXACTLY)
prevHigh  = high[1]
prevLow   = low[1]
prevClose = close[1]
prevRange = prevHigh - prevLow

// Calculate 1/4 and 3/4 target levels from previous range
calcQuarterLevel      = prevLow + (prevRange * 0.25) // 1/4 level
calcThreeQuarterLevel = prevLow + (prevRange * 0.75) // 3/4 level

// Determine trend direction state for the candle shape based on custom close vs 3/4 level
isGreen = (close >= calcThreeQuarterLevel)
candleColor = isGreen ? color.green : color.red

// Apply the Flipped Geometry Corrections
modOpen  = isGreen ? calcQuarterLevel : calcThreeQuarterLevel
modHigh  = isGreen ? high : math.max(high, prevClose)
modLow   = isGreen ? math.min(low, prevClose) : low
modClose = close

// Plot the calculated system candles directly to your screen (Hide default chart elements in settings)
plotcandle(modOpen, modHigh, modLow, modClose, title="PXY Mode 0 Candles", color=candleColor, wickcolor=candleColor, bordercolor=candleColor)

// --- NATIVE ATR GENERATION & BAND MATRICES (Using Mod Candle Values) ---
modHL2   = (modHigh + modLow) / 2.0
atrValue = ta.atr(atrPeriod) // Uses default series index tracking mapped smoothly
float upBand = modHL2 - (atrMult * atrValue)
float dnBand = modHL2 + (atrMult * atrValue)

// --- MEMORY HOLDERS ---
var float lowerBand = 0.0
var float upperBand = 0.0
var int trendDirection = 1

// --- STRUCTURAL SUPERTREND LINE LOCKS ---
lowerBand := (modClose[1] > lowerBand[1]) ? math.max(upBand, lowerBand[1]) : upBand
upperBand := (modClose[1] < upperBand[1]) ? math.min(dnBand, upperBand[1]) : dnBand

// --- REGIME SHIFT GATES ---
if modClose > upperBand[1]
    trendDirection := 1
else if modClose < lowerBand[1]
    trendDirection := -1

float superTrendPlot = trendDirection == 1 ? lowerBand : upperBand

// --- VERY THIN MOVING AVERAGE & ST LINES ---
color trendColor = trendDirection == 1 ? color.green : color.red
// linewidth=1 forces the thinnest line rendering format
plot(superTrendPlot, title="Supertrend Line", color=trendColor, linewidth=1)

// SMA 50 calculated using your custom system close matrix
sma50 = ta.sma(modClose, smaPeriod)
plot(sma50, title="SMA 50 Line", color=color.blue, linewidth=1)

// --- SIGNAL STATE TRACKING ---
// 1. Major Trend Crossover Switches
bool crossBuy  = (trendDirection == 1) and (trendDirection[1] == -1)
bool crossSell = (trendDirection == -1) and (trendDirection[1] == 1)

// 2. Trend Following Continuation Flips (Using Modified Open/Close boundaries)
bool isGreenCandle = modClose > modOpen
bool isRedCandle   = modClose < modOpen

// RUN_UP: Master trend is already green, and the candle body just flipped from Red to Green
bool runUp = (trendDirection == 1) and isGreenCandle and (modClose[1] <= modOpen[1])
// RUN_DN: Master trend is already red, and the candle body just flipped from Green to Red
bool runDn = (trendDirection == -1) and isRedCandle and (modClose[1] >= modOpen[1])

// UNQUALIFIED: Counter-trend flips (candle color changes opposite to the current Supertrend line)
bool unqualifiedFlipUp = (trendDirection == -1) and isGreenCandle and (modClose[1] <= modOpen[1])
bool unqualifiedFlipDn = (trendDirection == 1) and isRedCandle and (modClose[1] >= modOpen[1])
bool anyUnqualifiedFlip = unqualifiedFlipUp or unqualifiedFlipDn

// Define exact requested dark text colors
color darkGreenText = color.rgb(0, 100, 0)
color darkRedText   = color.rgb(139, 0, 0)

// --- SHAPE ALERTS CONFIGURATION ---
// Major Trend Changes (Large triangles with dark labels)
plotshape(crossBuy,  title="CROSSBUY Switch",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal, text="CROSS BUY", textcolor=darkGreenText)
plotshape(crossSell, title="CROSSSELL Switch", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.normal, text="CROSS SELL", textcolor=darkRedText)

// Running Continuation Signals (ONLY change: replaced arrows with Tick Emoji markers)
plotshape(runUp and not crossBuy,   title="RUNNING UP Flip",   style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 100), text="✔️", textcolor=darkGreenText, size=size.small)
plotshape(runDn and not crossSell,  title="RUNNING DOWN Flip", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 100),   text="✔️", textcolor=darkRedText,   size=size.small)

// Unqualified Flip Marker (Prints an X emoji when candle closes opposite to the current ST bias)
plotshape(anyUnqualifiedFlip, title="Unqualified Flip Marker", style=shape.labeldown, location=location.abovebar, color=color.new(color.gray, 100), text="❌", textcolor=color.gray, size=size.small)

// --- SYSTEM WEBHOOK CONFIGURATIONS ---
alertcondition(crossBuy,  title="Alert: Cross Buy Switch",  message="CROSSBUY")
alertcondition(crossSell, title="Alert: Cross Sell Switch", message="CROSSSELL")
alertcondition(runUp,     title="Alert: Running Up Flip",    message="RUN_UP")
alertcondition(runDn,     title="Alert: Running Down Flip",  message="RUN_DN")


