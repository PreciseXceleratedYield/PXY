#!/bin/bash

export RUNMODE=SIM

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$HOME/pxy"

if [ ! -f "$REPO_DIR/sys/syssimpxy.py" ]; then
    REPO_DIR="$SCRIPT_DIR"
fi

if [ ! -f "$REPO_DIR/sys/syssimpxy.py" ]; then
    echo "[X] Could not locate sys/syssimpxy.py under $REPO_DIR." >&2
    exit 1
fi

if [ -f "$HOME/env/bin/activate" ]; then
    source "$HOME/env/bin/activate"
fi

exec python3 "$REPO_DIR/sys/syssimpxy.py" "$@"
