#!/bin/bash
set -e
# Resolve the engine directory from this launcher so the repository can live
# under either ~/pxy or ~/PXY (or another checkout path).
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

cd "$SCRIPT_DIR/sys/exe" || { echo "Engine directory not found: $SCRIPT_DIR/sys/exe"; exit 1; }

# Optional: activate virtual environment if needed
# source ~/pxy/env/bin/activate

# Run the Python script with argument 2 to execute option 2 directly
python3 exeforcepxy.py 2

# Optional: print completion
echo "exeforcepxy.py option 2 execution finished."
