//@version=5
indicator("PreciseXceleratedYield Pvt Ltd™ - Supertrend Edition", overlay=true)

// ==========================================
// CONFIGURATION & INPUTS
// ==========================================
int mode = input.int(0, title="OHLC Mode", minval=0, maxval=5, 
     tooltip="0: Hyper-Sensitive, 1: Raw, 2: Mid-Body, 3: Full Range, 4: Heikin-Ashi, 5: Master Ensemble")

int sma_length = input.int(50, title="SMA Length", minval=1)

// ==========================================
// VECTORIZED OHLC MODE TRANSFORMATIONS
// ==========================================
// Capture raw candle data arrays in memory
float raw_o = open
float raw_h = high
float raw_l = low
float raw_c = close

// Initialize output variables
float out_o = raw_o
float out_h = raw_h
float out_l = raw_l
float out_c = raw_c

// --- Mode 0: Hyper-Sensitive Modified Close ---
float m0_c = raw_c >= raw_o ? (raw_c + raw_h) / 2.0 : (raw_c + raw_l) / 2.0

// --- Mode 1: Raw Candles ---
float m1_c = raw_c

// --- Mode 2: Mid-Body (OC/2) ---
float m2_c = (raw_o + raw_c + raw_c) / 3.0

// --- Mode 3: Full Range (OHLC/4) ---
float m3_c = (raw_o + raw_h + raw_l + raw_c) / 4.0

// --- Mode 4: Standard Heikin-Ashi ---
// HA Close is the average of current OHLC
float m4_c = (raw_o + raw_h + raw_l + raw_c) / 4.0
// HA Open uses historical state recursion (handled natively by Pine using logic history)
float m4_o = na(out_o[1]) ? (raw_o + raw_c) / 2.0 : (out_o[1] + out_c[1]) / 2.0

// --- Mode 5: Master Ensemble Average ---
float m5_c = (m0_c + m1_c + m2_c + m3_c + m4_c) / 5.0

// ==========================================
// SWITCH EXECUTION ENGINE
// ==========================================
if mode == 0
    out_c := m0_c
else if mode == 1
    out_c := m1_c
else if mode == 2
    out_c := m2_c
else if mode == 3
    out_c := m3_c
else if mode == 4
    out_o := m4_o
    out_c := m4_c
    out_h := math.max(raw_h, math.max(out_o, out_c))
    out_l := math.min(raw_l, math.min(out_o, out_c))
else if mode == 5
    out_c := m5_c

// ==========================================
// BASELINE INDICATOR CALCULATION
// ==========================================
// Dynamic SMA calculation derived from the active mode's transformed Close
float mode_sma = ta.sma(out_c, sma_length)

// ==========================================
// SUPERTREND ON MODE-SMA ENGINE (Period 1, Factor 1)
// ==========================================
float atr_1 = ta.atr(1)
float basic_ub = mode_sma + (1.0 * atr_1)
float basic_lb = mode_sma - (1.0 * atr_1)

// Initialize trailing bands and system trend variables
var float final_ub = na
var float final_lb = na
var int internal_dir = 1 // 1 for BULL, -1 for BEAR
var float supertrend_line = na

// Capture historical values from previous bar to prevent lookahead jumps
float prev_ub = final_ub[1]
float prev_lb = final_lb[1]
float prev_sma = mode_sma[1]

// Calculate trailing Upper Band
if not na(prev_ub) and prev_sma < prev_ub
    final_ub := math.min(basic_ub, prev_ub)
else
    final_ub := basic_ub

// Calculate trailing Lower Band
if not na(prev_lb) and prev_sma > prev_lb
    final_lb := math.max(basic_lb, prev_lb)
else
    final_lb := basic_lb

// Evaluate Crossover Logic against prior bands to manage trend flips
if internal_dir == 1 and mode_sma < final_lb
    internal_dir := -1
else if internal_dir == -1 and mode_sma > final_ub
    internal_dir := 1

// Assign active Supertrend Line price mapping
supertrend_line := internal_dir == 1 ? final_lb : final_ub

// ==========================================
// TREND DEFINITION & PLOTTING ENGINE
// ==========================================
// CRITICAL: Trend is determined strictly by asset Price (Close) above or below this line
bool is_st_bull = close > supertrend_line
color supertrend_color = is_st_bull ? color.green : color.red

// Plot the unified Supertrend line (Replaces original mode_sma plot)
plot(supertrend_line, title="Supertrend Line (Alias for All)", color=supertrend_color, linewidth=2)

// Determine candle color condition based on the selected execution mode
bool is_bullish = mode == 2 ? (out_c >= out_c[1]) : (out_c >= out_o)
color candle_color = is_bullish ? color.green : color.red

// Plot the transformed candle bars directly on the chart layout
plotcandle(out_o, out_h, out_l, out_c, title="Transformed Candles", 
           color = candle_color, 
           wickcolor = candle_color)


