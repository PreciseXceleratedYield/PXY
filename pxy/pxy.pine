//@version=5
indicator("Multi-Condition Price Color", overlay=true)

// Inputs for SMA lengths
sma21_len = input.int(21, title="SMA 21 Length")
sma50_len = input.int(50, title="SMA 50 Length")

// Calculate SMAs
sma21 = ta.sma(close, sma21_len)
sma50 = ta.sma(close, sma50_len)

// Conditions
// C1: price > 21 and 21 > 50
cond1 = close > sma21 and sma21 > sma50
// C2: price < 21 and 21 < 50
cond2 = close < sma21 and sma21 < sma50
// C3: 21 > 50 and price is not above 21
cond3 = sma21 > sma50 and close <= sma21
// C4: 21 < 50 and price > 21
cond4 = sma21 < sma50 and close > sma21

// Color assignment based on conditions
price_color = cond1 ? color.new(color.green, 0) : 
              cond2 ? color.new(color.red, 0) : 
              cond3 ? color.new(color.green, 60) : 
              cond4 ? color.new(color.red, 60) : 
              color.gray

// Plotting the lines
plot(sma21, title="SMA 21", color=color.blue, linewidth=2)
plot(sma50, title="SMA 50", color=color.orange, linewidth=2)

// Plotting Price Line with conditional color
plot(close, title="Price Line", color=price_color, linewidth=3)
