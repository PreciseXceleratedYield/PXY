//@version=5
indicator("PXY.PINE", overlay=true)

// --- Inputs (Updated to 3 and 1.4) ---
atrPeriod  = input.int(3, title="ATR Period")
multiplier = input.float(1.4, title="Multiplier")
showBackground = input.bool(true, title="Color Background by State")

// --- 1. Standard Supertrend Calculation ---
atrValue = ta.atr(atrPeriod)
src      = hl2

upperBandBasic = src + multiplier * atrValue
lowerBandBasic = src - multiplier * atrValue

var float upBand = na
var float dnBand = na
var int trend    = 1

prevUpBand = nz(upBand, upperBandBasic)
prevDnBand = nz(dnBand, lowerBandBasic)

upBand := src < prevUpBand ? math.min(upperBandBasic, prevUpBand) : upperBandBasic
dnBand := src > prevDnBand ? math.max(lowerBandBasic, prevDnBand) : lowerBandBasic

// Trend Switch / Jump Trigger
prevTrend = trend
if trend == -1 and ta.crossover(close, prevUpBand)
    trend := 1
else if trend == 1 and ta.crossunder(close, prevDnBand)
    trend := -1

stLine = (trend == 1) ? dnBand : upBand

// --- 2. Anchor Tracking for Inverse Mirror Logic ---
var float anchorPrice = na

if trend != prevTrend
    anchorPrice := src

if barstate.isfirst
    anchorPrice := src

// Compute the Inverted Slope Mirror Line
stDistanceFromAnchor = stLine - anchorPrice
mirrorLine = anchorPrice - stDistanceFromAnchor

// --- 3. Evaluate the Three-State Market Filter ---
highestLine = math.max(stLine, mirrorLine)
lowestLine  = math.min(stLine, mirrorLine)

string marketState = "SIDE"
color stateBgColor = color.new(color.gray, 95)

if close > highestLine
    marketState := "BULL"
    stateBgColor := color.new(color.green, 92)
else if close < lowestLine
    marketState := "BEAR"
    stateBgColor := color.new(color.red, 92)
else
    marketState := "SIDE"
    stateBgColor := color.new(color.orange, 94)

// --- 4. Visual Plots ---
stColor = (trend == 1) ? color.green : color.red
plot(stLine, color=stColor, linewidth=3, title="Standard Supertrend")
plot(mirrorLine, color=color.new(stColor, 40), linewidth=2, title="Inverse Mirror Line")

bgcolor(showBackground ? stateBgColor : na, title="Market Condition Background")
