//@version=5
indicator("PreciseXceleratedYield Pvt Ltd™", overlay=true)

// ==========================================
// CONFIGURATION & INPUTS
// ==========================================
int mode = input.int(1, title="OHLC Mode", minval=0, maxval=5, 
     tooltip="0: Hyper-Sensitive, 1: Raw, 2: OC/2, 3: OCC/3, 4: OCCC/4, 5: OHLCC/5")

int sma_length = input.int(50, title="SMA Length", minval=1)

// ==========================================
// VECTORIZED OHLC MODE TRANSFORMATIONS
// ==========================================
// Capture raw candle data arrays in memory
float raw_o = open
float raw_h = high
float raw_l = low
float raw_c = close

// Initialize output variables
float out_o = raw_o
float out_h = raw_h
float out_l = raw_l
float out_c = raw_c

// --- Mode 0: Hyper-Sensitive Modified Close ---
float m0_c = raw_c >= raw_o ? (raw_c + raw_h) / 2.0 : (raw_c + raw_l) / 2.0

// --- Mode 1: Raw Candles ---
float m1_c = raw_c

// --- Mode 2: Mid-Body (OC/2) ---
float m2_c = (raw_o + raw_c) / 2.0

// --- Mode 3: OCC/3 ---
float m3_c = (raw_o + (2.0 * raw_c)) / 3.0

// --- Mode 4: OCCC/4 ---
float m4_c = (raw_o + (3.0 * raw_c)) / 4.0

// --- Mode 5: OHLCC/5 ---
float m5_c = (raw_o + raw_h + raw_l + (2.0 * raw_c)) / 5.0

// ==========================================
// SWITCH EXECUTION ENGINE
// ==========================================
if mode == 0
    out_c := m0_c
else if mode == 1
    out_c := m1_c
else if mode == 2
    out_c := m2_c
else if mode == 3
    out_c := m3_c
else if mode == 4
    out_c := m4_c
else if mode == 5
    out_c := m5_c

// ==========================================
// INDICATOR CALCULATIONS & PLOTTING
// ==========================================
// Dynamic SMA calculation derived from the active mode's transformed Close
float mode_sma = ta.sma(out_c, sma_length)

// Plot the SMA line on the chart
plot(mode_sma, title="Mode-Based SMA", color=color.blue, linewidth=2)

// Determine candle color condition based on the selected mode
// Modes 2, 3, 4, 5 modify the Close relative to Open, so we check if the new close beats the raw open
bool is_bullish = out_c >= raw_o
color candle_color = is_bullish ? color.green : color.red

// Optional: Plot the transformed candle bars directly on the chart layout
plotcandle(out_o, out_h, out_l, out_c, title="Transformed Candles", 
           color = candle_color, 
           wickcolor = candle_color)

