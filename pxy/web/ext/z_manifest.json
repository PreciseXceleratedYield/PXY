{
  "manifest_version": 3,
  "name": "PreciseXceleratedYield Pvt Ltd™",
  "short_name": "PreciseXceleratedYield Pvt Ltd™",
  "version": "1.0.0",
  "description": "PXY® — Mobile trading dashboard in side panel.",
  "icons": {
    "16":  "icons/pxy16.png",
