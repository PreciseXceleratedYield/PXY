//@version=5
indicator("PXY® Adaptive Scaling Signal", overlay=true, max_labels_count=500)

// ==========================================
// 1. SESSION & BAR TRACKING
// ==========================================
isNewDay = ta.change(time("D")) != 0
var int barCount = 0
barCount := isNewDay ? 1 : barCount + 1

// ==========================================
// 2. COMPONENTS
// ==========================================
var float firstBarAnchor = na
if isNewDay
    firstBarAnchor := close > open ? high : low

var float runningSum = 0.0
runningSum := isNewDay ? close : runningSum + close
sessionPriceMean = runningSum / barCount

dynamicSMALen = math.min(barCount, 50)
sessionSMA = ta.sma(close, dynamicSMALen)
pythonHybrid = (sessionSMA + sessionPriceMean) / 2

// ==========================================
// 3. BLACK LINE
// ==========================================
float blackLine = na
if barCount <= 15
    blackLine := firstBarAnchor
else if barCount > 15 and barCount <= 45
    float blendFactor = (barCount - 15) / 30.0
    blackLine := (firstBarAnchor * (1 - blendFactor)) + (pythonHybrid * blendFactor)
else
    blackLine := pythonHybrid

// ==========================================
// 4. DOTS & COLOR LOGIC
// ==========================================
p_price = math.round((close + (close + nz(close[1], close))/2 + (close + open)/2 + ohlc4)/4, 4)
p_change = p_price - nz(p_price[1], p_price)

int currentDir = p_change > 0 ? 1 : (p_change < 0 ? -1 : 0)
color pDotColor = currentDir == 1 ? #00FF00 : (currentDir == -1 ? #FF0000 : #808080)

// ==========================================
// 5. ADAPTIVE WINDOW LOGIC (5 to 40)
// ==========================================
var int colorStreak = 0
bool isFlip = (currentDir != 0) and (currentDir != nz(currentDir[1], currentDir))

if isFlip
    colorStreak := 1
else if currentDir != 0
    colorStreak := colorStreak + 1

// Function to check dominance in scaling windows
checkDominance(dir) =>
    bool qualified = false
    // Check windows in increments of 5 up to 40
    for w = 5 to 40 by 5
        int oppAllowed = math.floor(w / 5) // 5=1, 10=2, 15=3... (Adjusted to your 5=0, 10=2 rule below)
        // Adjusting strictly to your request:
        int maxOpp = (w == 5) ? 0 : (w / 5) 
        
        int oppCount = 0
        for i = 1 to w
            if dir[i] != 0 and dir[i] != dir[0] // If dot is opposite of current dot
                oppCount += 1
        
        if oppCount <= maxOpp
            qualified := true
            break
    qualified

bool isCharged = checkDominance(currentDir)
bool buySignal  = isFlip and currentDir == 1  and isCharged[1]
bool sellSignal = isFlip and currentDir == -1 and isCharged[1]

// ==========================================
// 6. PLOTTING
// ==========================================
plot(blackLine, "Black Line", color.black, 3)
plot(p_price, "P-Dots", pDotColor, 3, plot.style_circles)

// Counter Labels
if currentDir != 0
    label.new(bar_index, p_price, str.tostring(colorStreak), color=color.new(color.white, 100), textcolor=pDotColor, style=currentDir == 1 ? label.style_label_down : label.style_label_up, size=size.small)

// BUY/SELL Signal on Flip
if buySignal
    label.new(bar_index, low, "BUY", color=color.green, textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar)

if sellSignal
    label.new(bar_index, high, "SELL", color=color.red, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)

bgcolor(barCount <= 15 ? color.new(color.gray, 92) : (barCount <= 45 ? color.new(color.blue, 96) : na))
