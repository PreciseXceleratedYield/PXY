#!/usr/bin/env python3
"""SSH menu: server list in GitHub, passwords stored only on this computer."""
import getpass
import ipaddress
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

APP_DIR = Path(__file__).resolve().parent
CONFIG = APP_DIR / "pxyconnect.json"
PASSWORDS = Path.home() / ".config" / "pxy" / "passwords.json"

def read_config():
    with CONFIG.open(encoding="utf-8") as file:
        data = json.load(file)
    if not isinstance(data, dict):
        raise ValueError("Invalid GitHub server configuration")
    for name, server in data.items():
        if not isinstance(name, str) or not isinstance(server, dict):
            raise ValueError("Invalid server entry")
        ipaddress.ip_address(server["host"])
        user = server["user"]
        if not isinstance(user, str) or not user or user.startswith("-") or any(c.isspace() for c in user) or "@" in user:
            raise ValueError(f"Invalid SSH username for {name}")
    return data

def read_passwords():
    if not PASSWORDS.exists():
        return {}
    if PASSWORDS.is_symlink() or PASSWORDS.stat().st_mode & 0o077:
        raise PermissionError("Unsafe password file; expected regular file with mode 600")
    with PASSWORDS.open(encoding="utf-8") as file:
        passwords = json.load(file)
    if not isinstance(passwords, dict):
        raise ValueError("Invalid password file")
    return passwords

def write_passwords(passwords):
    directory = PASSWORDS.parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if directory.is_symlink():
        raise PermissionError("Unsafe credentials directory")
    directory.chmod(0o700)
    if PASSWORDS.is_symlink():
        raise PermissionError("Unsafe credentials file")
    tmp = directory / f".passwords.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as file:
            json.dump(passwords, file, indent=2)
            file.write("\n")
        os.replace(tmp, PASSWORDS)
        PASSWORDS.chmod(0o600)
    finally:
        if tmp.exists():
            tmp.unlink()

def connect(name, server):
    if not shutil.which("sshpass"):
        print("Install sshpass first: sudo apt-get install sshpass")
        return
    passwords = read_passwords()
    password = passwords.get(name)
    if not password:
        password = getpass.getpass(f"Password for {name} ({server['user']}@{server['host']}): ")
        if not password:
            print("Connection cancelled.")
            return
        passwords[name] = password
        write_passwords(passwords)
    env = os.environ.copy()
    env["SSHPASS"] = password
    print(f"Connecting to {name} ({server['user']}@{server['host']})...")
    subprocess.run(["sshpass", "-e", "ssh", "-o", "StrictHostKeyChecking=accept-new",
                    f"{server['user']}@{server['host']}"], env=env, check=False)

def main():
    while True:
        try:
            servers = read_config()
            names = list(servers)
            print("\n========================================")
            print("          PXY SSH CONNECTIONS")
            print("========================================")
            for i, name in enumerate(names, 1):
                server = servers[name]
                print(f"{i}) {name} - {server['user']}@{server['host']}")
            print("0) Back")
            selection = input("Select server: ").strip().lower()
            if selection in ("", "0"):
                return
            if selection.isdigit() and 1 <= int(selection) <= len(names):
                name = names[int(selection)-1]
                connect(name, servers[name])
            else:
                print("Invalid selection.")
        except (EOFError, KeyboardInterrupt):
            print("\nExiting.")
            return
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
            print(f"Connection manager error: {exc}", file=sys.stderr)

if __name__ == "__main__":
    main()
