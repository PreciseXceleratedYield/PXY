#!/bin/bash

# ---------------- Base directory ----------------
BASE_DIR=~/pxy

# ---------------- Activate virtualenv ----------------
if [ -f ~/env/bin/activate ]; then
    source ~/env/bin/activate
    echo "✅ Virtual environment activated in $BASE_DIR"
else
    echo "❌ Virtual environment ~/env/bin/activate not found!"
    exit 1
fi

# ---------------- Set program to run ----------------
PROG_FILE="exemainpxy.py"
PROG_DIR="$BASE_DIR/sys/exe"

# ---------------- Switch to program directory ----------------
cd "$PROG_DIR" || { echo "❌ Cannot cd to $PROG_DIR"; exit 1; }

# ---------------- Check if file exists ----------------
if [ ! -f "$PROG_FILE" ]; then
    echo "❌ File '$PROG_FILE' not found in $PROG_DIR"
    exit 1
fi

# ---------------- Run the program ----------------
echo "▶ Running $PROG_FILE in $PROG_DIR ..."
python "$PROG_FILE"

# ---------------- Stay in shell ----------------
echo "✅ Finished running $PROG_FILE. Staying in $(pwd) with virtualenv activated."
exec $SHELL
