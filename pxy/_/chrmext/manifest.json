{
  "manifest_version": 3,
  "name": "Open My URL",
  "version": "1.0",
  "description": "Opens http://20.219.25.209/ in popup",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open URL"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://20.219.25.209/"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://20.219.25.209/;"
  }
}
