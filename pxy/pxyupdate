#!/bin/bash
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/pxyresolve" ]; then
    source "$SCRIPT_DIR/pxyresolve"
elif [ -f "$HOME/.local/bin/pxyresolve" ]; then
    source "$HOME/.local/bin/pxyresolve"
else
    pxy_resolve_app_dir() {
        local script_dir="${1:-}"
        local candidate

        for candidate in \
            "${PXY_APP_DIR:-}" \
            "$HOME/PXY/pxy" \
            "$HOME/pxy" \
            "$script_dir"
        do
            if [ -n "$candidate" ] \
                && [ -f "$candidate/sys/syscnfgpxy.py" ] \
                && [ -f "$candidate/pxy.js" ]; then
                printf '%s\n' "$candidate"
                return 0
            fi
        done

        return 1
    }
fi

REPO_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[X] Could not locate the PXY application directory." >&2
    exit 1
}

if ! git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "[X] Repository not found at $REPO_DIR." >&2
    exit 1
fi

echo " ******** get updates *******"
echo
git -C "$REPO_DIR" fetch origin main
echo

echo " ****** reset software to origin/main ******"
echo
# syscnfgpxy.py is intentionally refreshed with the rest of the tracked code.
git -C "$REPO_DIR" reset --hard origin/main
echo "Updated checkout to $(git -C "$REPO_DIR" rev-parse --short HEAD)."
echo

echo " ****** clear Python caches ******"
echo
find "$REPO_DIR" -type d -name __pycache__ -prune -exec rm -rf {} +
find "$REPO_DIR" -type f -name "*.pyc" -delete
find "$REPO_DIR" -type d -name ".pytest_cache" -prune -exec rm -rf {} +
echo

echo " ****** sync binaries *******"
echo
mkdir -p "$HOME/.local/bin"
for file in "$REPO_DIR"/*; do
    if [ -f "$file" ]; then
        filename=$(basename "$file")
        if [[ "$filename" != *.* ]]; then
            cp "$file" "$HOME/.local/bin/"
            chmod +x "$HOME/.local/bin/$filename"
            echo "-> installed executable command: $filename"
        fi
    fi
done
echo

echo " ***** update completed *****"
echo ""
