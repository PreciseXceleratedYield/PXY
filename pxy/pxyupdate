#!/bin/bash
echo " ******** get updates *******"
echo
# Fetch latest updates from git
git fetch --all
echo

echo " ****** reset software ******"
echo
# Reset local changes to match remote main branch
git reset --hard origin/main
echo

echo " ****** sync binaries *******"
echo
# Fix: Capitalized $HOME variable to target your user directory
mkdir -p "$HOME/.local/bin"

# Loop through everything starting with pxy, or files without an extension
for file in "$HOME/pxy"/pxy* "$HOME/pxy"/*; do
    # Ensure it is a valid file, not a directory
    if [ -f "$file" ]; then
        filename=$(basename "$file")
        
        # Check condition 1: starts with 'pxy' OR condition 2: has no extension
        if [[ "$filename" == pxy* ]] || [[ "$filename" != *.* ]]; then
            # Fix: Capitalized $HOME variable
            cp "$file" "$HOME/.local/bin/" 2>/dev/null
            chmod +x "$HOME/.local/bin/$filename" 2>/dev/null
            echo "-> installed command: $filename"
        fi
    fi
done
echo
echo " ***** update completed *****"
echo ""
