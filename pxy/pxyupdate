echo "       ******** GET UPDATES *******"
echo

# Fetch latest updates from git
git fetch --all
echo

echo "       ****** RESET SOFTWARE ******"
echo

# Reset local changes to match remote main branch
git reset --hard origin/main

# Copy only files WITHOUT an extension to /usr/local/bin
for file in "$HOME/pxy"/*; do
    if [ -f "$file" ] && [[ "$file" != *.* ]]; then
        cp "$file" "$HOME/.local/bin/" 2>/dev/null
    fi
done

# Make sure copied files are executable
chmod +x "$HOME/.local/bin/"* 2>/dev/null

echo
echo "       ***** UPDATE COMPLETED *****"
echo ""
