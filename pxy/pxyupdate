#!/bin/bash
echo " ******** get updates *******"
echo
# Fetch latest updates from git
git fetch --all
echo

echo " ****** reset software ******"
echo
# Reset local changes to match remote main branch
git reset --hard origin/main
echo

echo " ****** sync binaries *******"
echo
# Ensure local bin directory exists
mkdir -p "$HOME/.local/bin"

# Loop through files in the directory
for file in "$HOME/pxy"/*; do
    # Ensure it is a valid file, not a directory
    if [ -f "$file" ]; then
        filename=$(basename "$file")
        
        # Strict condition: File must NOT contain any dot (.) character
        if [[ "$filename" != *.* ]]; then
            cp "$file" "$HOME/.local/bin/" 2>/dev/null
            chmod +x "$HOME/.local/bin/$filename" 2>/dev/null
            echo "-> installed executable command: $filename"
        fi
    fi
done
echo
echo " ***** update completed *****"
echo ""
