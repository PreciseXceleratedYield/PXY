#!/bin/bash
set -Eeuo pipefail

# Update files only. Never stop, start, restart, or signal PXY services.
if [ "${PXY_UPDATE_FROM_WEB:-0}" = "1" ]; then
    exec >> "$HOME/pxyupdate.log" 2>&1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/pxyrslve" ]; then
    source "$SCRIPT_DIR/pxyrslve"
elif [ -f "$HOME/.local/bin/pxyrslve" ]; then
    source "$HOME/.local/bin/pxyrslve"
else
    echo "[X] PXY path helper not found." >&2
    exit 1
fi

REPO_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[X] Could not locate the PXY application directory." >&2
    exit 1
}
pxy_activate_env || exit 1

if ! git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "[X] Repository not found at $REPO_DIR." >&2
    exit 1
fi

echo " ******** get updates *******"
git -C "$REPO_DIR" fetch origin main

echo " ****** reset software to origin/main ******"
git -C "$REPO_DIR" reset --hard origin/main
echo "Updated checkout to $(git -C "$REPO_DIR" rev-parse --short HEAD)."

echo " ****** clear Python caches ******"
find "$REPO_DIR" -type d -name __pycache__ -prune -exec rm -rf {} +
find "$REPO_DIR" -type f -name "*.pyc" -delete
find "$REPO_DIR" -type d -name ".pytest_cache" -prune -exec rm -rf {} +

echo " ****** sync binaries *******"
# Install executable commands into the system command directory (original PXY behavior).
# sudo is required for this installation; never restart running services.
INSTALL_DIR="/usr/local/bin"
for file in "$REPO_DIR"/*; do
    if [ -f "$file" ]; then
        filename=$(basename "$file")
        if [[ "$filename" != *.* ]]; then
            # Remove an existing symlink rather than following it into the checkout.
            # install creates a regular executable with the correct permissions.
            if [ -L "$INSTALL_DIR/$filename" ]; then
                sudo rm -- "$INSTALL_DIR/$filename"
            fi
            sudo install -m 755 -- "$file" "$INSTALL_DIR/$filename"
            echo "-> installed executable command: $filename"
            # ~/.local/bin may precede /usr/local/bin in PATH, and the parent
            # shell may have cached the legacy path. Keep a compatibility link
            # to the freshly installed command instead of deleting the path.
            # A child process cannot clear its parent shell's command hash.
            legacy="$HOME/.local/bin/$filename"
            if [ -f "$legacy" ] || [ -L "$legacy" ]; then
                if [ ! -L "$legacy" ] || [ "$(readlink -- "$legacy")" != "$INSTALL_DIR/$filename" ]; then
                    rm -- "$legacy"
                    ln -s -- "$INSTALL_DIR/$filename" "$legacy"
                fi
                echo "-> legacy command points to current executable: $filename"
            fi
        fi
    fi
done

echo " ***** update completed; running services left untouched *****"
