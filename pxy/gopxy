# Navigate to exe directory
EXE_DIR=~/pxy/sys/exe
if [ -d "$EXE_DIR" ]; then
    cd "$EXE_DIR" || { echo "Failed to cd into $EXE_DIR"; exit 1; }
    echo "✅ Changed directory to $EXE_DIR"
else
    echo "❌ Directory $EXE_DIR not found!"
    exit 1
fi

# Activate virtual environment
VENV=~/env
if [ -f "$VENV/bin/activate" ]; then
    source "$VENV/bin/activate"
    echo "✅ Virtual environment activated from $VENV"
else
    echo "❌ Virtual environment not found at $VENV/bin/activate"
    exit 1
fi

# Stay in exe directory, ready to run pxyexe
echo "💡 Ready in $(pwd) with venv active. Run: pxyexe"
