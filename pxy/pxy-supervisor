#!/usr/bin/env bash
# PXY tmux watchdog. Run as pxy from a systemd system service.
set -u
export HOME=/home/pxy
export PATH=/home/pxy/env/bin:/usr/local/bin:/usr/bin:/bin
APP=/home/pxy/PXY/pxy
ENGINE=sysexepxy.py
WEB='node pxy.js'
LOG=/home/pxy/pxy-supervisor.log
exec >>"$LOG" 2>&1
echo "$(date -Is) watchdog started"
# Single watchdog instance; systemd also supervises this process.
exec 9>/home/pxy/.pxy-supervisor.lock
flock -n 9 || { echo "$(date -Is) another watchdog already running"; exit 1; }
missing_engine_since=0
missing_web_since=0
while :; do
  # Do not compete with the updater while it intentionally tears down tmux.
  if pgrep -f '(^|/|[[:space:]])[p]xyupdate([[:space:]]|$)' >/dev/null; then
    missing_engine_since=0; missing_web_since=0
    sleep 10
    continue
  fi
  now=$(date +%s)
  if pgrep -f '[s]ysexepxy.py' >/dev/null; then
    missing_engine_since=0
  else
    if (( missing_engine_since == 0 )); then missing_engine_since=$now; fi
    if (( now - missing_engine_since >= 20 )); then
      echo "$(date -Is) engine missing; inspecting leftovers"
      # Do not create a second trading execution pipeline while children remain.
      if pgrep -f '[/]pxy/sys/exe/exe[a-z]*pxy.py|[p]ython3 exe/exepxy.py' >/dev/null; then
        echo "$(date -Is) orphan execution children detected; delaying restart to avoid duplicate orders"
      else
        tmux kill-session -t pxy-engine 2>/dev/null || true
        if tmux new-session -d -s pxy-engine -c "$APP/sys" 'exec /home/pxy/env/bin/python3 -u sysexepxy.py'; then
          echo "$(date -Is) started pxy-engine"
        else
          echo "$(date -Is) failed to start pxy-engine"
        fi
      fi
      missing_engine_since=$now
    fi
  fi
  if pgrep -f '[n]ode pxy.js' >/dev/null; then
    missing_web_since=0
  else
    if (( missing_web_since == 0 )); then missing_web_since=$now; fi
    if (( now - missing_web_since >= 20 )); then
      echo "$(date -Is) web missing; restarting tmux session"
      tmux kill-session -t pxy-web 2>/dev/null || true
      if tmux new-session -d -s pxy-web -c "$APP" 'exec node pxy.js'; then
        echo "$(date -Is) started pxy-web"
      else
        echo "$(date -Is) failed to start pxy-web"
      fi
      missing_web_since=$now
    fi
  fi
  sleep 10
done
