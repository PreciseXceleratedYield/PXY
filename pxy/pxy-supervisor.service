[Unit]
Description=PXY tmux engine and dashboard watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pxy
Group=pxy
Environment=HOME=/home/pxy
WorkingDirectory=/home/pxy/PXY/pxy
ExecStart=/bin/bash /home/pxy/PXY/pxy/pxy-supervisor
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
