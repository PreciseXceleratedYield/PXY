#!/bin/bash

# Target execution directory
cd /home/pxy/pxy || exit 1

# Check if the tmux session 'pxy' already exists
if ! tmux has-session -t pxy 2>/dev/null; then
    echo "Starting pxy.js inside a new isolated tmux session..."
    
    # 1. Create a new detached session named 'pxy'
    tmux new-session -d -s pxy
    
    # 2. Send the node command to the session and execute it (C-m simulates Enter)
    tmux send-keys -t pxy "node /home/pxy/pxy/pxy.js >> /home/pxy/pxy/pxy.log 2>&1" C-m
    
    echo "pxy.js started successfully in background."
fi

# Attach to the tmux session to view the interface
tmux attach -t pxy
