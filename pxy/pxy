#!/bin/bash
# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
cd /home/pxy/pxy/sys || exit 1

if [ -f "$HOME/env/bin/activate" ]; then
    source "$HOME/env/bin/activate"
fi

export PATH=$PWD:$PATH

# ========================================
# RENDER HELPER (FIXED 42 CHAR WIDTH)
# ========================================
draw_border() {
    echo "=========================================="
}

# ========================================
# TRADING SUBMENU (MAX 40 CHARS PER LINE)
# ========================================
show_trading_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY TRADING OPERATIONS          "
        draw_border
        echo "1) 🟢 Buy-CE  - [Buy Call Option]"
        echo "2) 🔴 Buy-PE  - [Buy Put Option]"
        echo "3) 🟩 Sqr-CE  - [Square-off CE]"
        echo "4) 🟥 Sqr-PE  - [Square-off PE]"
        echo "5) 💥 Sqr-All - [Close All Positions]"
        echo "6) ❌ Back    - Return Main Menu"
        draw_border
        read -p "Select option [1-6]: " SUBOPT
        
        if [ -z "$SUBOPT" ]; then
            break
        fi

        case $SUBOPT in
            1) echo ""; pxybuyce; read -p "Done. Press [Enter]...";;
            2) echo ""; pxybuype; read -p "Done. Press [Enter]...";;
            3) echo ""; pxysqrce; read -p "Done. Press [Enter]...";;
            4) echo ""; pxysqrpe; read -p "Done. Press [Enter]...";;
            5) echo ""; pxysqrall; read -p "Done. Press [Enter]...";;
            6) break;;
            *) echo "Invalid choice."; sleep 1;;
        esac
    done
}

# ========================================
# TEST SUBMENU (MAX 40 CHARS PER LINE)
# ========================================
show_test_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY SCRIPT TEST MENU            "
        draw_border
        
        mapfile -t PY_FILES < <(find "$HOME" -type f -name "*.py" -not -path '*/.*' 2>/dev/null -printf '%T@ %p\n' | sort -rn | head -n 5 | cut -d' ' -f2-)
        
        if [ ${#PY_FILES[@]} -eq 0 ]; then
            echo "No python files found in $HOME."
            echo "x) ❌ Back    - Return Main Menu"
            draw_border
            read -p "Press [Enter] to return..."
            break
        fi

        echo "a) ✅ All     - Execute All Scripts"
        
        for i in "${!PY_FILES[@]}"; do
            DISPLAY_NAME=$(basename "${PY_FILES[$i]}")
            printf "%d) 🐍 Exec   - %-23s\n" $((i+1)) "${DISPLAY_NAME:0:23}"
        done
        echo "x) ❌ Back    - Return Main Menu"
        draw_border
        
        read -p "Select option [a, 1-5, x]: " TESTOPT
        
        if [ -z "$TESTOPT" ]; then
            break
        fi
        
        if [[ "$TESTOPT" =~ [A-Za-z] ]]; then
            TESTOPT=$(echo "$TESTOPT" | tr '[:upper:]' '[:lower:]')
        fi
        
        if [ "$TESTOPT" = "x" ]; then
            break
        elif [ "$TESTOPT" = "a" ]; then
            echo ""
            draw_border
            echo "Executing All Python Scripts Sequentially..."
            draw_border
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            for SELECTED_FILE in "${PY_FILES[@]}"; do
                echo "-> Running: $SELECTED_FILE"
                python3 "$SELECTED_FILE"
                draw_border
            done
            read -p "All script executions finished. Press [Enter]..."
        elif [[ "$TESTOPT" =~ ^[1-5]$ ]] && [ "$TESTOPT" -le ${#PY_FILES[@]} ]; then
            SELECTED_FILE="${PY_FILES[$((TESTOPT-1))]}"
            echo ""
            draw_border
            echo "Executing: $SELECTED_FILE"
            draw_border
            
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            python3 "$SELECTED_FILE"
            
            draw_border
            read -p "Execution finished. Press [Enter]..."
        else
            echo "[!] Invalid selection."
            sleep 1
        fi
    done
}

# ========================================
# MAIN MANAGEMENT LOOP (MAX 40 CHARS)
# ========================================
while true; do
    clear
    draw_border
    echo "            PXY ENGINE CONSOLE            "
    draw_border
    echo "k) 🛑 Stop   - Kill Active Engines"
    echo "u) 🔄 Update - Foreground Live View"
    echo "s) 🚀 Start  - Launch Tmux Engines"
    echo "v) 🔭 View   - Attach Engine Tmux"
    echo "e) 🛒 Enter  - Trading Operations"
    echo "t) 🧪 Test   - Run Python Scripts"
    echo "b) 📊 SIM    - Replay Historical Data"
    echo "c) ✅ CHK    - Run Isolated Checks"
    echo "x) ❌ Exit   - Close Dashboard"
    draw_border
    read -p "Select option: " OPTION
    
    OPTION=$(echo "$OPTION" | tr '[:upper:]' '[:lower:]')

    if [ -z "$OPTION" ]; then
        echo ""
        echo "Exiting management shell. Goodbye!"
        break
    fi

    case $OPTION in
        k)
            echo ""
            read -s -p "Enter password to kill engine: " KILL_PASS
            echo ""
            if [ "$KILL_PASS" != "1" ]; then
                echo "[!] Access Denied. Incorrect password."
                sleep 1.5
            else
                echo "Terminating Web Server..."
                if tmux has-session -t pxy-web 2>/dev/null; then
                    tmux kill-session -t pxy-web
                    echo "[✔] Stopped web core."
                elif pgrep -f "pxy.js" >/dev/null 2>&1; then
                    pkill -9 -f pxy.js
                    echo "[✔] Stopped fallback web core."
                fi
                
                echo "Terminating Trading Engine..."
                if tmux has-session -t pxy-engine 2>/dev/null; then
                    tmux kill-session -t pxy-engine
                    echo "[✔] Stopped trading engine tmux session."
                elif pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                    pkill -f "sysexepxy.py"
                    echo "[✔] Killed fallback trading script process."
                else
                    echo "[-] Trading engine was not running."
                fi
                read -p "Press [Enter] to return..."
            fi
            ;;
        u)
            echo ""
            draw_border
            echo "    100% FULL SYNC: CODE + CACHE CLEAR     "
            draw_border
            echo "Step 1: Fetching latest from GitHub..."
            cd /home/pxy/pxy && git fetch origin
            echo ""
            echo "Step 2: Hard reset to match origin/main..."
            git reset --hard origin/main
            echo ""
            echo "Step 3: Clearing all Python cache..."
            find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null
            find . -type f -name "*.pyc" -delete 2>/dev/null
            find . -type d -name ".pytest_cache" -exec rm -rf {} + 2>/dev/null
            echo ""
            echo "Step 4: Running pxyupdate (if defined)..."
            pxyupdate
            draw_border
            echo "[✔] 100% SYNC COMPLETE - Code fully updated!"
            read -p "Press [Enter] to return..."
            ;;
        s)
            echo ""
            echo "Initializing Node Server..."
            if ! tmux has-session -t pxy-web 2>/dev/null && ! pgrep -f "/home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
                # Restrict terminal history memory strictly to 500 lines
                tmux new-session -d -s pxy-web "bash -c 'tmux set-option history-limit 500; cd /home/pxy/pxy && node pxy.js'"
                echo "[✔] Web dashboard started in background (tmux)."
            else
                echo "[-] Web dashboard already running."
            fi

            RUNMODE=$(cd /home/pxy/pxy/sys && python3 -c 'import syscnfgpxy; print(syscnfgpxy.SYSMODEPXY_RUN_MODE)' 2>/dev/null)
            if [ -z "$RUNMODE" ]; then
                echo "[X] Could not read RUNMODE from syscnfgpxy.py; engine was not started."
            elif [ "$RUNMODE" = "PRD" ]; then
                echo "Initializing Production Trading Engine..."
                if ! tmux has-session -t pxy-engine 2>/dev/null && ! pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                    # Restrict terminal history memory strictly to 500 lines
                    tmux new-session -d -s pxy-engine "bash -c 'tmux set-option history-limit 500; cd /home/pxy/pxy/sys; if [ -f \"\$HOME/env/bin/activate\" ]; then source \"\$HOME/env/bin/activate\"; fi; export PYTHONUNBUFFERED=1; python3 sysexepxy.py'"

                    sleep 1
                    if tmux has-session -t pxy-engine 2>/dev/null; then
                        echo "[✔] Python engine running successfully inside tmux session 'pxy-engine'."
                    else
                        echo "[X] Production engine failed to boot! Check tmux manually."
                    fi
                else
                    echo "[-] Python engine is already running."
                fi
            elif [ "$RUNMODE" = "CHK" ]; then
                echo "[i] RUNMODE=CHK: production engine was not started."
                echo "    Run 'pxychk' to execute isolated checks."
            elif [ "$RUNMODE" = "SIM" ]; then
                echo "[i] RUNMODE=SIM: production engine was not started."
                echo "    Run 'pxysim' to replay historical candles."
            else
                echo "[X] Unsupported RUNMODE='$RUNMODE'; engine was not started."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            ;;
        v)
            echo ""
            if tmux has-session -t pxy-engine 2>/dev/null; then
                clear
                # Clear terminal input buffer so old keystrokes don't accidentally exit
                read -t 0.1 -N 1000000 2>/dev/null
                
                while true; do
                    # Clear screen and draw headers
                    clear
                    draw_border
                    echo "   🔴 PXY LIVE ENGINE SCREEN (READ-ONLY)  "
                    echo "   >>> PRESS [ENTER] TO RETURN TO MENU <<< "
                    draw_border
                    
                    # Resolve a pane target explicitly; capture-pane does not accept
                    # every tmux session target as a pane target.
                    PANE_ID=$(tmux list-panes -t pxy-engine -F '#{pane_id}' 2>/dev/null | head -n 1)
                    if [ -n "$PANE_ID" ] && tmux capture-pane -pt "$PANE_ID" -S -30 -e -J; then
                        if pgrep -f "[s]ysexepxy.py" >/dev/null 2>&1; then
                            ENGINE_STATUS="RUNNING"
                        else
                            ENGINE_STATUS="NOT RUNNING"
                        fi
                    else
                        echo "[X] Unable to capture the engine console pane."
                        ENGINE_STATUS="PANE UNAVAILABLE"
                    fi
                    
                    draw_border
                    echo "Engine Status: $ENGINE_STATUS"
                    
                    # Refreshes the screen every 0.5 seconds. If you press ENTER, it breaks the loop.
                    read -t 0.5 -r -N 1 INPUT
                    if [[ "$INPUT" == $'\n' || "$INPUT" == $'\r' || -z "$INPUT" && $? -eq 0 ]]; then
                        break
                    fi
                done
            else
                echo "[X] No active 'pxy-engine' tmux session found to attach."
                read -p "Press [Enter] to return..."
            fi
            ;;

        e)
            show_trading_menu
            ;;
        t)
            show_test_menu
            ;;
        b)
            echo ""
            echo "Syncing latest code and clearing cache..."
            cd /home/pxy/pxy && git fetch origin && git reset --hard origin/main && find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null
            echo "[✔] Code synced, cache cleared."
            echo ""
            echo "Starting historical SIM replay with FULL DAY candles..."
            if [ -x "$HOME/pxy/pxysim" ]; then
                if "$HOME/pxy/pxysim"; then
                    echo "[✔] SIM replay completed."
                else
                    echo "[X] SIM replay failed with exit code $?."
                fi
            else
                echo "[X] Could not find executable $HOME/pxy/pxysim."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            ;;
        c)
            echo ""
            echo "Running isolated CHK suite..."
            if [ -x "$HOME/pxy/pxychk" ]; then
                if "$HOME/pxy/pxychk"; then
                    echo "[✔] CHK suite completed."
                else
                    echo "[X] CHK suite failed with exit code $?."
                fi
            else
                echo "[X] Could not find executable $HOME/pxy/pxychk."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            ;;
        x)
            echo ""
            echo "Exiting management shell. Goodbye!"
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
