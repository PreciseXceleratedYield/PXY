#!/bin/bash
# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
cd /home/pxy/pxy/sys || exit 1

if [ -f "$HOME/env/bin/activate" ]; then
    source "$HOME/env/bin/activate"
fi

export PATH=$PWD:$PATH

# ========================================
# RENDER HELPER (FIXED 42 CHAR WIDTH)
# ========================================
draw_border() {
    echo "=========================================="
}

# ========================================
# TRADING SUBMENU (NUMBERS RESTORED)
# ========================================
show_trading_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY TRADING OPERATIONS          "
        draw_border
        echo "1) Buy-CE  - Execute Order [Buy CE]       "
        echo "2) Buy-PE  - Execute Order [Buy PE]       "
        echo "3) Sqr-CE  - Close Position [Sqr CE]      "
        echo "4) Sqr-PE  - Close Position [Sqr PE]      "
        echo "5) Sqr-All - Close Position [Sqr All]     "
        echo "6) Back    - Return Main System Menu      "
        draw_border
        read -p "Select option [1-6]: " SUBOPT
        
        if [ -z "$SUBOPT" ]; then
            break
        fi

        case $SUBOPT in
            1) echo ""; pxybuyce; read -p "Done. Press [Enter]...";;
            2) echo ""; pxybuype; read -p "Done. Press [Enter]...";;
            3) echo ""; pxysqrce; read -p "Done. Press [Enter]...";;
            4) echo ""; pxysqrpe; read -p "Done. Press [Enter]...";;
            5) echo ""; pxysqrall; read -p "Done. Press [Enter]...";;
            6) break;;
            *) echo "Invalid choice."; sleep 1;;
        esac
    done
}

# ========================================
# TEST SUBMENU (ALL = 'a', SCRIPTS = 1-5)
# ========================================
show_test_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY SCRIPT TEST MENU            "
        draw_border
        
        mapfile -t PY_FILES < <(find "$HOME" -type f -name "*.py" -not -path '*/.*' 2>/dev/null -printf '%T@ %p\n' | sort -rn | head -n 5 | cut -d' ' -f2-)
        
        if [ ${#PY_FILES[@]} -eq 0 ]; then
            echo "No python files found in $HOME."
            echo "x) Back    - Return Main System Menu"
            draw_border
            read -p "Press [Enter] to return..."
            break
        fi

        # 'a' is reserved for running all scripts sequentially
        echo "a) All     - Execute All Functions At Once"
        
        # Dynamic files map back to clean, predictable numbers 1 to 5
        for i in "${!PY_FILES[@]}"; do
            DISPLAY_NAME=$(echo "${PY_FILES[$i]}" | sed "s|^$HOME|~|")
            printf "%d) Execute - %-28s\n" $((i+1)) "$DISPLAY_NAME"
        done
        echo "x) Back    - Return Main System Menu"
        draw_border
        
        read -p "Select option [a, 1-5, x]: " TESTOPT
        
        if [ -z "$TESTOPT" ]; then
            break
        fi
        
        # Lowercase only for alphabetical inputs
        if [[ "$TESTOPT" =~ [A-Za-z] ]]; then
            TESTOPT=$(echo "$TESTOPT" | tr '[:upper:]' '[:lower:]')
        fi
        
        if [ "$TESTOPT" = "x" ]; then
            break
        elif [ "$TESTOPT" = "a" ]; then
            echo ""
            draw_border
            echo "Executing All Python Scripts Sequentially..."
            draw_border
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            for SELECTED_FILE in "${PY_FILES[@]}"; do
                echo "-> Running: $SELECTED_FILE"
                python3 "$SELECTED_FILE"
                draw_border
            done
            read -p "All script executions finished. Press [Enter]..."
        elif [[ "$TESTOPT" =~ ^[1-5]$ ]] && [ "$TESTOPT" -le ${#PY_FILES[@]} ]; then
            SELECTED_FILE="${PY_FILES[$((TESTOPT-1))]}"
            echo ""
            draw_border
            echo "Executing: $SELECTED_FILE"
            draw_border
            
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            python3 "$SELECTED_FILE"
            
            draw_border
            read -p "Execution finished. Press [Enter]..."
        else
            echo "[!] Invalid selection."
            sleep 1
        fi
    done
}

# ========================================
# MAIN MANAGEMENT LOOP (ALPHA ONLY OPTIONS)
# ========================================
while true; do
    clear
    draw_border
    echo "            PXY ENGINE CONSOLE            "
    draw_border
    echo "k) Stop   - Kill All Active Systems"
    echo "u) Update - Run Foreground Live View"
    echo "s) Start  - Start Background Engines"
    echo "v) View   - Attach Engine Tmux Session"
    echo "e) Enter  - Open Operations Submenu"
    echo "t) Test   - Execute Recent Python Scripts"
    echo "x) Exit   - Close Engine Management"
    draw_border
    read -p "Select option [k-x]: " OPTION
    
    OPTION=$(echo "$OPTION" | tr '[:upper:]' '[:lower:]')

    if [ -z "$OPTION" ]; then
        echo ""
        echo "Exiting management shell. Goodbye!"
        break
    fi

    case $OPTION in
        k)
            echo ""
            echo "Terminating Web Server..."
            if tmux has-session -t pxy-web 2>/dev/null; then
                tmux kill-session -t pxy-web
                echo "[✔] Stopped web core."
            elif pgrep -f "pxy.js" >/dev/null 2>&1; then
                pkill -9 -f pxy.js
                echo "[✔] Stopped fallback web core."
            fi
            
            echo "Terminating Trading Engine..."
            if tmux has-session -t pxy-engine 2>/dev/null; then
                tmux kill-session -t pxy-engine
                echo "[✔] Stopped trading engine tmux session."
            elif pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                pkill -f "sysexepxy.py"
                echo "[✔] Killed fallback trading script process."
            else
                echo "[-] Trading engine was not running."
            fi
            read -p "Press [Enter] to return..."
            ;;
        u)
            echo ""
            draw_border
            echo "       RUNNING FOREGROUND UPDATE        "
            draw_border
            pxyupdate
            draw_border
            read -p "Press [Enter] to return..."
            ;;
        s)
            echo ""
            echo "Initializing Node Server..."
            if ! tmux has-session -t pxy-web 2>/dev/null && ! pgrep -f "/home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
                tmux new-session -d -s pxy-web "bash -c 'cd /home/pxy/pxy && node pxy.js'"
                echo "[✔] Web dashboard started in background (tmux)."
            else
                echo "[-] Web dashboard already running."
            fi

            echo "Initializing Trading Engine..."
            if ! tmux has-session -t pxy-engine 2>/dev/null && ! pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                tmux new-session -d -s pxy-engine "bash -c 'cd /home/pxy/pxy/sys; if [ -f \"\$HOME/env/bin/activate\" ]; then source \"\$HOME/env/bin/activate\"; fi; export PYTHONUNBUFFERED=1; python3 sysexepxy.py'"
                
                sleep 1
                if tmux has-session -t pxy-engine 2>/dev/null; then
                    echo "[✔] Python engine running successfully inside tmux session 'pxy-engine'."
                else
                    echo "[X] Engine failed to boot! Check tmux manually."
                fi
            else
                echo "[-] Python engine is already running."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            ;;
        v)
            echo ""
            if tmux has-session -t pxy-engine 2>/dev/null; then
                echo "Attaching to 'pxy-engine' in normal interactive mode."
                echo "To return to menu without closing: Press 'Ctrl+B' then 'D'."
                sleep 2
                tmux attach-session -t pxy-engine
            else
                echo "[X] No active 'pxy-engine' tmux session found to attach."
                read -p "Press [Enter] to return..."
            fi
            ;;
        e)
            show_trading_menu
            ;;
        t)
            show_test_menu
            ;;
        x)
            echo ""
            echo "Exiting management shell. Goodbye!"
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
