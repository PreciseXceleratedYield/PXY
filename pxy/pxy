#!/bin/bash
# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
cd /home/pxy/pxy/sys || exit 1

if [ -f "$HOME/env/bin/activate" ]; then
    source "$HOME/env/bin/activate"
fi

export PATH=$PWD:$PATH
ENGINE_LOG="/home/pxy/pxy/engine_boot.log"

touch "$ENGINE_LOG"

# ========================================
# RENDER HELPER (FIXED 42 CHAR WIDTH)
# ========================================
draw_border() {
    echo "=========================================="
}

# ========================================
# TRADING SUBMENU (UNIFORM WIDTH)
# ========================================
show_trading_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY TRADING OPERATIONS          "
        draw_border
        echo "1) Buy-CE  - Execute Order [Buy CE]       "
        echo "2) Buy-PE  - Execute Order [Buy PE]       "
        echo "3) Sqr-CE  - Close Position [Sqr CE]      "
        echo "4) Sqr-PE  - Close Position [Sqr PE]      "
        echo "5) Sqr-All - Close Position [Sqr All]     "
        echo "6) Back    - Return Main System Menu      "
        draw_border
        read -p "Select option [1-6]: " SUBOPT
        
        if [ -z "$SUBOPT" ]; then
            break
        fi

        case $SUBOPT in
            1) echo ""; pxybuyce; read -p "Done. Press [Enter]...";;
            2) echo ""; pxybuype; read -p "Done. Press [Enter]...";;
            3) echo ""; pxysqrce; read -p "Done. Press [Enter]...";;
            4) echo ""; pxysqrpe; read -p "Done. Press [Enter]...";;
            5) echo ""; pxysqrall; read -p "Done. Press [Enter]...";;
            6) break;;
            *) echo "Invalid choice."; sleep 1;;
        esac
    done
}

# ========================================
# TEST SUBMENU (EXECUTE RECENT PYTHON)
# ========================================
show_test_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY SCRIPT TEST MENU            "
        draw_border
        
        mapfile -t PY_FILES < <(find "$HOME" -type f -name "*.py" -not -path '*/.*' 2>/dev/null -printf '%T@ %p\n' | sort -rn | head -n 5 | cut -d' ' -f2-)
        
        if [ ${#PY_FILES[@]} -eq 0 ]; then
            echo "No python files found in $HOME."
            echo "6) Back    - Return Main System Menu"
            draw_border
            read -p "Press [Enter] to return..."
            break
        fi

        for i in "${!PY_FILES[@]}"; do
            DISPLAY_NAME=$(echo "${PY_FILES[$i]}" | sed "s|^$HOME|~|")
            printf "%d) Execute - %-28s\n" $((i+1)) "$DISPLAY_NAME"
        done
        echo "6) Back    - Return Main System Menu"
        echo "7) All     - Execute All Functions At Once"
        draw_border
        
        read -p "Select option [1-7]: " TESTOPT
        
        if [ -z "$TESTOPT" ]; then
            break
        fi
        
        if [ "$TESTOPT" = "6" ]; then
            break
        elif [ "$TESTOPT" = "7" ]; then
            echo ""
            draw_border
            echo "Executing All Python Scripts Sequentially..."
            draw_border
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            for SELECTED_FILE in "${PY_FILES[@]}"; do
                echo "-> Running: $SELECTED_FILE"
                python3 "$SELECTED_FILE"
                draw_border
            done
            read -p "All script executions finished. Press [Enter]..."
        elif [[ "$TESTOPT" =~ ^[1-5]$ ]] && [ "$TESTOPT" -le ${#PY_FILES[@]} ]; then
            SELECTED_FILE="${PY_FILES[$((TESTOPT-1))]}"
            echo ""
            draw_border
            echo "Executing: $SELECTED_FILE"
            draw_border
            
            if [ -f "$HOME/env/bin/activate" ]; then
                source "$HOME/env/bin/activate"
            fi
            python3 "$SELECTED_FILE"
            
            draw_border
            read -p "Execution finished. Press [Enter]..."
        else
            echo "[!] Invalid selection."
            sleep 1
        fi
    done
}

# ========================================
# MAIN MANAGEMENT LOOP (UNIFORM WIDTH)
# ========================================
while true; do
    clear
    draw_border
    echo "            PXY ENGINE CONSOLE            "
    draw_border
    echo "0/k) Stop   - Kill All Active Systems"
    echo "1/u) Update - Run Foreground Live View"
    echo "2/s) Start  - Start Background Engine"
    echo "3/v) View   - Attach Terminal Session"
    echo "4/e) Enter  - Open Operations Submenu"
    echo "5/t) Test   - Execute Recent Python Scripts"
    echo "6/x) Exit   - Close Engine Management"
    draw_border
    read -p "Select option [0-6 or k-x]: " OPTION
    
    # FIXED: Replaced bad vertical pipe delimiters with clean syntax standard characters
    OPTION=$(echo "$OPTION" | tr '[:upper:]' '[:lower:]')

    if [ -z "$OPTION" ]; then
        echo ""
        echo "Exiting management shell. Goodbye!"
        break
    fi

    case $OPTION in
        0|k)
            echo ""
            echo "Terminating Web Server..."
            if tmux has-session -t pxy-web 2>/dev/null; then
                tmux kill-session -t pxy-web
                echo "[✔] Stopped web core."
            elif pgrep -f "pxy.js" >/dev/null 2>&1; then
                pkill -9 -f pxy.js
                echo "[✔] Stopped fallback web core."
            fi
            
            echo "Terminating Core Engines..."
            if pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                pkill -f "sysexepxy.py"
                echo "[✔] Killed background trading script process."
            else
                echo "[-] Background trading script was not running."
            fi
            read -p "Press [Enter] to return..."
            ;;
        1|u)
            echo ""
            draw_border
            echo "       RUNNING FOREGROUND UPDATE        "
            draw_border
            pxyupdate
            draw_border
            read -p "Press [Enter] to return..."
            ;;
        2|s)
            echo ""
            echo "Initializing Node Server..."
            if ! tmux has-session -t pxy-web 2>/dev/null && ! pgrep -f "/home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
                tmux new-session -d -s pxy-web "bash -c 'cd /home/pxy/pxy && node pxy.js >> pxy.log 2>&1'"
                echo "[✔] Web dashboard started in background (tmux)."
            else
                echo "[-] Web dashboard already running."
            fi

            echo "Initializing Trading Engine..."
            if ! pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                > "$ENGINE_LOG"
                
                export PYTHONUNBUFFERED=1
                nohup python3 sysexepxy.py > "$ENGINE_LOG" 2>&1 &
                
                sleep 1
                if pgrep -f "sysexepxy.py" >/dev/null 2>&1; then
                    echo "[✔] Python engine running successfully in background."
                else
                    echo "[X] Engine failed to boot! Check option 3 for error trace logs."
                fi
            else
                echo "[-] Python engine is already running in background."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            ;;
        3|v)
            echo ""
            clear
            draw_border
            echo "   STREAMING ENGINE OUTPUT (Ctrl+C to Exit)   "
            draw_border
            echo ""
            tail -f "$ENGINE_LOG"
            draw_border
            read -p "Press [Enter] to return..."
            ;;
        4|e)
            show_trading_menu
            ;;
        5|t)
            show_test_menu
            ;;
        6|x)
            echo ""
            echo "Exiting management shell. Goodbye!"
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
