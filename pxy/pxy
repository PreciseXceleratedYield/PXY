#!/bin/bash

# =====================================================================
# ENVIRONMENT & DIRECTORY CONFIGURATION (FIXED)
# =====================================================================
# Move into the working directory safely without disrupting execution
cd /home/pxy/pxy || { echo "Error: Could not change directory"; exit 1; }

# Activate your custom environment settings if they exist
if [ -f "$HOME/env/bin/activate" ]; then
    source "$HOME/env/bin/activate"
else
    echo "[!] Warning: Virtual environment profile '~/env/bin/activate' not found."
fi

# =====================================================================
#       PXY SERVER MANAGEMENT MENU
# =====================================================================
clear
echo "====================================="
echo "       PXY SERVER MANAGEMENT         "
echo "====================================="
echo "1) Start/Leave Services (Safe to close window)"
echo "2) Kill All Services (Full Stop)"
echo "3) Attach to Trading Terminal (Live View)"
echo "====================================="
read -p "Select an option [1-3]: " OPTION

case $OPTION in
    1)
        echo ""
        echo "Initializing services..."
        
        # 1. Start the Node.js web server if it is not running
        if ! pgrep -f "/home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
            nohup node /home/pxy/pxy/pxy.js >> /home/pxy/pxy/pxy.log 2>&1 &
            echo "[✔] Web dashboard server started..."
        else
            echo "[-] Web dashboard server is already running."
        fi

        # 2. Start the trading terminal inside tmux ONLY if it does not exist
        if ! tmux has-session -t pxy 2>/dev/null; then
            # Pass environment settings directly into the persistent subshell context
            tmux new-session -d -s pxy "bash -c 'cd /home/pxy/pxy && source ~/env/bin/activate && pxyexe; exec bash'"
            echo "[✔] Trading terminal started in background."
        else
            echo "[-] Trading terminal is already running."
        fi

        echo ""
        echo "Setup verified! You can now safely close this terminal window."
        ;;
        
    2)
        echo ""
        echo "Stopping all PXY services..."

        # 1. Force kill the Node.js web server
        if pgrep -f "pxy.js" >/dev/null 2>&1; then
            pkill -9 -f pxy.js
            echo "[✔] Node.js server stopped."
        else
            echo "[-] Node.js server was not running."
        fi

        # 2. Kill the tmux terminal core session
        if tmux has-session -t pxy 2>/dev/null; then
            tmux kill-session -t pxy
            echo "[✔] Tmux trading session killed."
        else
            echo "[-] No active tmux session found."
        fi

        echo ""
        echo "All services completely stopped."
        ;;

    3)
        echo ""
        if tmux has-session -t pxy 2>/dev/null; then
            echo "Attaching to live session... (Press Ctrl+B, then D to safely exit anytime)"
            sleep 1
            tmux attach -t pxy
        else
            echo "[X] Error: The trading terminal is not running. Run Option 1 first!"
        fi
        ;;

    *)
        echo "Invalid option. Exiting."
        exit 1
        ;;
esac
