#!/bin/bash
# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
cd /home/pxy/pxy/sys || exit 1

if [ -f "$HOME/env/bin/python3" ]; then
    PY_BIN="$HOME/env/bin/python3"
else
    PY_BIN="python3"
fi

export PATH=$PWD:$PATH

# ========================================
# RENDER HELPER (FIXED 42 CHAR WIDTH)
# ========================================
draw_border() {
    echo "=========================================="
}

# ========================================
# TRADING SUBMENU (UNIFORM WIDTH)
# ========================================
show_trading_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY TRADING OPERATIONS          "
        draw_border
        echo "c) Buy-CE  - Execute Order [Buy CE]       "
        echo "p) Buy-PE  - Execute Order [Buy PE]       "
        echo "r) Sqr-CE  - Close Position [Sqr CE]      "
        echo "e) Sqr-PE  - Close Position [Sqr PE]      "
        echo "a) Sqr-All - Close Position [Sqr All]     "
        echo "b) Back    - Return Main System Menu      "
        draw_border
        read -p "Select option [c-b]: " SUBOPT
        
        SUBOPT=$(echo "$SUBOPT" | tr '[:upper:]' '[:lower:]')

        if [ -z "$SUBOPT" ]; then
            break
        fi

        case $SUBOPT in
            c) echo ""; pxybuyce; read -p "Done. Press [Enter]...";;
            p) echo ""; pxybuype; read -p "Done. Press [Enter]...";;
            r) echo ""; pxysqrce; read -p "Done. Press [Enter]...";;
            e) echo ""; pxysqrpe; read -p "Done. Press [Enter]...";;
            a) echo ""; pxysqrall; read -p "Done. Press [Enter]...";;
            b) clear; break;;
            *) echo "Invalid choice."; sleep 1;;
        esac
    done
}

# ========================================
# TEST SUBMENU (EXECUTE RECENT PYTHON)
# ========================================
show_test_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY SCRIPT TEST MENU            "
        draw_border
        
        mapfile -t PY_FILES < <(find "$HOME" -type f -name "*.py" -not -path '*/.*' 2>/dev/null -printf '%T@ %p\n' | sort -rn | head -n 5 | cut -d' ' -f2-)
        local total_files=${#PY_FILES[@]}

        if [ "$total_files" -eq 0 ]; then
            echo "No python files found in $HOME."
            echo "q) Back    - Return Main System Menu"
            draw_border
            read -p "Press [Enter] to return..."
            clear
            break
        fi

        local alpha_keys=(b c d e f)

        echo "a) All     - Execute All Functions At Once"
        for i in "${!PY_FILES[@]}"; do
            DISPLAY_NAME=$(echo "${PY_FILES[$i]}" | sed "s|^$HOME|~|")
            if [ ${#DISPLAY_NAME} -gt 25 ]; then
                DISPLAY_NAME="${DISPLAY_NAME:0:22}..."
            fi
            printf "%s) Execute - %-25s \n" "${alpha_keys[$i]}" "$DISPLAY_NAME"
        done
        echo "q) Back    - Return Main System Menu"
        draw_border
        
        read -p "Select option [letters]: " TESTOPT
        TESTOPT=$(echo "$TESTOPT" | tr '[:upper:]' '[:lower:]')
        
        if [ -z "$TESTOPT" ]; then
            clear
            break
        fi
        
        if [ "$TESTOPT" = "q" ]; then
            clear
            break
        elif [ "$TESTOPT" = "a" ]; then
            echo ""
            draw_border
            echo "Executing All Python Scripts Sequentially..."
            draw_border
            for SELECTED_FILE in "${PY_FILES[@]}"; do
                echo "-> Running: $SELECTED_FILE"
                $PY_BIN "$SELECTED_FILE" >/dev/null 2>&1
                draw_border
            done
            read -p "All script executions finished. Press [Enter]..."
            clear
        elif [[ "$TESTOPT" =~ ^[b-f]$ ]]; then
            local target_idx=-1
            for idx in "${!alpha_keys[@]}"; do
                if [ "${alpha_keys[$idx]}" = "$TESTOPT" ]; then
                    target_idx=$idx
                    break
                fi
            done

            if [ "$target_idx" -ne -1 ] && [ "$target_idx" -lt "$total_files" ]; then
                SELECTED_FILE="${PY_FILES[$target_idx]}"
                echo ""
                draw_border
                echo "Executing: $SELECTED_FILE"
                draw_border
                
                $PY_BIN "$SELECTED_FILE" >/dev/null 2>&1
                
                draw_border
                read -p "Execution finished. Press [Enter]..."
                clear
            else
                echo "[!] Selection has no associated file."
                sleep 1
            fi
        else
            echo "[!] Invalid selection."
            sleep 1
        fi
    done
}

# ========================================
# MAIN MANAGEMENT LOOP (UNIFORM WIDTH)
# ========================================
while true; do
    clear
    draw_border
    echo "            PXY ENGINE CONSOLE            "
    draw_border
    echo "k) Stop   - Kill All Active Systems"
    echo "u) Update - Run Foreground Live View"
    echo "s) Start  - Start Background Engine"
    echo "v) View   - Attach Terminal Session"
    echo "e) Enter  - Open Operations Submenu"
    echo "t) Test   - Execute Recent Python Scripts"
    echo "x) Exit   - Close Engine Management"
    draw_border
    read -p "Select option [k, u, s, v, e, t, x]: " OPTION
    
    OPTION=$(echo "$OPTION" | tr '[:upper:]' '[:lower:]')

    if [ -z "$OPTION" ]; then
        echo ""
        echo "Exiting management shell. Goodbye!"
        break
    fi

    case $OPTION in
        k)
            echo ""
            echo "Terminating Web Server..."
            if tmux has-session -t pxy-web 2>/dev/null; then
                tmux kill-session -t pxy-web >/dev/null 2>&1
                echo "[✔] Stopped web core."
            elif pgrep -f "pxy.js" >/dev/null 2>&1; then
                pkill -9 -f pxy.js >/dev/null 2>&1
                echo "[✔] Stopped fallback web core."
            fi
            
            echo "Terminating Core Engines..."
            if tmux has-session -t pxy-engine 2>/dev/null; then
                tmux kill-session -t pxy-engine >/dev/null 2>&1
                echo "[✔] Closed tmux trading process window."
            else
                echo "[-] Background trading process was not running."
            fi
            read -p "Press [Enter] to return..."
            clear
            ;;
        u)
            echo ""
            draw_border
            echo "       RUNNING FOREGROUND UPDATE        "
            draw_border
            pxyupdate
            draw_border
            read -p "Press [Enter] to return..."
            clear
            ;;
        s)
            echo ""
            echo "Initializing Node Server..."
            if ! tmux has-session -t pxy-web 2>/dev/null && ! pgrep -f "/home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
                tmux new-session -d -s pxy-web "bash -c 'cd /home/pxy/pxy && node pxy.js'" >/dev/null 2>&1
                echo "[✔] Web dashboard started."
            else
                echo "[-] Web dashboard already running."
            fi

            echo "Initializing Trading Engine..."
            if ! tmux has-session -t pxy-engine 2>/dev/null; then
                export PYTHONUNBUFFERED=1
                tmux new-session -d -s pxy-engine "bash -c 'cd /home/pxy/pxy && pxyexe || bash'" >/dev/null 2>&1
                
                sleep 1
                if tmux has-session -t pxy-engine 2>/dev/null; then
                    echo "[✔] Python engine running successfully."
                else
                    echo "[X] Engine failed to boot!"
                fi
            else
                echo "[-] Python engine is already running."
            fi
            echo ""
            read -p "Press [Enter] to return..."
            clear
            ;;
        v)
            echo ""
            if tmux has-session -t pxy-engine 2>/dev/null; then
                # Attaches your live active window session.
                # To exit cleanly without halting the engine, use: Ctrl + B, then D.
                tmux attach-session -t pxy-engine
                clear
            else
                echo "[X] No active trading engine session found to attach to."
                read -p "Press [Enter] to return..."
                clear
            fi
            ;;
        e)
            show_trading_menu
            ;;
        t)
            show_test_menu
            ;;
        x)
            echo ""
            echo "Exiting management shell. Goodbye!"
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
