#!/bin/bash

# Target directory
cd /home/pxy/pxy || exit 1

# Verify if the engine is running before attempting to attach
if tmux has-session -t pxy 2>/dev/null; then
    echo "Attaching to live pxy console..."
    echo "Tip: Press 'Ctrl + B' then tap 'D' to safely disconnect without closing the application."
    sleep 1
    tmux attach -t pxy
else
    echo "Error: pxy background session is not running."
    echo "Please execute './pxystart' first to initiate the workspace."
    exit 1
fi

