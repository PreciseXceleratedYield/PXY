#!/bin/bash

# Target execution directory
cd /home/pxy/pxy || exit 1

# Check if we are already inside a tmux environment
if [ -n "$TMUX" ]; then
    # Already inside tmux: check if pxy.js is already running
    if ! pgrep -f "node /home/pxy/pxy/pxy.js" >/dev/null 2>&1; then
        echo "Inside TMUX session. Launching pxy.js in the background..."
        node /home/pxy/pxy/pxy.js >> /home/pxy/pxy/pxy.log 2>&1 &
    else
        echo "pxy.js is already running."
    fi
else
    # Standard terminal: Use the dedicated 'pxy' tmux session
    if ! tmux has-session -t pxy 2>/dev/null; then
        echo "Starting pxy.js inside a new isolated tmux session..."
        tmux new-session -d -s pxy
        tmux send-keys -t pxy "node /home/pxy/pxy/pxy.js >> /home/pxy/pxy/pxy.log 2>&1" C-m
        echo "pxy.js started successfully."
    fi
    tmux attach -t pxy
fi
