#!/bin/bash
# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/pxyrslve" ]; then
    source "$SCRIPT_DIR/pxyrslve"
elif [ -f "$HOME/.local/bin/pxyrslve" ]; then
    source "$HOME/.local/bin/pxyrslve"
else
    echo "[X] PXY path helper not found." >&2
    exit 1
fi
PXY_APP_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[X] Could not locate the PXY application directory." >&2
    exit 1
}
pxy_activate_env || exit 1
cd "$PXY_APP_DIR/sys" || exit 1


export PATH=$PWD:$PATH

# ========================================
# RENDER HELPER (FIXED 42 CHAR WIDTH)
# ========================================
draw_border() {
    echo "=========================================="
}

# ========================================
# TRADING SUBMENU (MAX 40 CHARS PER LINE)
# ========================================
show_trading_menu() {
    while true; do
        clear
        draw_border
        echo "          PXY TRADING OPERATIONS          "
        draw_border
        echo "1) 🟢 Buy-CE  - [Buy Call Option]"
        echo "2) 🔴 Buy-PE  - [Buy Put Option]"
        echo "3) 🟩 Sqr-CE  - [Square-off CE]"
        echo "4) 🟥 Sqr-PE  - [Square-off PE]"
        echo "5) 💥 Sqr-All - [Close All Positions]"
        echo "6) ❌ Back    - Return Main Menu"
        draw_border
        read -p "Select option [1-6]: " SUBOPT
        
        if [ -z "$SUBOPT" ]; then
            break
        fi

        case $SUBOPT in
            1) echo ""; pxybuyce; read -p "Done. Press [Enter]...";;
            2) echo ""; pxybuype; read -p "Done. Press [Enter]...";;
            3) echo ""; pxysqrce; read -p "Done. Press [Enter]...";;
            4) echo ""; pxysqrpe; read -p "Done. Press [Enter]...";;
            5) echo ""; pxysqrall; read -p "Done. Press [Enter]...";;
            6) break;;
            *) echo "Invalid choice."; sleep 1;;
        esac
    done
}

# ========================================
# MAIN MANAGEMENT LOOP (MAX 40 CHARS)
# ========================================
while true; do
    clear
    draw_border
    echo "            PXY ENGINE CONSOLE            "
    draw_border
    echo "x) 🚪 Exit    - Close Menu"
    echo "u) 🔄 Updt    - Update Code"
    echo "k) 🚧 Stop    - Stop Engine"
    echo "n) 🔗 Conn    - SSH Connect"
    echo "s) ✅ Strt    - Start Engine"
    echo "t) 💰 Trde    - Trade Control"
    echo "m) 📺 Smon    - System Monitor"
    echo "c) 🧰 Ctrl    - System Control"
    echo "g) 📡 Tlgr    - Telegram Alerts"
    draw_border
    read -p "Select option: " OPTION
    
    OPTION=$(echo "$OPTION" | tr '[:upper:]' '[:lower:]')

    if [ -z "$OPTION" ]; then
        echo ""
        echo "Exiting management shell. Goodbye!"
        break
    fi

    case $OPTION in
        u)
            echo ""
            draw_border
            echo "          UPDATE CODE ONLY                "
            draw_border
            if bash "$PXY_APP_DIR/pxyupdate"; then
               draw_border
               echo "[✔] Update complete."
            else
               draw_border
               echo "[X] Update failed; see the error above."
            fi
            read -p "Press [Enter] to return..."
            ;;
        s)
            bash "$PXY_APP_DIR/pxywatch" start
            read -p "Press [Enter] to return..."
            ;;
        k)
            bash "$PXY_APP_DIR/pxywatch" stop
            read -p "Press [Enter] to return..."
            ;;
        t)
            show_trading_menu
            ;;
        m)
            bash "$PXY_APP_DIR/pxymon"
            read -p "Press [Enter] to return..."
            ;;
        n)
            python3 "$PXY_APP_DIR/pxyconnect"
            read -p "Press [Enter] to return..."
            ;;
        g)
            while true; do
                clear
                draw_border
                echo "        PXY TELEGRAM CONTROL TOWER       "
                draw_border
                echo "1) Start         2) Stop"
                echo "3) Restart       4) Install"
                echo "5) Enable Boot   6) Disable Boot"
                echo "7) Events ON     8) Events OFF"
                echo "9) Status        0) Back"
                echo "a) TGR           b) WSP"
                draw_border
                read -p "Select option: " GOPT
                case "$GOPT" in
                    1) bash "$PXY_APP_DIR/pxytlgr" start ;;
                    2) bash "$PXY_APP_DIR/pxytlgr" stop ;;
                    3) bash "$PXY_APP_DIR/pxytlgr" restart ;;
                    4) bash "$PXY_APP_DIR/pxytlgr" install ;;
                    5) bash "$PXY_APP_DIR/pxytlgr" enable ;;
                    6) bash "$PXY_APP_DIR/pxytlgr" disable ;;
                    7) bash "$PXY_APP_DIR/pxytlgr" events-on ;;
                    8) bash "$PXY_APP_DIR/pxytlgr" events-off ;;
                    9) bash "$PXY_APP_DIR/pxytlgr" status ;;
                    a|A) bash "$PXY_APP_DIR/pxytlgr" channel TGR ;;
                    b|B) bash "$PXY_APP_DIR/pxytlgr" channel WSP ;;
                    0|"") break ;;
                    *) echo "Invalid choice." ;;
                esac
                read -p "Press [Enter] to continue..."
            done
            ;;
        c)
            while true; do
                clear
                draw_border
                echo "          PXY SYSTEM CONTROL              "
                draw_border
                echo "1) 🔭  View    - Live Engine Screen"
                echo "2) 📊  Status  - Watchdog / Engine / Web"
                echo "3) ⚙️   Install - Configure Systemd"
                echo "4) 📜  Traces  - Journal + Last Failure"
                echo "5) 🔁  Auto    - Auto Start Control"
                echo "6) ↩️   Back    - Main Menu"
                draw_border
                read -p "Select option [1-6]: " WOPT
                case "$WOPT" in
                    1)
            echo ""
            if tmux has-session -t pxy-engine 2>/dev/null; then
                clear
                # Clear terminal input buffer so old keystrokes don't accidentally exit
                read -t 0.1 -N 1000000 2>/dev/null
                
                while true; do
                    # Clear screen and draw headers
                    clear
                    draw_border
                    echo "   🔴 PXY LIVE ENGINE SCREEN (READ-ONLY)  "
                    echo "   >>> PRESS [ENTER] TO RETURN TO MENU <<< "
                    draw_border
                    
                    # Resolve a pane target explicitly; capture-pane does not accept
                    # every tmux session target as a pane target.
                    PANE_ID=$(tmux list-panes -t pxy-engine -F '#{pane_id}' 2>/dev/null | head -n 1)
                    if [ -n "$PANE_ID" ] && tmux capture-pane -pt "$PANE_ID" -S -100 -e -J; then
                        if pgrep -f "[s]ysexepxy.py" >/dev/null 2>&1; then
                            ENGINE_STATUS="RUNNING"
                        else
                            ENGINE_STATUS="NOT RUNNING"
                        fi
                    else
                        echo "[X] Unable to capture the engine console pane."
                        ENGINE_STATUS="PANE UNAVAILABLE"
                    fi
                    
                    draw_border
                    echo "Engine Status: $ENGINE_STATUS"
                    
                    # Refreshes the screen every 0.5 seconds. If you press ENTER, it breaks the loop.
                    read -t 0.5 -r -N 1 INPUT
                    if [[ "$INPUT" == $'\n' || "$INPUT" == $'\r' || -z "$INPUT" && $? -eq 0 ]]; then
                        break
                    fi
                done
            else
                echo "[X] No active 'pxy-engine' tmux session found to attach."
                read -p "Press [Enter] to return..."
            fi
            ;;
                    2) bash "$PXY_APP_DIR/pxywatch" status ;;
                    3) bash "$PXY_APP_DIR/pxywatch" install ;;
                    4) bash "$PXY_APP_DIR/pxywatch" logs ;;
                    5)
                        while true; do
                            clear
                            draw_border
                            echo "          PXY AUTO START CONTROL          "
                            draw_border
                            echo "1) ✅  Auto    - Enable Auto Start on Boot"
                            echo "2) 🚫  Disable - Disable Auto Start"
                            echo "3) 📊  Status  - Show Auto Start Status"
                            echo "4) 🚪  Exit    - Return to Control Menu"
                            draw_border
                            read -p "Select option [1-4]: " AOPT
                            case "$AOPT" in
                                1)
                                    if sudo systemctl enable pxywatch.service; then
                                        echo "[✔] Watchdog auto-start enabled."
                                    else
                                        echo "[X] Failed to enable watchdog auto-start."
                                    fi
                                    ;;
                                2)
                                    if sudo systemctl disable pxywatch.service; then
                                        echo "[✔] Watchdog auto-start disabled."
                                    else
                                        echo "[X] Failed to disable watchdog auto-start."
                                    fi
                                    ;;
                                3)
                                    AUTO_STATUS=$(systemctl is-enabled pxywatch.service 2>/dev/null)
                                    case "$AUTO_STATUS" in
                                        enabled) echo "[✔] Auto Start: ENABLED" ;;
                                        disabled) echo "[i] Auto Start: DISABLED" ;;
                                        *) echo "[i] Auto Start: ${AUTO_STATUS:-unknown}" ;;
                                    esac
                                    ;;
                                4|"") break ;;
                                *) echo "Invalid choice." ;;
                            esac
                            read -p "Press [Enter] to continue..."
                        done
                        ;;
                    6|"") break ;;
                    *) echo "Invalid choice." ;;
                esac
                if [[ "$WOPT" != "1" ]]; then
                    read -p "Press [Enter] to continue..."
                fi
            done
            ;;
        x)
            echo ""
            echo "Exiting management shell. Goodbye!"
            break
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
