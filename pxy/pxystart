#!/bin/bash

# Target directory
cd /home/pxy/pxy || exit 1

# Check if the tmux session 'pxy' already exists
if ! tmux has-session -t pxy 2>/dev/null; then
    # 1. Create a persistent background tmux workspace detached (-d)
    tmux new-session -d -s pxy
    
    # 2. Fire up the application inside the isolated workspace
    tmux send-keys -t pxy "node /home/pxy/pxy/pxy.js >> /home/pxy/pxy/pxy.log 2>&1" C-m
    
    echo "pxy.js successfully started in the background."
else
    echo "pxy.js is already running in the background."
fi

# Safely exit back to terminal
exit 0
