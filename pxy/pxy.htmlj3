<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#06080d">
<title>PXY DASHBOARD</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm/css/xterm.css" />

<style>
/* ═══════════════ TOKENS ═══════════════ */
:root,
[data-theme="dark"] {
  --bg:         #06080d;
  --bg2:        #0c101a;
  --bg3:        #111827;
  --border:     rgba(255,255,255,0.06);
  --border2:    rgba(255,255,255,0.12);
  --text:       #e8ecf4;
  --muted:      #5b6478;
  --accent:     #3b82f6;
  --bull:       #22c55e;
  --bear:       #ef4444;
  --bull-dim:   rgba(34,197,94,0.12);
  --bear-dim:   rgba(239,68,68,0.12);
  --gold:       #f59e0b;
  --grid:       rgba(255,255,255,0.032);
  --shadow:     rgba(0,0,0,0.65);
  --scanline:   rgba(255,255,255,0.011);
  --chart-grid: rgba(255,255,255,0.04);
  --chart-tick: #374151;
  --toggle-bg:  #1e293b;
  --track-mid:  rgba(255,255,255,0.08);
  --ov-bg:      rgba(6,8,13,0.87);
  --ov-hdr:     rgba(10,14,22,0.97);
  --ov-row:     rgba(255,255,255,0.022);
}

[data-theme="light"] {
  --bg:         #f0f3fa;
  --bg2:        #ffffff;
  --bg3:        #e8edf7;
  --border:     rgba(0,0,0,0.07);
  --border2:    rgba(0,0,0,0.13);
  --text:       #0f172a;
  --muted:      #94a3b8;
  --accent:     #2563eb;
  --bull:       #16a34a;
  --bear:       #dc2626;
  --bull-dim:   rgba(22,163,74,0.10);
  --bear-dim:   rgba(220,38,38,0.10);
  --gold:       #d97706;
  --grid:       rgba(0,0,0,0.035);
  --shadow:     rgba(0,0,0,0.14);
  --scanline:   rgba(0,0,0,0.005);
  --chart-grid: rgba(0,0,0,0.05);
  --chart-tick: #94a3b8;
  --toggle-bg:  #e2e8f0;
  --track-mid:  rgba(0,0,0,0.07);
  --ov-bg:      rgba(240,243,250,0.91);
  --ov-hdr:     rgba(255,255,255,0.98);
  --ov-row:     rgba(0,0,0,0.018);
}

/* ═══════════════ RESET ═══════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

html{
  height:100%;overflow:hidden;
  -webkit-tap-highlight-color:transparent;
}

body{
  height:100%;overflow:hidden;
  font-family:'DM Mono',monospace;
  background:var(--bg);color:var(--text);
  transition:background .35s,color .35s;
  position:fixed;inset:0;
  padding-top:env(safe-area-inset-top);
  padding-bottom:env(safe-area-inset-bottom);
  padding-left:env(safe-area-inset-left);
  padding-right:env(safe-area-inset-right);
}

*{scrollbar-width:thin;scrollbar-color:var(--border2) transparent;}
::-webkit-scrollbar{width:3px;height:3px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}

/* ═══════════════ APP SHELL ═══════════════ */
#app{display:flex;flex-direction:column;height:100%;overflow:hidden;}

/* ─── TOP HEADER ─── */
#topHeader{
  flex-shrink:0;height:46px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 14px;gap:8px;
  background:var(--bg2);border-bottom:1px solid var(--border);
  z-index:200;
  transition:background .35s,box-shadow .5s,border-color .35s;
}

#headerLeft{display:flex;align-items:center;gap:10px;flex-shrink:0;}

/* CENTER — PNL summary */
#headerCenter{
  flex:1;display:flex;align-items:center;justify-content:center;
  gap:12px;min-width:0;overflow:hidden;
}

.pnl-block{display:flex;align-items:baseline;gap:6px;flex-shrink:0;}
.pnl-lbl{
  font-size:8.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--muted);white-space:nowrap;
}
.pnl-num{
  font-family:'Syne',sans-serif;font-size:18px;font-weight:700;
  letter-spacing:-.4px;font-variant-numeric:tabular-nums;
  transition:color .4s;white-space:nowrap;
}
.pnl-num.pos{color:var(--bull);}
.pnl-num.neg{color:var(--bear);}
.pnl-num.zero{color:var(--muted);}

.pnl-chip{
  font-size:9px;padding:2px 7px;border-radius:3px;
  letter-spacing:.06em;white-space:nowrap;flex-shrink:0;
}
.pnl-chip.pos{background:var(--bull-dim);color:var(--bull);border:1px solid rgba(34,197,94,.22);}
.pnl-chip.neg{background:var(--bear-dim);color:var(--bear);border:1px solid rgba(239,68,68,.22);}
.pnl-chip.zero{background:var(--bg3);color:var(--muted);border:1px solid var(--border2);}

.pnl-meta{font-size:9.5px;color:var(--muted);white-space:nowrap;flex-shrink:0;}

#headerRight{display:flex;align-items:center;gap:10px;flex-shrink:0;}

.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:17px;
  letter-spacing:-.5px;color:var(--text);transition:color .35s;white-space:nowrap;}
.logo sup{font-size:9px;font-weight:600;vertical-align:super;color:var(--accent);}

.company-name{font-size:9px;font-weight:300;color:var(--muted);
  letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;}
.company-name sup{font-size:7px;vertical-align:super;color:var(--accent);}

.dv{width:1px;height:18px;background:var(--border2);flex-shrink:0;transition:background .35s;}

.live-pill{display:flex;align-items:center;gap:5px;font-size:9.5px;
  letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
#statusDot{width:6px;height:6px;border-radius:50%;
  background:var(--bull);box-shadow:0 0 6px var(--bull);animation:blink 1.4s ease-in-out infinite;}

.trend-badge{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;
  padding:2px 7px;border-radius:3px;font-weight:500;transition:all .4s;}
.trend-badge.bull{background:var(--bull-dim);color:var(--bull);border:1px solid rgba(34,197,94,.2);}
.trend-badge.bear{background:var(--bear-dim);color:var(--bear);border:1px solid rgba(239,68,68,.2);}

/* theme toggle */
.th-toggle{display:flex;align-items:center;gap:5px;cursor:pointer;user-select:none;
  padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:var(--toggle-bg);
  transition:background .35s,border-color .35s;}
.th-toggle:hover{border-color:var(--accent);}
.tog-em{font-size:11px;line-height:1;transition:transform .5s,opacity .3s;}
.tog-track{width:30px;height:17px;border-radius:9px;background:var(--bg3);
  border:1px solid var(--border2);position:relative;flex-shrink:0;}
.tog-thumb{position:absolute;top:2px;left:2px;width:11px;height:11px;border-radius:50%;
  background:var(--accent);
  transition:transform .3s cubic-bezier(.34,1.56,.64,1),background .35s;
  box-shadow:0 1px 4px rgba(0,0,0,.35);}
[data-theme="light"] .tog-thumb{transform:translateX(13px);background:var(--gold);}
[data-theme="light"] .tog-em-moon{transform:rotate(-30deg) scale(.8);opacity:.35;}
[data-theme="dark"]  .tog-em-sun {transform:rotate(30deg) scale(.8);opacity:.35;}

/* menu */
#menuWrap{position:relative;}
.menu-btn{display:flex;align-items:center;gap:5px;padding:5px 10px;
  border:1px solid var(--border2);border-radius:6px;font-size:10.5px;color:var(--muted);
  transition:all .2s;background:transparent;cursor:pointer;font-family:'DM Mono',monospace;}
.menu-btn:hover{color:var(--text);background:var(--bg3);}
.m-bars{display:flex;flex-direction:column;gap:3px;}
.m-bars span{display:block;width:13px;height:1px;background:currentColor;}
#mDrop{position:absolute;top:calc(100% + 6px);left:0;
  background:var(--bg2);border:1px solid var(--border2);border-radius:8px;
  overflow:hidden;display:none;min-width:148px;
  box-shadow:0 12px 32px var(--shadow);z-index:999;}
#mDrop div{padding:9px 14px;font-size:11.5px;cursor:pointer;color:var(--muted);
  letter-spacing:.05em;transition:all .15s;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:7px;}
#mDrop div:last-child{border-bottom:none;}
#mDrop div:hover{background:var(--bg3);color:var(--text);}
#mDrop div::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--accent);flex-shrink:0;}
#menuWrap.open #mDrop{display:block;}

/* ─── BODY ─── */
#body{flex:1;display:flex;overflow:hidden;min-height:0;}

/* TERMINAL PANEL */
#termPanel{
  width:30%;min-width:180px;max-width:420px;
  display:flex;flex-direction:column;
  border-right:1px solid var(--border);
  transition:border-color .35s;flex-shrink:0;
}

.ph{height:30px;display:flex;align-items:center;padding:0 12px;gap:7px;
  border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0;
  transition:background .35s,border-color .35s;}
.ph-lbl{font-size:8.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);}
.pdot{width:5px;height:5px;border-radius:50%;}
.pdot.cy{background:#22d3ee;box-shadow:0 0 5px #22d3ee;}
.pdot.am{background:var(--gold);box-shadow:0 0 5px var(--gold);}
.pdot.gn{background:var(--bull);box-shadow:0 0 5px var(--bull);}

#terminal{flex:1;overflow:hidden;padding:5px;background:var(--bg);transition:background .35s;}

/* RESIZER */
#resizer{
  width:4px;cursor:col-resize;background:var(--bg);
  border-right:1px solid var(--border);flex-shrink:0;position:relative;
  transition:background .2s;z-index:10;
}
#resizer:hover,#resizer.dragging{background:var(--accent);}
#resizer::after{content:'';position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);width:1px;height:36px;
  background:var(--border2);border-radius:2px;}

/* RIGHT */
#right{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}

/* STATS BAR */
#statsBar{
  height:34px;display:flex;align-items:center;
  border-bottom:1px solid var(--border);background:var(--bg2);
  padding:0 14px;flex-shrink:0;overflow-x:auto;
  transition:background .35s,border-color .35s;
}
.st{display:flex;align-items:center;gap:7px;padding:0 14px;
  border-right:1px solid var(--border);flex-shrink:0;}
.st:first-child{padding-left:0;}
.stk{font-size:8.5px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);}
.stv{font-size:11.5px;font-weight:500;color:var(--text);
  transition:color .35s;font-variant-numeric:tabular-nums;}

/* CHART */
#chartWrap{
  flex:1;position:relative;overflow:hidden;
  background:var(--bg);transition:background .35s;min-height:0;
}
#chartWrap::before{
  content:'';position:absolute;inset:0;
  background:
    linear-gradient(to right, transparent 92%,var(--bg) 100%),
    linear-gradient(to bottom,transparent 88%,var(--bg) 100%);
  pointer-events:none;z-index:2;transition:background .35s;
}
.grid-bg{
  position:absolute;inset:0;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(var(--grid) 1px,transparent 1px),
    linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:56px 56px;
}
canvas#priceChart{position:absolute;inset:0;width:100%!important;height:100%!important;z-index:1;}

/* ═══════════════ PNL OVERLAY ═══════════════
   Lives inside #chartWrap (position:absolute).
   JS repositions top/bottom dynamically.
   ═══════════════════════════════════════════ */
#pnlOverlay{
  position:absolute;
  z-index:5;
  left:10px;
  top:12px;           /* default; JS overrides */
  width:230px;
  max-height:calc(100% - 24px);
  display:flex;flex-direction:column;
  background:var(--ov-bg);
  backdrop-filter:blur(10px) saturate(1.4);
  -webkit-backdrop-filter:blur(10px) saturate(1.4);
  border:1px solid var(--border2);border-radius:8px;
  overflow:hidden;
  box-shadow:0 8px 32px var(--shadow);
  /* smooth glide when direction flips */
  transition:
    top    .6s cubic-bezier(.34,1.2,.64,1),
    bottom .6s cubic-bezier(.34,1.2,.64,1),
    background .35s,border-color .35s;
}

/* overlay header row */
.ov-head{
  display:grid;grid-template-columns:1fr 80px 40px;
  padding:6px 10px 5px;
  background:var(--ov-hdr);border-bottom:1px solid var(--border2);flex-shrink:0;
}
.ov-th{font-size:7.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);}
.ov-th:nth-child(2){text-align:right;}
.ov-th:nth-child(3){text-align:right;}

/* body */
#ovBody{overflow-y:auto;flex:1;}

.ov-row{
  display:grid;grid-template-columns:1fr 80px 40px;
  padding:5px 10px;border-bottom:1px solid var(--border);
  transition:background .12s;
  animation:fadeRow .22s ease both;
}
.ov-row:last-child{border-bottom:none;}
.ov-row:hover{background:var(--ov-row);}

@keyframes fadeRow{
  from{opacity:0;transform:translateY(4px);}
  to  {opacity:1;transform:translateY(0);}
}

.ov-sym{
  font-size:10.5px;font-weight:500;color:var(--text);
  letter-spacing:.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.ov-pnl{font-size:10.5px;text-align:right;font-variant-numeric:tabular-nums;font-weight:500;}
.ov-pnl.pos{color:var(--bull);}
.ov-pnl.neg{color:var(--bear);}
.ov-pnl.zero{color:var(--muted);}
.ov-cnt{font-size:9.5px;text-align:right;color:var(--muted);}

/* empty state */
.ov-empty{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;padding:20px 12px;gap:6px;color:var(--muted);
}
.ov-empty-ico{font-size:20px;opacity:.28;}
.ov-empty-txt{font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;}

/* footer */
.ov-foot{
  display:grid;grid-template-columns:1fr 80px 40px;
  padding:6px 10px;
  background:var(--ov-hdr);border-top:1px solid var(--border2);flex-shrink:0;
}
.ov-foot-lbl{
  font-size:8px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--muted);display:flex;align-items:center;gap:4px;
}
.ov-foot-lbl::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--accent);flex-shrink:0;}
.ov-foot-val{
  font-size:12px;font-weight:700;text-align:right;
  font-family:'Syne',sans-serif;font-variant-numeric:tabular-nums;
}
.ov-foot-val.pos{color:var(--bull);}
.ov-foot-val.neg{color:var(--bear);}
.ov-foot-val.zero{color:var(--muted);}
.ov-foot-cnt{font-size:9.5px;text-align:right;color:var(--muted);
  display:flex;align-items:center;justify-content:flex-end;}

/* ─── BOTTOM BAR ─── */
#bottomBar{
  flex-shrink:0;height:42px;
  background:var(--bg2);border-top:1px solid var(--border);
  display:flex;align-items:center;padding:0 14px;gap:12px;
  transition:background .35s,border-color .35s;z-index:50;
}
#bbLeft{display:flex;align-items:center;gap:8px;min-width:90px;flex-shrink:0;}
.bb-lbl{font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);}

#momWrap{flex:1;height:30px;position:relative;
  background:var(--bg3);border-radius:4px;border:1px solid var(--border);
  overflow:visible;min-width:0;}
canvas#momBar{position:absolute;inset:0;width:100%!important;height:100%!important;}

#bbRight{display:flex;align-items:center;gap:10px;min-width:80px;
  justify-content:flex-end;flex-shrink:0;}
.clock{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;}

/* ═══════════════ ANIMATIONS ═══════════════ */
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.2;}}
@keyframes scanMove{from{transform:translateY(-100%);}to{transform:translateY(100vh);}}
.scanline{
  position:fixed;top:0;left:0;right:0;height:55px;
  background:linear-gradient(to bottom,transparent,var(--scanline),transparent);
  pointer-events:none;z-index:9999;
  animation:scanMove 9s linear infinite;
}

/* ═══════════════ RESPONSIVE ═══════════════ */
@media(max-width:600px){
  #termPanel,#resizer{display:none;}
  #pnlOverlay{width:190px;}
  .pnl-num{font-size:15px;}
  .company-name,.dv.hide-sm{display:none;}
}
@media(max-width:860px){.company-name{display:none;}}
@media(min-width:1400px){
  #termPanel{width:26%;}
  #pnlOverlay{width:258px;}
}
@media(min-width:1800px){
  .pnl-num{font-size:22px;}
  #pnlOverlay{width:288px;}
  .ov-sym,.ov-pnl{font-size:12px;}
}

/* xterm overrides */
.xterm{height:100%!important;}
.xterm-viewport,.xterm-screen{background:transparent!important;}
</style>
</head>

<body>
<div class="scanline"></div>

<div id="app">

  <!-- ══════════ HEADER ══════════ -->
  <div id="topHeader">

    <div id="headerLeft">
      <div id="menuWrap">
        <div class="menu-btn" id="menuBtn">
          <div class="m-bars"><span></span><span></span><span></span></div>
        </div>
        <div id="mDrop">
          <div>CSV Stream 1</div>
          <div>CSV Stream 2</div>
          <div>CSV Stream 3</div>
        </div>
      </div>
      <div class="dv"></div>
      <div class="live-pill"><span id="statusDot"></span><span>Live</span></div>
      <span class="trend-badge bull" id="trendBadge">Bullish</span>
    </div>

    <!-- CENTER — cumulative PNL -->
    <div id="headerCenter">
      <div class="pnl-block">
        <span class="pnl-lbl">Net P&amp;L</span>
        <span class="pnl-num zero" id="hdrPnl">₹ —</span>
      </div>
      <span class="pnl-chip zero" id="hdrChip">No Data</span>
      <span class="pnl-meta" id="hdrMeta">0 trades · 0 symbols</span>
    </div>

    <div id="headerRight">
      <div class="th-toggle" id="themeToggle">
        <span class="tog-em tog-em-moon">🌙</span>
        <div class="tog-track"><div class="tog-thumb"></div></div>
        <span class="tog-em tog-em-sun">☀️</span>
      </div>
      <div class="dv hide-sm"></div>
      <span class="company-name">PreciseXceleratedYield Pvt Ltd<sup>™</sup></span>
      <div class="dv"></div>
      <span class="logo">PXY<sup>®</sup></span>
    </div>

  </div>

  <!-- ══════════ BODY ══════════ -->
  <div id="body">

    <div id="termPanel">
      <div class="ph">
        <div class="pdot gn"></div>
        <div class="pdot am"></div>
        <div class="pdot cy"></div>
        <span class="ph-lbl" style="margin-left:4px;">System Log</span>
      </div>
      <div id="terminal"></div>
    </div>

    <div id="resizer"></div>

    <div id="right">
      <div id="statsBar">
        <div class="st"><span class="stk">Open</span><span class="stv" id="sOpen">—</span></div>
        <div class="st"><span class="stk">High</span><span class="stv" style="color:var(--bull)" id="sHigh">—</span></div>
        <div class="st"><span class="stk">Low</span><span class="stv"  style="color:var(--bear)" id="sLow">—</span></div>
        <div class="st"><span class="stk">ST</span><span class="stv" id="sST">—</span></div>
        <div class="st"><span class="stk">Δ Close</span><span class="stv" id="sDelta">—</span></div>
      </div>

      <div id="chartWrap">
        <div class="grid-bg"></div>
        <canvas id="priceChart"></canvas>

        <!-- ══ PNL OVERLAY on chart ══ -->
        <div id="pnlOverlay">
          <div class="ov-head">
            <span class="ov-th">Symbol</span>
            <span class="ov-th">PNL ₹</span>
            <span class="ov-th">Trades</span>
          </div>
          <div id="ovBody"></div>
          <div class="ov-foot">
            <span class="ov-foot-lbl">Total</span>
            <span class="ov-foot-val zero" id="ovTotal">—</span>
            <span class="ov-foot-cnt" id="ovCnt">—</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ══════════ BOTTOM BAR ══════════ -->
  <div id="bottomBar">
    <div id="bbLeft"><span class="bb-lbl">Momentum</span></div>
    <div id="momWrap"><canvas id="momBar"></canvas></div>
    <div id="bbRight"><span class="clock" id="clockEl">—</span></div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/xterm/lib/xterm.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit/lib/xterm-addon-fit.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
/* ══════════════════════════════════════════
   THEME
══════════════════════════════════════════ */
const html = document.documentElement;
let isDark = true;

const darkTerm = {
  background:'#06080d',foreground:'#8899bb',cursor:'#3b82f6',
  green:'#22c55e',red:'#ef4444',yellow:'#f59e0b',
  cyan:'#22d3ee',blue:'#3b82f6',brightBlack:'#374151',brightWhite:'#e8ecf4'
};
const lightTerm = {
  background:'#f0f3fa',foreground:'#334155',cursor:'#2563eb',
  green:'#16a34a',red:'#dc2626',yellow:'#d97706',
  cyan:'#0891b2',blue:'#2563eb',brightBlack:'#cbd5e1',brightWhite:'#0f172a'
};

document.getElementById('themeToggle').addEventListener('click', e => {
  e.stopPropagation();
  isDark = !isDark;
  html.setAttribute('data-theme', isDark ? 'dark' : 'light');
  if (term)  term.options.theme = isDark ? darkTerm : lightTerm;
  if (chart) {
    chart.options.scales.y.grid.color  = cv('--chart-grid');
    chart.options.scales.y.ticks.color = cv('--chart-tick');
    chart.update('none');
  }
  if (lastSt && lastCloses) drawMom(lastSt, lastCloses);
});

function cv(n){ return getComputedStyle(html).getPropertyValue(n).trim(); }

/* ══════════════════════════════════════════
   TERMINAL
══════════════════════════════════════════ */
const term = new Terminal({
  convertEol:true, scrollback:1000,
  fontFamily:"'DM Mono',monospace",
  fontSize:11, lineHeight:1.5, cursorBlink:false,
  theme:darkTerm
});
const fitAddon = new FitAddon.FitAddon();
term.loadAddon(fitAddon);
term.open(document.getElementById('terminal'));
setTimeout(() => fitAddon.fit(), 60);
window.addEventListener('resize', () => { fitAddon.fit(); repositionOverlay(); });

try {
  const ws = new WebSocket(`ws://${location.host}`);
  ws.onmessage = e => term.write(e.data);
} catch(_){}

/* ══════════════════════════════════════════
   MENU
══════════════════════════════════════════ */
const menuWrap = document.getElementById('menuWrap');
document.getElementById('menuBtn').onclick = e => {
  e.stopPropagation(); menuWrap.classList.toggle('open');
};
window.addEventListener('click', () => menuWrap.classList.remove('open'));

/* ══════════════════════════════════════════
   RESIZER (drag to resize terminal panel)
══════════════════════════════════════════ */
const resizer   = document.getElementById('resizer');
const termPanel = document.getElementById('termPanel');
let dragging = false;
resizer.addEventListener('mousedown', () => { dragging = true; resizer.classList.add('dragging'); });
window.addEventListener('mouseup',   () => { dragging = false; resizer.classList.remove('dragging'); });
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  const br  = document.getElementById('body').getBoundingClientRect();
  const pct = ((e.clientX - br.left) / br.width) * 100;
  if (pct < 10 || pct > 68) return;
  termPanel.style.width = pct + '%';
  fitAddon.fit();
});

/* ══════════════════════════════════════════
   CLOCK
══════════════════════════════════════════ */
function tick(){
  document.getElementById('clockEl').textContent =
    new Date().toLocaleTimeString('en-IN', {hour12:false});
}
tick(); setInterval(tick, 1000);

/* ══════════════════════════════════════════
   STATE
══════════════════════════════════════════ */
let chart = null, lastSt = null, lastCloses = null;

/* ══════════════════════════════════════════
   SMART OVERLAY POSITION
   — checks where the price line ENDS on chart
   — if ending in upper half  → overlay bottom-left (avoids clash)
   — if ending in lower half  → overlay top-left
══════════════════════════════════════════ */
const overlay = document.getElementById('pnlOverlay');

function repositionOverlay() {
  if (!lastCloses || !lastCloses.length) return;
  const slice = lastCloses.slice(-60);
  const mn    = Math.min(...slice);
  const mx    = Math.max(...slice);
  const range = mx - mn || 1;
  // normalised 0–1: 1 = price at the very top of range
  const norm  = (slice.at(-1) - mn) / range;
  const M     = 12;                         // margin px

  if (norm >= 0.45) {
    // price in upper zone → put overlay at bottom
    overlay.style.top    = 'auto';
    overlay.style.bottom = M + 'px';
  } else {
    // price in lower zone → put overlay at top
    overlay.style.top    = M + 'px';
    overlay.style.bottom = 'auto';
  }
}

/* ══════════════════════════════════════════
   PNL  — fetch pnl.json + render
══════════════════════════════════════════ */
async function loadPNL() {
  let rows = [];
  try {
    const r = await fetch('./pnl.json');
    if (r.ok) rows = await r.json();
  } catch(_){}
  renderPNL(rows);
}

function fmt(n) {
  return n.toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});
}

function renderPNL(rows) {
  /* group by Symbol */
  const map = {};
  for (const r of rows) {
    const sym = (r.Symbol || '—').trim();
    if (!map[sym]) map[sym] = {pnl:0, count:0};
    map[sym].pnl   += Number(r.PNL) || 0;
    map[sym].count += 1;
  }

  const groups     = Object.entries(map).sort((a,b) => b[1].pnl - a[1].pnl);
  const totalPNL   = groups.reduce((s,[,v]) => s + v.pnl, 0);
  const totalTrades= rows.length;
  const totalSyms  = groups.length;

  /* ─ header ─ */
  const hdrPnl  = document.getElementById('hdrPnl');
  const hdrChip = document.getElementById('hdrChip');
  const hdrMeta = document.getElementById('hdrMeta');

  if (totalTrades === 0) {
    hdrPnl.className   = 'pnl-num zero';
    hdrPnl.textContent = '₹ 0.00';
    hdrChip.className  = 'pnl-chip zero';
    hdrChip.textContent= 'No Data';
    hdrMeta.textContent= '0 trades · 0 symbols';
  } else {
    const cls = totalPNL > 0 ? 'pos' : totalPNL < 0 ? 'neg' : 'zero';
    hdrPnl.className   = 'pnl-num ' + cls;
    hdrPnl.textContent = (totalPNL >= 0 ? '+' : '-') + '₹\u202f' + fmt(Math.abs(totalPNL));
    hdrChip.className  = 'pnl-chip ' + cls;
    hdrChip.textContent= totalPNL > 0 ? '▲ Profit' : totalPNL < 0 ? '▼ Loss' : '● Flat';
    hdrMeta.textContent= `${totalTrades} trade${totalTrades!==1?'s':''} · ${totalSyms} symbol${totalSyms!==1?'s':''}`;
  }

  /* ─ overlay rows ─ */
  const body = document.getElementById('ovBody');
  body.innerHTML = '';

  if (groups.length === 0) {
    body.innerHTML = `
      <div class="ov-empty">
        <div class="ov-empty-ico">◈</div>
        <div class="ov-empty-txt">No records</div>
      </div>`;
  } else {
    groups.forEach(([sym, {pnl, count}], i) => {
      const pcls = pnl > 0 ? 'pos' : pnl < 0 ? 'neg' : 'zero';
      const sign = pnl >= 0 ? '+' : '-';
      const row  = document.createElement('div');
      row.className = 'ov-row';
      row.style.animationDelay = (i * 0.028) + 's';
      row.innerHTML = `
        <span class="ov-sym" title="${sym}">${sym}</span>
        <span class="ov-pnl ${pcls}">${sign}${fmt(Math.abs(pnl))}</span>
        <span class="ov-cnt">${count}</span>`;
      body.appendChild(row);
    });
  }

  /* ─ overlay footer ─ */
  const ovTotal = document.getElementById('ovTotal');
  const ovCnt   = document.getElementById('ovCnt');
  const tcls    = totalPNL > 0 ? 'pos' : totalPNL < 0 ? 'neg' : 'zero';
  ovTotal.className   = 'ov-foot-val ' + tcls;
  ovTotal.textContent = totalTrades === 0
    ? '—'
    : (totalPNL >= 0 ? '+' : '-') + fmt(Math.abs(totalPNL));
  ovCnt.textContent   = totalTrades || '—';
}

/* ══════════════════════════════════════════
   CHART DATA
══════════════════════════════════════════ */
async function loadChart() {
  let data = null;
  try {
    const r = await fetch('./syschrtpxy.json');
    if (r.ok) data = await r.json();
  } catch(_){}
  if (!data) data = genDemo();

  const closes = data.map(d => d.close);
  const st     = data.map(d => d.st);
  const trend  = data.map(d => d.st_trend);
  lastSt = st; lastCloses = closes;

  updateBadge(closes);
  updateStats(closes, st);
  drawChart(closes, st, trend);
  drawMom(st, closes);
  repositionOverlay();
}

function genDemo() {
  let p = 2450, s = 2430;
  return Array.from({length:80}, () => {
    p += (Math.random() - 0.48) * 12;
    s += (Math.random() - 0.49) * 6;
    return {close:p, st:s, st_trend: p>s ? 1 : -1};
  });
}

function updateBadge(closes) {
  const last = closes.at(-1), prev = closes.at(-2) || closes.at(-1);
  const isBull = last >= prev;
  const badge  = document.getElementById('trendBadge');
  badge.className   = 'trend-badge ' + (isBull ? 'bull' : 'bear');
  badge.textContent = isBull ? 'Bullish' : 'Bearish';
  document.getElementById('topHeader').style.boxShadow = isBull
    ? '0 1px 0 rgba(34,197,94,.22)' : '0 1px 0 rgba(239,68,68,.22)';
}

function updateStats(closes, st) {
  const sl = closes.slice(-40);
  const last = closes.at(-1), prev = closes.at(-2) || closes.at(-1);
  document.getElementById('sOpen').textContent = closes.at(-40)?.toFixed(2) ?? '—';
  document.getElementById('sHigh').textContent = Math.max(...sl).toFixed(2);
  document.getElementById('sLow').textContent  = Math.min(...sl).toFixed(2);
  document.getElementById('sST').textContent   = st.at(-1)?.toFixed(2) ?? '—';
  const d = last - prev;
  const el = document.getElementById('sDelta');
  el.textContent = (d >= 0 ? '+' : '') + d.toFixed(2);
  el.style.color = d >= 0 ? 'var(--bull)' : 'var(--bear)';
}

function drawChart(closes, st) {
  const MAX=60, PAD=8;
  const c = closes.slice(-MAX), s = st.slice(-MAX);
  const labels = [...c.map((_,i)=>i), ...Array(PAD).fill('')];
  const cPad   = [...c, ...Array(PAD).fill(null)];
  const sPad   = [...s, ...Array(PAD).fill(null)];
  const isBull = c.at(-1) >= (c.at(-2) || c.at(-1));
  const lineClr= isBull ? cv('--bull') : cv('--bear');
  const fillTop= isBull ? 'rgba(34,197,94,.11)' : 'rgba(239,68,68,.11)';

  if (!chart) {
    chart = new Chart(document.getElementById('priceChart'), {
      type:'line',
      data:{
        labels,
        datasets:[
          {
            data:cPad,
            borderColor:lineClr,borderWidth:2,
            pointRadius:0,fill:true,
            backgroundColor: ctx => {
              const g = ctx.chart.ctx.createLinearGradient(0,0,0,ctx.chart.height);
              g.addColorStop(0, fillTop);
              g.addColorStop(1, 'rgba(0,0,0,0)');
              return g;
            },
            tension:.35
          },
          {
            data:sPad,
            borderWidth:1.5,pointRadius:0,
            borderColor:'rgba(59,130,246,.55)',
            borderDash:[4,4],fill:false,tension:.3
          }
        ]
      },
      options:{
        animation:false,responsive:true,maintainAspectRatio:false,
        interaction:{mode:'index',intersect:false},
        plugins:{
          legend:{display:false},
          tooltip:{
            backgroundColor:cv('--bg2'),
            borderColor:cv('--border2'),borderWidth:1,
            titleColor:cv('--muted'),bodyColor:cv('--text'),
            padding:10,
            titleFont:{family:"'DM Mono',monospace",size:9},
            bodyFont: {family:"'DM Mono',monospace",size:11},
            callbacks:{label: ctx => {
              const nm = ctx.datasetIndex===0 ? 'Close' : 'ST';
              return `  ${nm}: ${ctx.parsed.y?.toFixed(2) ?? '—'}`;
            }}
          }
        },
        scales:{
          x:{display:false},
          y:{
            display:true,position:'right',
            grid:{color:cv('--chart-grid'),drawBorder:false},
            ticks:{color:cv('--chart-tick'),
              font:{family:"'DM Mono',monospace",size:9},maxTicksLimit:6}
          }
        }
      }
    });
  } else {
    chart.data.labels = labels;
    chart.data.datasets[0].data        = cPad;
    chart.data.datasets[0].borderColor = lineClr;
    chart.data.datasets[1].data        = sPad;
    chart.update('none');
  }
}

/* ══════════════════════════════════════════
   MOMENTUM BAR
══════════════════════════════════════════ */
function drawMom(stVals, closes) {
  const canvas = document.getElementById('momBar');
  const ctx    = canvas.getContext('2d');
  const dpr    = window.devicePixelRatio || 1;
  const rect   = canvas.parentElement.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  canvas.style.width  = rect.width  + 'px';
  canvas.style.height = rect.height + 'px';
  ctx.scale(dpr, dpr);

  const W=rect.width, H=rect.height, PADX=55, midY=H/2;
  const rC=closes.slice(-60), rS=stVals.slice(-60);
  const all=[...rC,...rS];
  const hi=Math.max(...all), lo=Math.min(...all), range=hi-lo||1;
  const toX = v => ((v-lo)/range)*(W-PADX*2)+PADX;

  const open=stVals.at(-1), close=closes.at(-1);
  const wHi=Math.max(...rC.slice(-5),...rS.slice(-5));
  const wLo=Math.min(...rC.slice(-5),...rS.slice(-5));
  const bull=close>=open;
  const bodyClr=bull ? cv('--bull') : cv('--bear');
  const glowClr=bull ? 'rgba(34,197,94,.5)' : 'rgba(239,68,68,.5)';

  ctx.clearRect(0,0,W,H);

  // track
  const tg=ctx.createLinearGradient(0,0,W,0);
  tg.addColorStop(0,'rgba(0,0,0,0)');
  tg.addColorStop(0.1,cv('--track-mid'));
  tg.addColorStop(0.9,cv('--track-mid'));
  tg.addColorStop(1,'rgba(0,0,0,0)');
  ctx.strokeStyle=tg; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(PADX,midY); ctx.lineTo(W-PADX,midY); ctx.stroke();

  // wick
  ctx.strokeStyle=bodyClr; ctx.lineWidth=1.5; ctx.globalAlpha=.45;
  ctx.beginPath(); ctx.moveTo(toX(wLo),midY); ctx.lineTo(toX(wHi),midY); ctx.stroke();
  ctx.globalAlpha=1;
  [toX(wLo),toX(wHi)].forEach(x=>{
    ctx.beginPath(); ctx.moveTo(x,midY-5); ctx.lineTo(x,midY+5); ctx.stroke();
  });

  // body
  const bx1=toX(Math.min(open,close)), bx2=toX(Math.max(open,close));
  const bodyW=Math.max(bx2-bx1,4), bodyH=13;
  ctx.shadowColor=glowClr; ctx.shadowBlur=10;
  ctx.fillStyle=bodyClr;
  ctx.beginPath(); ctx.roundRect(bx1,midY-bodyH/2,bodyW,bodyH,3); ctx.fill();
  ctx.shadowBlur=0;
  ctx.fillStyle='rgba(255,255,255,.11)';
  ctx.beginPath(); ctx.roundRect(bx1+2,midY-bodyH/2+2,bodyW-4,4,2); ctx.fill();

  // labels
  ctx.fillStyle=cv('--muted'); ctx.font="9.5px 'DM Mono',monospace";
  ctx.textAlign='left';  ctx.fillText('L '+wLo.toFixed(1), 4, midY+4);
  ctx.textAlign='right'; ctx.fillText('H '+wHi.toFixed(1), W-4, midY-5);
  ctx.fillStyle=bodyClr; ctx.font="bold 9.5px 'DM Mono',monospace";
  ctx.fillText(close.toFixed(2), W-4, midY+5);
}

/* ══════════════════════════════════════════
   INIT
══════════════════════════════════════════ */
async function refresh() {
  await Promise.all([loadChart(), loadPNL()]);
}
refresh();
setInterval(refresh, 3000);
</script>
</body>
</html>
