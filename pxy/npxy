#!/bin/bash

# 1️⃣ Start pxy.js silently if not running
pgrep -f "/home/neo/pxy.js" >/dev/null 2>&1 || \
  nohup node /home/neo/pxy.js > /dev/null 2>&1 &

# 2️⃣ Only run tmux logic if not already inside a tmux session
if [ -z "$TMUX" ]; then
    tmux has-session -t npxy 2>/dev/null \
      && tmux attach -t npxy \
      || tmux new -s npxy 'pxyexe'
else
    echo "pxy.js is running; already inside tmux, not attaching."
fi
