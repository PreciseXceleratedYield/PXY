#!/bin/bash

# ---------------- Force project directory ----------------
cd ~/pxy || { echo "Directory ~/pxy not found! Exiting."; exit 1; }

# ---------------- TMUX SESSION NAME ----------------
SESSION="neopxy"

# ---------------- Avoid nested tmux sessions ----------------
unset TMUX

# ---------------- Activate virtualenv ----------------
source ~/env/bin/activate

# ---------------- Function to cleanly kill ----------------
cleanup() {
    echo "⏹ Ctrl+C detected → stopping pxymain.py and tmux..."
    tmux kill-session -t $SESSION 2>/dev/null
    exit 0
}

# Trap Ctrl+C
trap cleanup SIGINT

# ---------------- Launch or attach ----------------
tmux has-session -t $SESSION 2>/dev/null
if [ $? -eq 0 ]; then
    # Attach to existing session
    tmux attach -t $SESSION
else
    # Create session and run pxymain.py
    tmux new-session -s $SESSION -d "bash -c '
        echo \"=== Starting pxymain.py: \$(date) ===\";
        python ~/pxy/sys/exe/run/pxymain.py;
        echo \"=== pxymain.py exited: \$(date) ===\";
        exec bash
    '"
    # Attach after starting
    tmux attach -t $SESSION
fi
