#!/bin/bash

# ---------------- Force project directory ----------------
cd ~/pxy || { echo "Directory ~/pxy not found! Exiting."; exit 1; }

# ---------------- Create logs directory ----------------
mkdir -p logs
LOG_FILE="logs/neopxy.log"

# ---------------- TMUX SESSION NAME ----------------
SESSION="neopxy"

# ---------------- Avoid nested tmux sessions ----------------
unset TMUX

# ---------------- Activate virtualenv ----------------
source ~/env/bin/activate

# ---------------- Launch or attach tmux ----------------
tmux new-session -A -s $SESSION -d \
    "bash -c '
        echo \"=== Starting neopxy: \$(date) ===\";
        source ~/env/bin/activate;
        # Run pxymain.py with colors preserved and log output
        script -q -f -c \"python pxymain.py\" $LOG_FILE;
        echo \"=== pxymain.py exited: \$(date) ===\";
        exec bash
    '"

# ---------------- Attach to tmux ----------------
tmux attach -t $SESSION
