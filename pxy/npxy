#!/bin/bash

# ---------------- Force project directory ----------------
cd ~/pxy || { echo "Directory ~/pxy not found! Exiting."; exit 1; }

# ---------------- Create logs directory ----------------
mkdir -p logs
LOG_FILE="logs/neopxy.log"

# ---------------- TMUX SESSION NAME ----------------
SESSION="neopxy"

# ---------------- Check if tmux session exists ----------------
tmux has-session -t $SESSION 2>/dev/null

if [ $? -eq 0 ]; then
    # Session exists → attach
    tmux attach -t $SESSION
else
    # Session doesn't exist → create and run pxy inside tmux
    tmux new -s $SESSION "bash -c '
        echo \"=== Starting neopxy: \$(date) ===\";
        source ~/env/bin/activate;
        ./pxy 2>&1 | tee -a $LOG_FILE;
        echo \"=== pxy exited: \$(date) ===\";
        exec bash
    '"
fi
