#!/bin/bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/pxyrslve" ]; then
    source "$SCRIPT_DIR/pxyrslve"
elif [ -f "$HOME/.local/bin/pxyrslve" ]; then
    source "$HOME/.local/bin/pxyrslve"
else
    echo "[X] PXY path helper not found." >&2
    exit 1
fi
PXY_APP_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[X] Could not locate the PXY application directory." >&2
    exit 1
}
pxy_activate_env || exit 1

cd "$PXY_APP_DIR/sys" || { echo "Directory $PXY_APP_DIR/sys not found"; exit 1; }

# Isolate BTC-USD testing to this monitor process only.
export PXY_MONITOR_MODE=1

# Optional: activate virtual environment if needed
# source ~/pxy/env/bin/activate

echo "Starting loop. Press [CTRL+C] to stop."
echo "----------------------------------------"

# Infinite loop
while true; do
    echo "[$(date +%T)] Running sysdashpxy.py..."
    
    # Run the Python script
    # Use the same dashboard snapshot and chart export pipeline as production.
    # Only the market-data source differs (monitor ticker instead of NIFTY).
    python3 - <<'PY'
from sysdashpxy import get_full_snapshot, print_dashboard
from sysictrpxy import export_supertrend_json

snapshot = get_full_snapshot(monitor=True)
print_dashboard(snapshot)
if snapshot:
    export_supertrend_json(snapshot.get("chart_df", snapshot.get("df")))
PY
    
    echo "[$(date +%T)] execution finished."
    echo "Waiting 10 seconds..."
    echo "----------------------------------------"
    
    # Sleep for 10 seconds before the next iteration
    sleep 10
done
