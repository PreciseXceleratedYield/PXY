#!/bin/bash
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/pxyrslve" ]; then
    source "$SCRIPT_DIR/pxyrslve"
elif [ -f "$HOME/.local/bin/pxyrslve" ]; then
    source "$HOME/.local/bin/pxyrslve"
else
    echo "[X] PXY path helper not found." >&2
    exit 1
fi
PXY_APP_DIR="$(pxy_resolve_app_dir "$SCRIPT_DIR")" || {
    echo "[X] Could not locate the PXY application directory." >&2
    exit 1
}
pxy_activate_env || exit 1

cd "$PXY_APP_DIR/sys" || { echo "Directory $PXY_APP_DIR/sys not found"; exit 1; }

# Read-only Control Tower summary; no additional monitor process is started.
if [[ -f "$PXY_APP_DIR/pxytlgr" ]]; then
    echo "===== PXY TELEGRAM CONTROL TOWER ====="
    bash "$PXY_APP_DIR/pxytlgr" status
    echo "======================================"
fi

# Isolate BTC-USD testing to this monitor process only.
export PXY_MONITOR_MODE=1

# Optional: activate virtual environment if needed
# source ~/pxy/env/bin/activate

# Blackout only on actual NSE F&O trading days, 09:00–16:00 IST.
# Share the trading engine's holiday calendar and cache. If calendar lookup
# fails on a weekday in this window, conservatively keep the blackout.
market_is_open() {
    local weekday hhmm status
    weekday=$(TZ=Asia/Kolkata date +%u)
    hhmm=$(TZ=Asia/Kolkata date +%H%M)
    (( weekday >= 1 && weekday <= 5 && 10#$hhmm >= 900 && 10#$hhmm < 1600 )) || return 1

    TZ=Asia/Kolkata python3 - <<'PY'
from datetime import datetime
from zoneinfo import ZoneInfo
from syshdaypxy import is_nse_fo_trading_day
import sys
try:
    today = datetime.now(ZoneInfo("Asia/Kolkata")).date()
    sys.exit(0 if is_nse_fo_trading_day(today) else 1)
except Exception as error:
    print(f"pxymon: NSE holiday calendar unavailable; retaining weekday blackout: {error}", file=sys.stderr)
    sys.exit(2)
PY
    status=$?
    # 0 = trading day, 1 = holiday, 2 = unknown (blackout for safety).
    (( status != 1 ))
}

if market_is_open; then
    echo "I am blocked now. Come back after 4:00 PM IST."
    exit 0
fi

MAX_ITERATIONS=100
echo "Starting monitor for ${MAX_ITERATIONS} iterations. Press [CTRL+C] to stop early."
echo "----------------------------------------"

for ((iteration=1; iteration<=MAX_ITERATIONS; iteration++)); do
    if market_is_open; then
        echo "pxymon blackout started; stopping before the next iteration."
        exit 0
    fi
    echo "Iteration ${iteration}/${MAX_ITERATIONS}"
    echo "[$(date +%T)] Running sysdashpxy.py..."
    
    # Run the Python script
    # Use the same dashboard snapshot and chart export pipeline as production.
    # Only the market-data source differs (monitor ticker instead of NIFTY).
    python3 - <<'PY'
from sysdashpxy import get_full_snapshot, print_dashboard
from sysictrpxy import export_supertrend_json

snapshot = get_full_snapshot(monitor=True)
print_dashboard(snapshot)
if snapshot:
    export_supertrend_json(snapshot.get("chart_df", snapshot.get("df")))
PY
    
    echo "[$(date +%T)] execution finished."
    if (( iteration < MAX_ITERATIONS )); then
        echo "Waiting 10 seconds..."
        echo "----------------------------------------"
        sleep 10
    fi
done

echo "Completed ${MAX_ITERATIONS} monitor iterations. Exiting pxymon."
