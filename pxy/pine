//@version=5
indicator("PXY Engine - Multi-Mode Unified Matrix Sync", overlay=true)

// --- Global Config & Mode Switches ---
MA_TYPE             = input.string("TSMA", title="MA Type", options=["SMA", "TSMA"])
OHLC_MODE           = input.int(1, title="Data Transformation Mode", minval=1, maxval=6, tooltip="1: Raw, 2: Heikin-Ashi, 3: Open-Close Median, 4: Shift Momentum, 5: Composite Blend, 6: 4-SMA OC/2")
show_custom_candles = input.bool(true, title="Show Transformed Candlesticks")

// --- Mode 2 & Mode 5 Dependent Function: Pure Heikin-Ashi Matrix Generator ---
get_ha_matrices() =>
    var float ha_o = na
    float ha_c = (open + high + low + close) / 4.0
    ha_o := na(ha_o) ? (open + close) / 2.0 : (ha_o + ha_c) / 2.0
    float ha_h = math.max(high, math.max(ha_o, ha_c))
    float ha_l = math.min(low, math.min(ha_o, ha_c))
    [ha_o, ha_h, ha_l, ha_c]

[ha_o_m2, ha_h_m2, ha_l_m2, ha_c_m2] = get_ha_matrices()

// --- Mode 6 Dependent Function: 4-SMA OC/2 Loop Generator ---
get_mode6_matrices() =>
    float sma_o = ta.sma(open, 4)
    float sma_c = ta.sma(close, 4)
    var float m6_o = na
    float m6_c = (sma_o + sma_c) / 2.0
    m6_o := na(m6_o) ? m6_c : (m6_o + m6_c) / 2.0
    float m6_h = math.max(m6_o, m6_c)
    float m6_l = math.min(m6_o, m6_c)
    [m6_o, m6_h, m6_l, m6_c]

[m6_o, m6_h, m6_l, m6_c] = get_mode6_matrices()

// --- Dynamic Runtime OHLC Assignment Switching Block ---
float src_o = open
float src_h = high
float src_l = low
float src_c = close

if OHLC_MODE == 1
    src_o := open
    src_h := high
    src_l := low
    src_c := close
else if OHLC_MODE == 2
    src_o := ha_o_m2
    src_h := ha_h_m2
    src_l := ha_l_m2
    src_c := ha_c_m2
else if OHLC_MODE == 3
    float oc2 = (open + close) / 2.0
    src_o := oc2
    src_h := oc2
    src_l := oc2
    src_c := oc2
else if OHLC_MODE == 4
    float raw_c1 = na(close[1]) ? close : close[1]
    src_o := raw_c1
    src_h := close
    src_l := raw_c1
    src_c := close
else if OHLC_MODE == 5
    float oc2 = (open + close) / 2.0
    float raw_c1 = na(close[1]) ? close : close[1]
    src_o := (open + ha_o_m2 + oc2 + raw_c1) / 4.0
    src_h := (high + ha_h_m2 + oc2 + close) / 4.0
    src_l := (low + ha_l_m2 + oc2 + raw_c1) / 4.0
    src_c := (close + ha_c_m2 + oc2 + close) / 4.0
else if OHLC_MODE == 6
    src_o := m6_o
    src_h := m6_h
    src_l := m6_l
    src_c := m6_c

// --- Plot Active Transformed Matrix Custom Candles ---
candle_color = src_c >= src_o ? color.green : color.red
plotcandle(src_o, src_h, src_l, src_c, title="Active Transformed Candles", 
           color=show_custom_candles ? candle_color : color.new(color.white, 100), 
           wickcolor=show_custom_candles ? candle_color : color.new(color.white, 100), 
           bordercolor=show_custom_candles ? candle_color : color.new(color.white, 100))

// --- 100% Synced Custom Functions (NumPy Loop Replications using Active Matrix Inputs) ---

// Replicates Python: calculate_sma_42
calculate_sma_42(float src) =>
    int i = bar_index
    int current_window = math.min(i + 1, 42)
    float sum = 0.0
    for j = 0 to current_window - 1
        sum := sum + src[j]
    sum / current_window

// Replicates Python: calculate_tsma_42
calculate_tsma_42(float src) =>
    int i = bar_index
    float tsma_output = src
    if i > 0
        int current_window = math.min(i + 1, 42)
        float x_sum = 0.0
        float y_sum = 0.0
        for j = 0 to current_window - 1
            x_sum := x_sum + j
            y_sum := y_sum + src[j]
        float x_mean = x_sum / current_window
        float y_mean = y_sum / current_window
        float num = 0.0
        float denom = 0.0
        for j = 0 to current_window - 1
            float x_val = (current_window - 1) - j 
            float x_diff = x_val - x_mean
            num := num + (x_diff * (src[j] - y_mean))
            denom := denom + math.pow(x_diff, 2)
        if denom == 0
            tsma_output := src
        else
            float slope = num / denom
            float intercept = y_mean - slope * x_mean
            tsma_output := slope * (current_window - 1) + intercept
    tsma_output

// Replicates Python: rolling(42, min_periods=1).max() over Active High Matrix
calculate_hh_42(float src) =>
    int current_window = math.min(bar_index + 1, 42)
    float max_val = src
    for j = 0 to current_window - 1
        max_val := math.max(max_val, src[j])
    max_val

// Replicates Python: rolling(42, min_periods=1).min() over Active Low Matrix
calculate_ll_42(float src) =>
    int current_window = math.min(bar_index + 1, 42)
    float min_val = src
    for j = 0 to current_window - 1
        min_val := math.min(min_val, src[j])
    min_val

// --- Core Calculations Driven by Selected Mode Matrix ---
sma_line  = calculate_sma_42(src_c)
tsma_line = calculate_tsma_42(src_c)

base_ma_line = (MA_TYPE == "SMA") ? sma_line : tsma_line
hh_42        = calculate_hh_42(src_h)
ll_42        = calculate_ll_42(src_l)

// --- REFERENCE LINES MATCHING PYTHON MATHEMATICS ---
pxy_st_line  = (base_ma_line + hh_42 + ll_42 + src_c) / 4.0
pxy_st_no_ll = (base_ma_line + hh_42 + src_c) / 3.0 // Upper Boundary Line
pxy_st_no_hh = (base_ma_line + ll_42 + src_c) / 3.0 // Lower Boundary Line

// --- Array Logic Routing Map (Pulled dynamically via history tracking) ---
c0 = src_c
c1 = src_c[1] // 🎯 FIXED: Restored historical offset to capture shifts

st0 = pxy_st_line
st1 = pxy_st_line[1] // 🎯 FIXED: Restored historical offset to compare lines

no_ll0 = pxy_st_no_ll
no_ll1 = pxy_st_no_ll[1] // 🎯 FIXED

no_hh0 = pxy_st_no_hh
no_hh1 = pxy_st_no_hh[1] // 🎯 FIXED

// Priority Boolean Conditions Evaluated Dynamically Per Bar
bool is_buy_signal  = false
bool is_sell_signal = false

if bar_index >= 1
    // Pure Center Line Crossovers
    cross_buy  = (c0 > st0) and (c1 <= st1)
    cross_sell = (c0 < st0) and (c1 >= st1)
    
    // Dual-Directional Boundary Crossing Logic (Catches Above & Below)
    force_buy_above  = (c0 > no_ll0) and (c1 <= no_ll1)
    force_buy_below  = (c0 < no_ll0) and (c1 >= no_ll1)
    force_buy        = force_buy_above or force_buy_below

    force_sell_below = (c0 < no_hh0) and (c1 >= no_hh1)
    force_sell_above = (c0 > no_hh0) and (c1 <= no_hh1)
    force_sell       = force_sell_below or force_sell_above
    
    // EXCLUSIVE PRIORITY MATRIX SYNCED DIRECTLY WITH SWAPPED PYTHON LOGIC
    if force_buy
        is_sell_signal := true   // Upper Boundary Line Interaction -> FORCESELL
    else if force_sell
        is_buy_signal  := true   // Lower Boundary Line Interaction -> FORCEBUY
    else if cross_buy
        is_buy_signal  := true   // CROSSBUY
    else if cross_sell
        is_sell_signal := true   // CROSSSELL

// --- Chart Element Plots ---
plot(pxy_st_line, title="PXY ST Line Center", color=color.blue, linewidth=2)
plot(pxy_st_no_ll, title="PXY ST Upper Boundary (No LL)", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(pxy_st_no_hh, title="PXY ST Lower Boundary (No HH)", color=color.purple, linewidth=1, style=plot.style_linebr)

// Sharp price-locked independent execution signals
plotshape(is_buy_signal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(is_sell_signal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
