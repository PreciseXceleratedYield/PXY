//@version=5
indicator("PXY Mode 5 Dots", overlay=true)

// --- 1. Fetch 1-Minute OHLC Data via Security Function ---
o_1m = request.security(syminfo.tickerid, "1", open)
h_1m = request.security(syminfo.tickerid, "1", high)
l_1m = request.security(syminfo.tickerid, "1", low)
c_1m = request.security(syminfo.tickerid, "1", close)

// --- 2. Mode 5 Base Components Calculation (Using 1m Data) ---
o_raw = o_1m
h_raw = h_1m
l_raw = l_1m
c_raw = c_1m

// Component B: Pure Heikin-Ashi Prices
var float ha_o = na
ha_c = (o_raw + h_raw + l_raw + c_raw) / 4.0
ha_o := na(ha_o) ? (o_raw + c_raw) / 2.0 : (ha_o + ha_c) / 2.0
ha_h = math.max(h_raw, math.max(ha_o, ha_c))
ha_l = math.min(l_raw, math.min(ha_o, ha_c))

// Component C: Open-Close Median Prices
oc2 = (o_raw + c_raw) / 2.0
oc2_o = oc2
oc2_h = oc2
oc2_l = oc2
oc2_c = oc2

// Component D: Shift Momentum Prices
c1_shift = nz(c_raw, c_raw)
c1c0_o = c1_shift
c1c0_h = c_raw
c1c0_l = c1_shift
c1c0_c = c_raw

// Combine Matrices (Mode 5 Unified Price Matrix)
m5_open  = (o_raw + ha_o + oc2_o + c1c0_o) / 4.0
m5_high  = (h_raw + ha_h + oc2_h + c1c0_h) / 4.0
m5_low   = (l_raw + ha_l + oc2_l + c1c0_l) / 4.0
m5_close = (c_raw + ha_c + oc2_c + c1c0_c) / 4.0

// --- 3. Calculate the 3 Distinct Reference Lines ---
tsma_42 = ta.linreg(m5_close, 42, 0)
hh_42   = ta.highest(m5_high, 42)
ll_42   = ta.lowest(m5_low, 42)

pxy_st_line  = (tsma_42 + hh_42 + ll_42 + m5_close ) / 4.0 // Main Reference ST Line
pxy_st_no_ll = (tsma_42 + hh_42 + m5_close) / 3.0         // Upper Line (No Low of Low)
pxy_st_no_hh = (tsma_42 + ll_42 + m5_close) / 3.0         // Lower Line (No High of High)

// --- 4. Signal and Pattern Tracking Framework ---

// A. Standard Crossovers (Main Reference ST Line)
cross_buy  = ta.crossover(m5_close, pxy_st_line)
cross_sell = ta.crossunder(m5_close, pxy_st_line)

// B. Force Threshold Boundaries (Upper and Lower Lines)
force_buy  = ta.crossover(m5_close, pxy_st_no_ll)
force_sell = ta.crossunder(m5_close, pxy_st_no_hh)

// C. Dynamic Multi-Bar Channel V-Patterns (c[1], c[2], c[3] historical windows)
in_upper_pocket = (m5_close[1] < pxy_st_no_ll[1] and m5_close[1] > pxy_st_line[1]) and 
                  (m5_close[2] < pxy_st_no_ll[2] and m5_close[2] > pxy_st_line[2]) and 
                  (m5_close[3] < pxy_st_no_ll[3] and m5_close[3] > pxy_st_line[3])

v_shape_bottom  = (m5_close[1] < m5_close[2]) and (m5_close > m5_close[1])
trend_buy       = in_upper_pocket and v_shape_bottom

in_lower_pocket = (m5_close[1] < pxy_st_line[1] and m5_close[1] > pxy_st_no_hh[1]) and 
                  (m5_close[2] < pxy_st_line[2] and m5_close[2] > pxy_st_no_hh[2]) and 
                  (m5_close[3] < pxy_st_line[3] and m5_close[3] > pxy_st_no_hh[3])

v_shape_top     = (m5_close[1] > m5_close[2]) and (m5_close < m5_close[1])
trend_sell      = in_lower_pocket and v_shape_top

// --- 5. Independent Dot Color & Plot Logic ---
dot_color = (m5_close > m5_open) ? color.green : color.red

// Plotting elements with shortened titles
plot(m5_close, title="M5 Dots", color=dot_color, style=plot.style_circles, linewidth=3)
plot(pxy_st_no_ll, title="Upper Boundary", color=color.teal, linewidth=1)
plot(pxy_st_line, title="Main Ref", color=color.orange, linewidth=2)
plot(pxy_st_no_hh, title="Lower Boundary", color=color.purple, linewidth=1)

// --- 6. UI Text Signal Overlays (Shortened Label Text) ---
// Standard Crossovers
plotchar(cross_buy, title="CBUY", char="", text="CBUY", location=location.belowbar, textcolor=color.green, size=size.small)
plotchar(cross_sell, title="CSELL", char="", text="CSELL", location=location.abovebar, textcolor=color.red, size=size.small)

// Force Boundary Breakouts
plotchar(force_buy, title="FBUY", char="", text="FBUY", location=location.belowbar, textcolor=color.green, size=size.small)
plotchar(force_sell, title="FSELL", char="", text="FSELL", location=location.abovebar, textcolor=color.red, size=size.small)

// Channel Patterns
plotchar(trend_buy, title="TBUY", char="", text="TBUY", location=location.belowbar, textcolor=color.lime, size=size.small)
plotchar(trend_sell, title="TSELL", char="", text="TSELL", location=location.abovebar, textcolor=color.maroon, size=size.small)


