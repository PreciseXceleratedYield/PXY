//@version=6 
indicator("PXY® Pure OC/2 Chart - Pure Python SMA 42 Master", overlay=true, max_bars_back=500) 

// =============================================================================== 
// 1. PURE OC/2 PRICE CALCULATIONS 
// =============================================================================== 
c0 = (open + close) / 2.0 
c1 = c0[1] // Samples prior bar's value to maintain correct candle body height 

// =============================================================================== 
// 2. PURE OC/2 VISUAL CHART LAYOUT 
// =============================================================================== 
candle_color = (c0 >= c1) ? color.teal : color.maroon 
plotcandle(open=c1, high=math.max(c0, c1), low=math.min(c0, c1), close=c0, title="PXY Pure OC/2 Custom Candles", color=color.new(candle_color, 20), wickcolor=candle_color, bordercolor=candle_color) 

// =============================================================================== 
// 3. THE 1:1 PURE SMA BASELINE (WITH LIVE INFLUENCE FILTER) 
// =============================================================================== 
sma_window = 42 
// Calculated as the raw moving average of your custom c0 prices 
sma_raw = ta.sma(c0, sma_window) 
// Live price influence smoothing step 
ST = (sma_raw + c0) / 2.0 
// Plot the clean, live-influenced 42 SMA on your chart in orange 
plot(ST, title="PXY ST Line (Pure SMA 42)", color=color.orange, linewidth=2) 

// =============================================================================== 
// 4. SIGNAL LAYER 1: TREND LINE FLIPS (TRIGGERS ONLY ON THE CROSSOVER BAR) 
// =============================================================================== 
// TB (Trend BUY): Triggers STRICTLY on the first crossover bar moving above the line 
trigger_tb = ta.crossover(c0, ST) 
// TS (Trend SELL): Triggers STRICTLY on the first crossunder bar moving below the line 
trigger_ts = ta.crossunder(c0, ST) 

// =============================================================================== 
// 5. SIGNAL LAYER 2: MOMENTUM FLIPS (TRIGGERS STRICTLY ON THE COLOR TRANSITION BAR) 
// =============================================================================== 
// Direct array lookbacks ensure transition triggers fire ONLY on the color flip bar 
color_change_to_green = (c0 > c0[1]) and (c0[1] < c0[2]) 
color_change_to_red = (c0 < c0[1]) and (c0[1] > c0[2]) 

// Route Action signals only on the precise bar where the price direction flips while holding its trend position 
// CB (Action BUY): Price flips Red -> Green while holding above the line (excluding the TB crossover bar) 
trigger_cb = color_change_to_green and (c0 > ST) and not trigger_tb 
// CS (Action SELL): Price flips Green -> Red while holding below the line (excluding the TS crossunder bar) 
trigger_cs = color_change_to_red and (c0 < ST) and not trigger_ts 

// =============================================================================== 
// 6. VISUAL SIGNAL PLOTTING PIPELINE - ANCHOR ALIGNMENT FIXED 
// =============================================================================== 
// LAYER 1: Line Crossing Flips (TB / TS mapped to Square Shapes) 
plotchar(trigger_tb, title="TB Cross", char="🟩", location=location.belowbar, size=size.tiny) 
plotchar(trigger_ts, title="TS Cross", char="🟥", location=location.abovebar, size=size.tiny) 

// LAYER 2: Internal Price Momentum Flips (CB / CS mapped to Circle Shapes) 
plotchar(trigger_cb, title="CB Trend", char="🟢", location=location.belowbar, size=size.tiny) 
plotchar(trigger_cs, title="CS Trend", char="🔴", location=location.abovebar, size=size.tiny)

