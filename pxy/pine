//@version=6
indicator("PXY® - TSMA + Anchored Black Line", overlay=true)

// ==========================================
// 1. BLACK LINE LOGIC (SuperTrend)
// ==========================================
is_new_day = ta.change(time("D")) != 0
var float anchor = na
var int bar_cnt = 0
var float session_sum = 0.0

// Reset bar count and set anchor at 09:15
if is_new_day
    bar_cnt := 1
    session_sum := close
    anchor := close > open ? high : low
else
    bar_cnt += 1
    session_sum += close

// Calculate Hybrid Components
session_mean = session_sum / bar_cnt
sma_50 = ta.sma(close, 50)
python_hybrid = (session_mean + sma_50) / 2

// Blend Factor (Bar 15 to 45)
blend = math.max(0, math.min(1, (bar_cnt - 15) / 30.0))

// The Black Line (ST)
float black_line = na
if bar_cnt <= 15
    black_line := anchor
else if bar_cnt <= 45
    black_line := (anchor * (1 - blend)) + (python_hybrid * blend)
else
    black_line := python_hybrid

plot(black_line, "Black Line (ST)", color=color.black, linewidth=2)

// ==========================================
// 2. TSMA LOGIC (7-Period)
// ==========================================
tsma_price = ta.linreg(close, 10, 0)
plot(tsma_price, "7-TSMA", color=color.gray, linewidth=2)

// ==========================================
// 3. SIGNALS & COLORS
// ==========================================
isBuy  = ta.crossover(close, tsma_price)
isSell = ta.crossunder(close, tsma_price)
isBull = close > tsma_price
isBear = close < tsma_price

// Shapes for B/S
plotshape(isBuy, "B", shape.labelup, location.belowbar, color.green, text="B", textcolor=color.white, size=size.small)
plotshape(isSell, "S", shape.labeldown, location.abovebar, color.maroon, text="S", textcolor=color.white, size=size.small)

// Bar Coloring
barcolor(isBuy ? color.green : isSell ? color.maroon : isBull ? color.new(color.green, 50) : isBear ? color.new(color.maroon, 50) : na)





