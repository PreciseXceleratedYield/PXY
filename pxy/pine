//@version=6
indicator("PXY® Engine", overlay=true, shorttitle="PXY® Engine")

// ==========================================
// 1. CONFIGURATION INTERFACE & SESSION LOGIC
// ==========================================
ma_type   = input.string("SMA", title="42 MA Engine Type", options=["SMA", "TSMA (Linear Regression)"])
sess_spec = input.string("0915-1530:23456", title="Active Trading Session")

// Trace exact minutes elapsed since market open to handle the 50-minute backfill window
in_session = not na(time(timeframe.period, sess_spec))
var int bar_count_since_open = 0
if in_session and not in_session[1]
    bar_count_since_open := 1
else if in_session
    bar_count_since_open += 1
else
    bar_count_since_open := 0

// ==========================================
// 1B. PYTHON-REPLICA BACKFILL PATCH
// ==========================================
// This patch completely stops yesterday's data from polluting today's open.
// It forces Pine Script to assume the first bar was duplicated into the past.
float custom_open  = open
float custom_close = close

if in_session and bar_count_since_open <= 50
    custom_open  := ta.valuewhen(bar_count_since_open == 1, open, 0)
    custom_close := ta.valuewhen(bar_count_since_open == 1, close, 0)

// ==========================================
// 2. TIER 1 - MODE 6 CANDLE PROCESSING 
// ==========================================
// Changed ONLY the input series to use the patched backfill variables
sma_o = ta.sma(custom_open, 3)
sma_c = ta.sma(custom_close, 3)

var float ha_o = na
ha_c = (sma_o + sma_c) / 2.0
ha_o := na(ha_o) ? (sma_o + sma_c) / 2.0 : (ha_o + ha_c) / 2.0

ha_h = math.max(ha_o, ha_c)
ha_l = math.min(ha_o, ha_c)

m6_bullish = ha_c >= ha_o
m6_color   = m6_bullish ? color.lime : color.red
plotcandle(ha_o, ha_h, ha_l, ha_c, title="Mode 6 Core Blocks", color=m6_color, bordercolor=m6_color, wickcolor=color.new(color.white, 100))

// ==========================================
// 3. AUTOMATED LAYER 2 SIMULATION (sysmktpxy)
// ==========================================
m6_bull_prev = ta.valuewhen(true, m6_bullish, 1)

// Generate Dynamic Market Entry Signals
string entry_signal = "NONE"
if m6_bullish and not m6_bull_prev
    entry_signal := "BUY"
else if not m6_bullish and m6_bull_prev
    entry_signal := "SELL"
else
    entry_signal := m6_bullish ? "BULL" : "BEAR"

// Generate Independent Market Exit Signals (Noise Filters)
string exit_signal = "NONE"
if not m6_bullish and m6_bull_prev
    exit_signal := "BUY"   // Exit Long trades if trend flips red
else if m6_bullish and not m6_bull_prev
    exit_signal := "SELL"  // Exit Short trades if trend flips green

// ==========================================
// 4. TIER 2 - DERIVED TRENDLINE BOUNDARY (42 MA)
// ==========================================
var float st_line = na
if ma_type == "SMA"
    st_line := ta.sma(ha_c, 30)
else
    st_line := ta.linreg(ha_c, 30, 0)

c0      = ha_c
st_curr = st_line
c1      = ta.valuewhen(true, ha_c, 1)
st_prev = ta.valuewhen(true, st_line, 1)

cross_above = (c0 > st_curr) and (c1 <= st_prev)
cross_below = (c0 < st_curr) and (c1 >= st_prev)

// Resolve structural st_trend states
var string st_trend = "SIDE"
if cross_above
    st_trend := "BUY"
else if cross_below
    st_trend := "SELL"
else if c0 > st_curr
    st_trend := "BULL"
else
    st_trend := "BEAR"

// ==========================================
// 5. TIER 3 - CORE ROUTER ENGINE (sysentrpxy)
// ==========================================
var string final_signal = "NONE"

if st_trend == "BUY"
    final_signal := "BUY"
else if st_trend == "SELL"
    final_signal := "SELL"
else if entry_signal == "BULL" or entry_signal == "BEAR"
    final_signal := entry_signal
else if st_trend == "BULL"
    final_signal := (entry_signal == "SELL") ? "NONE" : entry_signal
else if st_trend == "BEAR"
    final_signal := (entry_signal == "BUY") ? "NONE" : entry_signal
else
    final_signal := "NONE"

// Convert confirmed routes to execution variables
is_atmbuy  = (final_signal == "BUY")
is_atmsell = (final_signal == "SELL")

// Extract independent exit execution triggers
is_exit_long  = (exit_signal == "BUY")
is_exit_short = (exit_signal == "SELL")

// ==========================================
// 6. VISUAL RENDERING ENGINE & ALERTS
// ==========================================
trend_color = (st_trend == "BUY" or st_trend == "BULL") ? color.lime : (st_trend == "SELL" or st_trend == "BEAR") ? color.red : color.gray
plot(st_line, title="42 MA Structural Line", color=trend_color, linewidth=3)

// A. ENTRY SIGNALS: Plotted cleanly as Triangles
plotshape(is_atmbuy,  title="ATMBUY Action Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(is_atmsell, title="ATMSELL Action Entry", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)

// B. EXIT SIGNALS: Plotted unconditionally as Circles/Dots
plotshape(is_exit_long,  title="Exit Long Dot",  style=shape.circle, location=location.abovebar, color=color.new(color.orange, 20), size=size.tiny)
plotshape(is_exit_short, title="Exit Short Dot", style=shape.circle, location=location.belowbar, color=color.new(color.orange, 20), size=size.tiny)

// Webhook payload routing connectors
alertcondition(is_atmbuy,     title="Entry ATMBUY Alert", message="Order Engine: [ATMBUY]")
alertcondition(is_atmsell,    title="Entry ATMSELL Alert", message="Order Engine: [ATMSELL]")
alertcondition(is_exit_long,  title="Exit Long Alert",     message="Order Engine: [EXIT_LONG]")
alertcondition(is_exit_short, title="Exit Short Alert",    message="Order Engine: [EXIT_SHORT]")


