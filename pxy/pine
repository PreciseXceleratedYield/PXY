//@version=5
indicator("PXY", overlay=true)

// ==========================================
// 1. SESSION WHITE LINE LOGIC
// ==========================================
isNewDay = ta.change(time("D")) != 0
var int barsToday = 0
barsToday := isNewDay ? 1 : barsToday + 1

// Session VWAP
sessionVWAP = ta.vwap(hlc3, isNewDay)

// Dynamic 50 SMA (Grows from 1 to 50)
dynamicLength = math.min(barsToday, 50)
sessionSMA = ta.sma(close, dynamicLength)

// White Line (The Average)
avgLine = (sessionVWAP + sessionSMA) / 2

// ==========================================
// 2. P-MASTER LINE & DOT LOGIC
// ==========================================
float e1 = close
float e2 = (close + nz(close[1], close)) / 2
float e3 = (close + open) / 2
float e4 = ohlc4
float p_price = math.round((e1 + e2 + e3 + e4) / 4, 4)

// P-Dot Color: Green if P-Price is rising, Red if falling
color pDotColor = p_price > nz(p_price[1], p_price) ? #00FF00 : p_price < nz(p_price[1], p_price) ? #FF0000 : color.gray

// ==========================================
// 3. PLOTTING
// ==========================================

// --- White Line Group ---
// Main White Line (Thick)
plot(barsToday > 1 ? avgLine : na, color=color.white, linewidth=2, title="White Line (VWAP-SMA Avg)")

// Individual Components (Transparent/Thin for reference)
plot(barsToday > 1 ? sessionVWAP : na, color=color.new(#9C27B0, 60), linewidth=1, title="Ref VWAP")
plot(barsToday > 1 ? sessionSMA : na, color=color.new(#FF9800, 60), linewidth=1, title="Ref 50 SMA")

// --- P-Master Group ---
// P-Line (Thin Black)
plot(p_price, title="P-Master Line", color=color.new(color.black, 40), linewidth=1)

// P-Dots (Thick Colored)
plot(p_price, title="P-Dots", color=pDotColor, style=plot.style_circles, linewidth=3)

// Visual Session Break
bgcolor(isNewDay ? color.new(color.white, 90) : na)


