//@version=5
indicator("Supertrend 10:3 & Trend Following Flips", overlay=true, precision=2)

// --- INPUTS ---
atrPeriod = input.int(10, title="ATR Length")
atrMult   = input.float(3.0, title="ATR Multiplier")

// --- NATIVE ATR GENERATION & BAND MATRICES ---
atrValue = ta.atr(atrPeriod)
float upBand = hl2 - (atrMult * atrValue)
float dnBand = hl2 + (atrMult * atrValue)

// --- MEMORY HOLDERS ---
var float lowerBand = 0.0
var float upperBand = 0.0
var int trendDirection = 1

// --- STRUCTURAL SUPERTREND LINE LOCKS ---
lowerBand := (close[1] > lowerBand[1]) ? math.max(upBand, lowerBand[1]) : upBand
upperBand := (close[1] < upperBand[1]) ? math.min(dnBand, upperBand[1]) : dnBand

// --- REGIME SHIFT GATES ---
if close > upperBand[1]
    trendDirection := 1
else if close < lowerBand[1]
    trendDirection := -1

float superTrendPlot = trendDirection == 1 ? lowerBand : upperBand

// --- VISUAL RENDERING ---
color trendColor = trendDirection == 1 ? color.green : color.red
plot(superTrendPlot, title="Supertrend Line", color=trendColor, linewidth=2)

// --- SIGNAL STATE TRACKING ---
// 1. Major Trend Crossover Switches
bool crossBuy  = (trendDirection == 1) and (trendDirection[1] == -1)
bool crossSell = (trendDirection == -1) and (trendDirection[1] == 1)

// 2. Trend Following Continuation Flips (Trigger-Only on candle body flip)
bool isGreenCandle = close > open
bool isRedCandle   = close < open

// RUN_UP: Master trend is already green, and the candle body just flipped from Red to Green
bool runUp = (trendDirection == 1) and isGreenCandle and (close[1] <= open[1])
// RUN_DN: Master trend is already red, and the candle body just flipped from Green to Red
bool runDn = (trendDirection == -1) and isRedCandle and (close[1] >= open[1])

// --- SHAPE ALERTS CONFIGURATION ---
// Major Trend Changes (Large triangles with labels)
plotshape(crossBuy,  title="CROSSBUY Switch",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal, text="CROSS BUY", textcolor=color.green)
plotshape(crossSell, title="CROSSSELL Switch", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.normal, text="CROSS SELL", textcolor=color.red)

// Running Continuation Signals (Small micro arrows directly inside bars)
plotshape(runUp and not crossBuy,   title="RUNNING UP Flip",   style=shape.triangleup,   location=location.belowbar, color=color.teal, size=size.small)
plotshape(runDn and not crossSell,  title="RUNNING DOWN Flip", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small)

// --- SYSTEM WEBHOOK CONFIGURATIONS ---
alertcondition(crossBuy,  title="Alert: Cross Buy Switch",  message="CROSSBUY")
alertcondition(crossSell, title="Alert: Cross Sell Switch", message="CROSSSELL")
alertcondition(runUp,     title="Alert: Running Up Flip",    message="RUN_UP")
alertcondition(runDn,     title="Alert: Running Down Flip",  message="RUN_DN")
