//@version=5
indicator("PXY Engine - Synced (OC/2 Input Data)", overlay=true)

// Global Config
MA_TYPE = input.string("TSMA", title="MA Type", options=["SMA", "TSMA"])
show_custom_candles = input.bool(true, title="Show (O+C)/2 Candlesticks")

// --- Python Mirror Source Configuration ---
// Since your Python df['Close'] contains processed (O+C)/2, 
// we map our core source directly to this calculation.
oc2 = (open + close) / 2.0

// --- Custom Candlestick Components (Visual Representation) ---
oc2_open  = oc2[1]
oc2_close = oc2
oc2_high  = math.max(high, math.max(oc2_open, oc2_close))
oc2_low   = math.min(low, math.min(oc2_open, oc2_close))
candle_color = oc2_close >= oc2_open ? color.green : color.red

// Plot Custom Candles (Overlaying the chart)
plotcandle(oc2_open, oc2_high, oc2_low, oc2_close, title="(O+C)/2 Candles", 
           color=show_custom_candles ? candle_color : color.new(color.white, 100), 
           wickcolor=show_custom_candles ? candle_color : color.new(color.white, 100), 
           bordercolor=show_custom_candles ? candle_color : color.new(color.white, 100))

// --- Custom Functions (NumPy Loop Replications using oc2) ---

// Replicates Python: calculate_sma_42
calculate_sma_42(float src) =>
    int i = bar_index
    int current_window = math.min(i + 1, 42)
    float sum = 0.0
    for j = 0 to current_window - 1
        sum := sum + src[j]
    sum / current_window

// Replicates Python: calculate_tsma_42
calculate_tsma_42(float src) =>
    int i = bar_index
    float tsma_output = src
    if i > 0
        int current_window = math.min(i + 1, 42)
        
        // Calculate Means
        float x_sum = 0.0
        float y_sum = 0.0
        for j = 0 to current_window - 1
            x_sum := x_sum + j
            y_sum := y_sum + src[j]
        
        float x_mean = x_sum / current_window
        float y_mean = y_sum / current_window
        
        float num = 0.0
        float denom = 0.0
        for j = 0 to current_window - 1
            // Inverts historical offset 'j' to align with Python's forward x step sequence [0, 1, 2...]
            float x_val = (current_window - 1) - j 
            float x_diff = x_val - x_mean
            num := num + (x_diff * (src[j] - y_mean))
            denom := denom + math.pow(x_diff, 2)
            
        if denom == 0
            tsma_output := src
        else
            float slope = num / denom
            float intercept = y_mean - slope * x_mean
            tsma_output := slope * (current_window - 1) + intercept
    tsma_output

// Replicates Python: rolling(42, min_periods=1).max()
calculate_hh_42() =>
    int current_window = math.min(bar_index + 1, 42)
    float max_val = high
    for j = 0 to current_window - 1
        max_val := math.max(max_val, high[j])
    max_val

// Replicates Python: rolling(42, min_periods=1).min()
calculate_ll_42() =>
    int current_window = math.min(bar_index + 1, 42)
    float min_val = low
    for j = 0 to current_window - 1
        min_val := math.min(min_val, low[j])
    min_val

// --- Core Calculations Driven by Processed Data ---
sma_line  = calculate_sma_42(oc2)
tsma_line = calculate_tsma_42(oc2)

base_ma_line = (MA_TYPE == "SMA") ? sma_line : tsma_line
hh_42        = calculate_hh_42()
ll_42        = calculate_ll_42()

// --- REFERENCE LINES MATCHING PYTHON MATHEMATICS ---
// These now use 'oc2' where Python uses df['Close']
pxy_st_line  = (base_ma_line + hh_42 + ll_42 + oc2) / 4.0
pxy_st_no_ll = (base_ma_line + hh_42 + oc2) / 3.0 // Upper Boundary Line
pxy_st_no_hh = (base_ma_line + ll_42 + oc2) / 3.0 // Lower Boundary Line

// --- Array Logic Routing Map Sticking Directly to Historical Price Steps ---
c0 = oc2
c1 = oc2[1] // Current and previous state tracking for crossover calculation

st0 = pxy_st_line
st1 = pxy_st_line[1]

no_ll0 = pxy_st_no_ll
no_ll1 = pxy_st_no_ll[1]

no_hh0 = pxy_st_no_hh
no_hh1 = pxy_st_no_hh[1]

// Priority Boolean Conditions Evaluated Dynamically Per Bar
bool is_buy_signal  = false
bool is_sell_signal = false

if bar_index >= 1
    // Pure Center Line Crossovers
    cross_buy  = (c0 > st0) and (c1 <= st1)
    cross_sell = (c0 < st0) and (c1 >= st1)
    
    // Dual-Directional Boundary Crossing Logic (Catches Above & Below)
    force_buy_above  = (c0 > no_ll0) and (c1 <= no_ll1)
    force_buy_below  = (c0 < no_ll0) and (c1 >= no_ll1)
    force_buy        = force_buy_above or force_buy_below

    force_sell_below = (c0 < no_hh0) and (c1 >= no_hh1)
    force_sell_above = (c0 > no_hh0) and (c1 <= no_hh1)
    force_sell       = force_sell_below or force_sell_above
    
    // EXCLUSIVE PRIORITY MATRIX SYNCED DIRECTLY WITH SWAPPED PYTHON LOGIC
    if force_buy
        is_sell_signal := true   // Upper Boundary Line Interaction -> FORCESELL
    else if force_sell
        is_buy_signal  := true   // Lower Boundary Line Interaction -> FORCEBUY
    else if cross_buy
        is_buy_signal  := true   // CROSSBUY
    else if cross_sell
        is_sell_signal := true   // CROSSSELL

// --- Chart Element Plots ---
plot(pxy_st_line, title="PXY ST Line Center", color=color.blue, linewidth=2)
plot(pxy_st_no_ll, title="PXY ST Upper Boundary (No LL)", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(pxy_st_no_hh, title="PXY ST Lower Boundary (No HH)", color=color.purple, linewidth=1, style=plot.style_linebr)

// Sharp price-locked independent execution signals
plotshape(is_buy_signal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(is_sell_signal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

