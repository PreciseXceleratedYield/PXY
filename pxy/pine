//@version=5
indicator("PXY Engine - Mode 5 Intraday Session Reset", overlay=true)

// --- Global Configuration ---
MA_TYPE = input.string("TSMA", title="MA Type", options=["SMA", "TSMA"])

// --- Detect New Trading Day Session Start ---
bool is_new_day = ta.change(time("D")) != 0

// --- Isolated Mode 5 Matrix Generator (Composite Blend) ---
var float ha_o = na
float ha_c = (open + high + low + close) / 4.0

// Heikin-Ashi calculation resets daily to prevent yesterday's close from bleeding in
if is_new_day
    ha_o := (open + close) / 2.0
else
    ha_o := na(ha_o) ? (open + close) / 2.0 : (ha_o + ha_c) / 2.0

float ha_h = math.max(high, math.max(ha_o, ha_c))
float ha_l = math.min(low, math.min(ha_o, ha_c))

// Math Engine Transformation Variables
float oc2    = (open + close) / 2.0
float raw_c1 = na(close[1]) ? close : close[1]

// Pure Mode 5 Core Source Matrix Assignments
float src_o = (open + ha_o + oc2 + raw_c1) / 4.0
float src_h = (high + ha_h + oc2 + close) / 4.0
float src_l = (low + ha_l + oc2 + raw_c1) / 4.0
float src_c = (close + ha_c + oc2 + close) / 4.0

// Plot Transformed Mode 5 Custom Candlesticks
candle_color = src_c >= src_o ? color.green : color.red
plotcandle(src_o, src_h, src_l, src_c, title="Mode 5 Transformed Candles", color=candle_color, wickcolor=candle_color, bordercolor=candle_color)

// --- Dynamic Intraday Session Math Foundations ---

// Persistent running counts and sums that clear to zero on a new day
var int bar_count_session = 0
var float sum_y           = 0.0
var float sum_x           = 0.0
var float sum_xx          = 0.0
var float sum_xy          = 0.0

// Absolute Session High & Low trackers that clear every morning
var float hh_session      = na
var float ll_session      = na

if is_new_day
    bar_count_session := 1
    sum_y             := src_c
    sum_x             := 0.0
    sum_xx            := 0.0
    sum_xy            := 0.0
    hh_session        := src_h
    ll_session        := src_l
else
    bar_count_session := bar_count_session + 1
    // Relative index step inside today's session boundary
    float idx          = bar_count_session - 1
    sum_y             := sum_y + src_c
    sum_x             := sum_x + idx
    sum_xx            := sum_xx + math.pow(idx, 2)
    sum_xy            := sum_xy + (idx * src_c)
    hh_session        := math.max(hh_session, src_h)
    ll_session        := math.min(ll_session, src_l)

// 1. Resetting SMA Calculation
float sma_line = sum_y / bar_count_session

// 2. Resetting TSMA Calculation
float tsma_line = src_c
if bar_count_session > 1
    float num   = (bar_count_session * sum_xy) - (sum_x * sum_y)
    float denom = (bar_count_session * sum_xx) - math.pow(sum_x, 2)
    
    if denom != 0
        float slope = num / denom
        float current_idx = bar_count_session - 1
        float intercept = (sum_y - (slope * sum_x)) / bar_count_session
        tsma_line := (slope * current_idx) + intercept

// --- Core Structural Signal Line Formations ---
base_ma_line = (MA_TYPE == "SMA") ? sma_line : tsma_line

// Reference Structural Boundary Line Formations over active session data
pxy_st_line  = (base_ma_line + hh_session + ll_session + src_c) / 4.0
pxy_st_no_ll = (base_ma_line + hh_session + src_c) / 3.0 // Upper Boundary Line
pxy_st_no_hh = (base_ma_line + ll_session + src_c) / 3.0 // Lower Boundary Line

// Multi-Bar State Array Assignments
c0 = src_c
c1 = src_c[1]

st0 = pxy_st_line
st1 = pxy_st_line[1]

no_ll0 = pxy_st_no_ll
no_ll1 = pxy_st_no_ll[1]

no_hh0 = pxy_st_no_hh
no_hh1 = pxy_st_no_hh[1]

// Execution Flag Definitions
bool is_buy_signal  = false
bool is_sell_signal = false

// Only evaluate patterns if we have at least 2 bars printed today to prevent yesterday carryover
if bar_count_session >= 2
    // Condition Intersections
    cross_buy  = (c0 > st0) and (c1 <= st1)
    cross_sell = (c0 < st0) and (c1 >= st1)
    
    force_buy  = (c0 > no_ll0) and (c1 <= no_ll1)
    force_sell = (c0 < no_hh0) and (c1 >= no_hh1)
    
    // Priority Signal Sorting Matrix Evaluation
    if force_buy
        is_sell_signal := true   // Upper Boundary Overwrite -> FORCESELL
    else if force_sell
        is_buy_signal  := true   // Lower Boundary Overwrite -> FORCEBUY
    else if cross_buy
        is_buy_signal  := true   // Center Crossover BUY
    else if cross_sell
        is_sell_signal := true   // Center Crossover SELL

// --- Visual Overlay Rendering Elements ---
plot(pxy_st_line, title="PXY ST Line Center", color=color.blue, linewidth=2)
plot(pxy_st_no_ll, title="PXY ST Upper Boundary", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(pxy_st_no_hh, title="PXY ST Lower Boundary", color=color.purple, linewidth=1, style=plot.style_linebr)

plotshape(is_buy_signal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(is_sell_signal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

