//@version=5
indicator("PXY® Mode 5 Pure TSMA 42 Price Midpoint Engine (100% Synced)", overlay=true, max_bars_back=500)

// ==========================================
// 1. DATA PROCESSING - COMPOSITE MODE 5 MATRIX
// ==========================================
var float ha_o = na
ha_c = (open + high + low + close) / 4.0
ha_o := na(ha_o) ? (open + close) / 2.0 : (ha_o + ha_c) / 2.0
ha_h = math.max(high, math.max(ha_o, ha_c))
ha_l = math.min(low, math.min(ha_o, ha_c))
oc2 = (open + close) / 2.0
c1_raw = nz(close, close)

// Pure Mode 5 Candle Array Overrides
o = (open + ha_o + oc2 + c1_raw) / 4.0
h = (high + ha_h + oc2 + close) / 4.0
l = (low + ha_l + oc2 + c1_raw) / 4.0
c = (close + ha_c + oc2 + close) / 4.0

// Determine Mode 5 Candle Color States
is_green_c0 = c > o
is_red_c0 = c < o

// Fetch previous candle states strictly using historical lookback bracket
is_green_c1 = is_green_c0[1]
is_red_c1 = is_red_c0[1]

// Plot the clean Mode 5 candles directly on your chart canvas
plotcandle(o, h, l, c, title="Mode 5 Candles", color = is_green_c0 ? color.new(color.teal, 30) : color.new(color.maroon, 30), wickcolor = is_green_c0 ? color.teal : color.maroon, bordercolor = is_green_c0 ? color.teal : color.maroon)

// ==========================================
// 2. INTERNAL ROW ENGINE LOOKUP
// ==========================================
is_new_day = ta.change(time("D")) != 0
var int bar_count = 0
bar_count := is_new_day ? 1 : bar_count + 1

// ==========================================
// 3. PURE TSMA 42 PRICE MIDPOINT TRACKER
// ==========================================
tsma_window = math.min(bar_count, 42)
tsma_line = ta.linreg(c, tsma_window, 0)
ST = (tsma_line + c) / 2.0
plot(ST, title="TSMA 42 Price Midpoint", color=color.black, linewidth=3, style=plot.style_line)

// ==========================================
// 3b. PURE BOS ENGINE (PURE 42 SMA - NO WEIGHTS)
// ==========================================
sma_window = math.min(bar_count, 42)
bos_line = ta.sma(c, sma_window)
plot(bos_line, title="BOS Line (Pure SMA)", color=color.blue, linewidth=2, style=plot.style_line)

// ==========================================
// 4. STEP 1: CALCULATE RAW INDEPENDENT EXITS
// ==========================================
pure_color_buy = is_red_c1 and is_green_c0        // Rule 6: Red -> Green (BUY Reversal)
pure_color_bull = is_green_c1 and is_green_c0      // Rule 7: Green -> Green (BULL Continuation)
pure_color_sell = is_green_c1 and is_red_c0        // Rule 8: Green -> Red (SELL Reversal)
pure_color_bear = is_red_c1 and is_red_c0         // Rule 9: Red -> Red (BEAR Continuation)

// ==========================================
// 5. STEP 2: APPLY STRUCTURAL ENTRY FILTERS
// ==========================================
above_black = c > ST
below_black = c < ST

// Check for exact cross intersections matching Python 1:1
cross_up_black = ta.crossover(c, ST)
cross_dn_black = ta.crossunder(c, ST)

// Evaluate priorities cascade exactly matching your python conditional block string
string entry = "NONE"

// Bullish Entry Rules Cascade Filter
if cross_up_black
    entry := "CROSSBUY"
else if pure_color_buy and above_black
    entry := "TRENDBUY"
else if pure_color_buy and below_black            // <--- MATCHES PYTHON FLIPBUY
    entry := "FLIPBUY"
else if pure_color_bull and above_black
    entry := "BULL"

// Bearish Entry Rules Cascade Filter (Decoupled 'if' block ensures 1:1 sync with Python layout)
if cross_dn_black
    entry := "CROSSSELL"
else if pure_color_sell and below_black
    entry := "TRENDSELL"
else if pure_color_sell and above_black           // <--- MATCHES PYTHON FLIPSELL
    entry := "FLIPSELL"
else if pure_color_bear and below_black
    entry := "BEAR"

// ==========================================
// 6. MAP TRIGGERS & SHAPE PLOTS
// ==========================================
// Trigger tracking parameters (Triggers shapes cleanly on changes using lookback historical bracket [1])
trigger_crossbuy = (entry == "CROSSBUY") and (entry[1] != "CROSSBUY")
trigger_trendbuy = (entry == "TRENDBUY") and (entry[1] != "TRENDBUY")
trigger_flipbuy = (entry == "FLIPBUY") and (entry[1] != "FLIPBUY")   // New FLIPBUY trigger tracker

trigger_crosssell = (entry == "CROSSSELL") and (entry[1] != "CROSSSELL")
trigger_trendsell = (entry == "TRENDSELL") and (entry[1] != "TRENDSELL")
trigger_flipsell = (entry == "FLIPSELL") and (entry[1] != "FLIPSELL") // New FLIPSELL trigger tracker

// Unified structural mapping outputs with distinct geometric rules
plotshape(trigger_crossbuy, title="CROSSBUY Trigger", style=shape.arrowup, location=location.belowbar, color=color.green, size=size.normal)
plotshape(trigger_trendbuy, title="TRENDBUY Trigger", style=shape.circle, location=location.belowbar, color=color.lime, size=size.small)
plotshape(trigger_flipbuy, title="FLIPBUY Trigger", style=shape.diamond, location=location.belowbar, color=color.blue, size=size.small)

plotshape(trigger_crosssell, title="CROSSSELL Trigger", style=shape.arrowdown, location=location.abovebar, color=color.red, size=size.normal)
plotshape(trigger_trendsell, title="TRENDSELL Trigger", style=shape.circle, location=location.abovebar, color=color.orange, size=size.small)
plotshape(trigger_flipsell, title="FLIPSELL Trigger", style=shape.diamond, location=location.abovebar, color=color.purple, size=size.small)



