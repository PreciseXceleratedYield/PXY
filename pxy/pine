//@version=6
indicator("PXY SuperTrend ATR:ATR + P-Line Final", overlay=true)

// ==========================================
// 1. SUPERTREND ATR:ATR LOGIC
// ==========================================
float baseATR = ta.atr(14)
float dynamicFactor = baseATR 
float src = hl2

var float upBand = na
var float dnBand = na
var int trend = 1

float basicUpper = src + (dynamicFactor * baseATR)
float basicLower = src - (dynamicFactor * baseATR)

// Added nz() to the comparison to ensure bands don't stay 'na'
upBand := na(upBand[1]) ? basicUpper : (basicUpper < upBand[1] or close[1] > upBand[1]) ? basicUpper : upBand[1]
dnBand := na(dnBand[1]) ? basicLower : (basicLower > dnBand[1] or close[1] < dnBand[1]) ? basicLower : dnBand[1]

if close > nz(upBand[1], basicUpper)
    trend := 1
else if close < nz(dnBand[1], basicLower)
    trend := -1

float stLine = trend == 1 ? dnBand : upBand
color stLineColor = trend == 1 ? color.green : color.red

// Plotting SuperTrend
plot(stLine, title="SuperTrend Line", color=stLineColor, linewidth=2, force_overlay=true)

// ==========================================
// 2. P-MASTER LINE & DOT LOGIC
// ==========================================
float e1 = close
float e2 = (close + nz(close[1], close)) / 2
float e3 = (close + open) / 2
float e4 = ohlc4
float p_price = math.round((e1 + e2 + e3 + e4) / 4, 4)

color pDotColor = p_price > nz(p_price[1], p_price) ? color.green : p_price < nz(p_price[1], p_price) ? color.red : color.gray

// Plot P-Line and Dots
plot(p_price, title="P-Master Line", color=color.black, linewidth=1, force_overlay=true)
plot(p_price, title="P-Dots", color=pDotColor, style=plot.style_circles, linewidth=3, force_overlay=true)

// ==========================================
// 3. FILLING & SIGNALS
// ==========================================
fill(plot(stLine, display=display.none), plot(close, display=display.none), color=trend == 1 ? color.new(color.green, 90) : color.new(color.red, 90))

plotshape(trend == 1 and trend[1] == -1, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(trend == -1 and trend[1] == 1, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

