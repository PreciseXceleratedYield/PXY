#!/usr/bin/env bash
# PXY installer: safe first-time setup and repeatable maintenance.
# Does not stop or restart active trading processes.
set -Eeuo pipefail
ROOT="$HOME/PXY"
APP="$ROOT/pxy"
VENV="$HOME/env"
BIN="$HOME/.local/bin"
log() { printf '[PXY] %s\n' "$*"; }
fail() { printf '[PXY] ERROR: %s\n' "$*" >&2; exit 1; }
trap 'fail "Installation failed at line $LINENO"' ERR

[[ "$EUID" -ne 0 ]] || fail "Run as your normal PXY user, not root."
command -v sudo >/dev/null || fail "sudo is required."
command -v apt-get >/dev/null || fail "Requires Ubuntu/Debian apt."
touch "$HOME/.hushlogin"
sudo -v
sudo apt-get update
sudo apt-get install -y git python3 python3-venv python3-pip nodejs npm tmux openssh-client

if [[ -d "$ROOT/.git" ]]; then
    log "Existing repository preserved at $ROOT (run pxyupdate separately for code updates)."
elif [[ -e "$ROOT" ]]; then
    fail "$ROOT exists but is not a Git checkout; refusing to overwrite it."
else
    log "Cloning private PXY repository; GitHub SSH access is required."
    git clone git@github.com:PreciseXceleratedYield/PXY.git "$ROOT"
fi
[[ -f "$APP/pxy.js" && -f "$APP/sys/sysexepxy.py" ]] || fail "Missing current PXY application files."

if [[ ! -x "$VENV/bin/python3" ]]; then
    python3 -m venv "$VENV"
fi
"$VENV/bin/python3" -m pip install --upgrade pip
[[ -f "$APP/pxyinstl" ]] || fail "Missing $APP/pxyinstl"
"$VENV/bin/python3" -m pip install -r "$APP/pxyinstl"

if [[ -f "$APP/pxy.json" ]]; then
    cp "$APP/pxy.json" "$APP/package.json"
elif [[ ! -f "$APP/package.json" ]]; then
    fail "Missing Node.js package manifest."
fi
( cd "$APP" && npm install --no-audit --no-fund )

mkdir -p "$BIN"
for file in "$APP"/*; do
    [[ -f "$file" && "${file##*/}" != *.* ]] || continue
    install -m 755 "$file" "$BIN/${file##*/}"
done
log "Installed commands in $BIN"

[[ -f "$ROOT/.bashrc" ]] || fail "Missing Git-managed $ROOT/.bashrc"
if [[ -f "$HOME/.bashrc" ]] && ! cmp -s "$ROOT/.bashrc" "$HOME/.bashrc"; then
    backup="$HOME/.bashrc.pxy-backup-$(date +%Y%m%d-%H%M%S)"
    cp -p "$HOME/.bashrc" "$backup"
    log "Backed up previous .bashrc: $backup"
fi
install -m 644 "$ROOT/.bashrc" "$HOME/.bashrc"
log "Login will show the copyright notice from syscprtpxy.py (if dependencies are available)."

[[ -f "$APP/pxywatch" ]] || fail "Missing pxywatch."
if command -v systemctl >/dev/null && [[ -d /run/systemd/system ]]; then
    bash "$APP/pxywatch" install
    sudo systemctl enable pxywatch.service
    if systemctl is-active --quiet pxywatch.service; then
        log "Watchdog already running; not restarting it or the tmux sessions."
    else
        sudo systemctl start pxywatch.service
        log "Watchdog started (will monitor existing engine/dashboard processes)."
    fi
else
    log "systemd unavailable; watchdog not installed."
fi
log "Installation complete. Open a new Bash session to see the login banner."
log "No running trading engine or dashboard was deliberately stopped or restarted."
