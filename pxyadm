#!/bin/sh
# PXY self-updating cross-platform SSH launcher.
set -eu

SELF=$0
case "$SELF" in
  /*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
SELF="$SELF_DIR/$(basename -- "$SELF")"
USER_BIN="${HOME}/.local/bin"
TARGET="$USER_BIN/pxyadm"

# Download-and-run bootstrap: install to a user-owned directory, never sudo.
if [ "$SELF" != "$TARGET" ]; then
  mkdir -p "$USER_BIN"
  if [ ! -f "$TARGET" ] || ! cmp -s "$SELF" "$TARGET"; then
    install -m 755 "$SELF" "$TARGET"
    printf 'pxyadm: installed in %s (no sudo).\n' "$TARGET"
  fi
  # Retire only the known legacy launcher, if owned/writable by this user.
  LEGACY=/usr/local/bin/pxyadm
  if [ -f "$LEGACY" ] && [ -w "$LEGACY" ] && [ -w /usr/local/bin ]; then
    if grep -q 'apk\|PreciseXceleratedYield' "$LEGACY" 2>/dev/null; then
      rm -f "$LEGACY" 2>/dev/null || :
    fi
  fi
  # Make the user-owned launcher first in PATH for future zsh sessions.
  case "$(uname -s)" in
    Darwin)
      PROFILE="$HOME/.zshrc"
      PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
      if [ ! -f "$PROFILE" ] || ! grep -Fqx "$PATH_LINE" "$PROFILE"; then
        printf '\\n%s\\n' "$PATH_LINE" >> "$PROFILE"
      fi
      ;;
  esac
  exec "$TARGET" "$@"
fi

# On each launch, check authenticated GitHub for a newer launcher.
if [ "${PXYADM_UPDATED:-0}" != 1 ] && command -v gh >/dev/null 2>&1; then
  TMP=$(mktemp "${TMPDIR:-/tmp}/pxyadm.XXXXXXXX") || TMP=
  if [ -n "$TMP" ]; then
    if gh api -H "Accept: application/vnd.github.raw+json" \
      "repos/PreciseXceleratedYield/PXY/contents/pxyadm?ref=main" >"$TMP" 2>/dev/null \
      && [ -s "$TMP" ] \
      && [ "$(head -n 1 "$TMP")" = '#!/bin/sh' ] \
      && grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$TMP" \
      && ! cmp -s "$TMP" "$SELF"; then
      chmod 755 "$TMP"
      if mv -f "$TMP" "$SELF"; then
        printf 'pxyadm: updated from GitHub main.\n'
        PXYADM_UPDATED=1
        export PXYADM_UPDATED
        exec "$SELF" "$@"
      fi
    fi
    [ ! -f "$TMP" ] || rm -f "$TMP"
  fi
fi

if ! command -v ssh >/dev/null 2>&1; then
  printf 'pxyadm: SSH client not found.\n' >&2
  exit 1
fi

REMOTE_USER=${PXY_SSH_USER:-pxy}
REMOTE_HOST=${PXY_SSH_HOST:-20.219.143.148}
exec ssh -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
