#!/bin/sh
# PXY self-updating cross-platform SSH launcher.
set -eu

SELF=$0
case "$SELF" in
  /*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac

# Obtain the latest version from authenticated GitHub CLI (private repo).
# No anonymous downloads, embedded passwords, or automatic privilege escalation.
if [ "${PXYADM_UPDATED:-0}" != 1 ] && command -v gh >/dev/null 2>&1; then
  TMP=$(mktemp "${TMPDIR:-/tmp}/pxyadm.XXXXXXXX") || TMP=
  if [ -n "$TMP" ]; then
    if gh api -H "Accept: application/vnd.github.raw+json" \
      "repos/PreciseXceleratedYield/PXY/contents/pxyadm?ref=main" >"$TMP" 2>/dev/null \
      && [ -s "$TMP" ] \
      && [ "$(head -n 1 "$TMP")" = '#!/bin/sh' ] \
      && grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$TMP"; then
      if ! cmp -s "$TMP" "$SELF"; then
        if [ -w "$SELF" ]; then
          chmod 755 "$TMP"
          if mv -f "$TMP" "$SELF"; then
            printf 'pxyadm: updated to latest GitHub main.\n'
            PXYADM_UPDATED=1
            export PXYADM_UPDATED
            exec "$SELF" "$@"
          fi
        else
          printf 'pxyadm: newer version available, but %s is not writable.\n' "$SELF" >&2
          printf 'pxyadm: install it once with appropriate permissions for automatic updates.\n' >&2
        fi
      fi
    fi
    [ ! -f "$TMP" ] || rm -f "$TMP"
  fi
fi

if ! command -v ssh >/dev/null 2>&1; then
  printf 'pxyadm: SSH client not found.\n' >&2
  exit 1
fi

REMOTE_USER=${PXY_SSH_USER:-pxy}
REMOTE_HOST=${PXY_SSH_HOST:-20.219.143.148}
exec ssh -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
