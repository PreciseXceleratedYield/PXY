#!/bin/sh
# PXY self-updating cross-platform SSH launcher.
set -eu

SELF=$0
case "$SELF" in
  /*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
SELF="$SELF_DIR/$(basename -- "$SELF")"
USER_BIN="${HOME}/.local/bin"
TARGET="$USER_BIN/pxyadm"

# Download-and-run bootstrap: install to a user-owned directory, never sudo.
if [ "$SELF" != "$TARGET" ]; then
  mkdir -p "$USER_BIN"
  if [ ! -f "$TARGET" ] || ! cmp -s "$SELF" "$TARGET"; then
    install -m 755 "$SELF" "$TARGET"
    printf 'pxyadm: installed in %s (no sudo).\n' "$TARGET"
  fi
  # Retire only the known legacy launcher, if owned/writable by this user.
  LEGACY=/usr/local/bin/pxyadm
  if [ -f "$LEGACY" ] && [ -w "$LEGACY" ] && [ -w /usr/local/bin ]; then
    if grep -q 'apk\|PreciseXceleratedYield' "$LEGACY" 2>/dev/null; then
      rm -f "$LEGACY" 2>/dev/null || :
    fi
  fi
  # Make the user-owned launcher first in PATH for future zsh sessions.
  case "$(uname -s)" in
    Darwin)
      PROFILE="$HOME/.zshrc"
      PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
      if [ ! -f "$PROFILE" ] || ! grep -Fqx "$PATH_LINE" "$PROFILE"; then
        printf '\\n%s\\n' "$PATH_LINE" >> "$PROFILE"
      fi
      ;;
  esac
  exec "$TARGET" "$@"
fi

# On each launch, check authenticated GitHub for a newer launcher.
if [ "${PXYADM_UPDATED:-0}" != 1 ] && command -v gh >/dev/null 2>&1; then
  TMP=$(mktemp "${TMPDIR:-/tmp}/pxyadm.XXXXXXXX") || TMP=
  if [ -n "$TMP" ]; then
    if gh api -H "Accept: application/vnd.github.raw+json" \
      "repos/PreciseXceleratedYield/PXY/contents/pxyadm?ref=main" >"$TMP" 2>/dev/null \
      && [ -s "$TMP" ] \
      && [ "$(head -n 1 "$TMP")" = '#!/bin/sh' ] \
      && grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$TMP" \
      && ! cmp -s "$TMP" "$SELF"; then
      chmod 755 "$TMP"
      if mv -f "$TMP" "$SELF"; then
        printf 'pxyadm: updated from GitHub main.\n'
        PXYADM_UPDATED=1
        export PXYADM_UPDATED
        exec "$SELF" "$@"
      fi
    fi
    [ ! -f "$TMP" ] || rm -f "$TMP"
  fi
fi

if ! command -v ssh >/dev/null 2>&1; then
  printf 'pxyadm: SSH client not found.\n' >&2
  exit 1
fi

REMOTE_USER=${PXY_SSH_USER:-pxy}
REMOTE_HOST=${PXY_SSH_HOST:-20.219.143.148}
# Password mode: use OS credential vault only; never save plaintext.
# Requires sshpass and a supported credential store.
SERVICE="PXY-SSH-$REMOTE_HOST"
case "$(uname -s)" in
  Darwin)
    if command -v security >/dev/null 2>&1; then
      STORE=keychain
    else
      STORE=none
    fi
    ;;
  Linux)
    if command -v secret-tool >/dev/null 2>&1; then
      STORE=secret-service
    else
      STORE=none
    fi
    ;;
  *) STORE=none ;;
esac

if [ "$STORE" = none ] || ! command -v sshpass >/dev/null 2>&1; then
  printf 'pxyadm: secure password auto-login unavailable (needs sshpass and an OS credential vault).\n' >&2
  exec ssh -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
fi

if [ "${1:-}" = "--reset-password" ]; then
  case "$STORE" in
    keychain) security delete-generic-password -s "$SERVICE" -a "$REMOTE_USER" >/dev/null 2>&1 || : ;;
    secret-service) secret-tool clear application pxyadm host "$REMOTE_HOST" user "$REMOTE_USER" || : ;;
  esac
  printf 'pxyadm: stored password cleared.\n'
  exit 0
fi

get_saved_password() {
  case "$STORE" in
    keychain) security find-generic-password -s "$SERVICE" -a "$REMOTE_USER" -w 2>/dev/null ;;
    secret-service) secret-tool lookup application pxyadm host "$REMOTE_HOST" user "$REMOTE_USER" 2>/dev/null ;;
  esac
}
PASSWORD=$(get_saved_password) || PASSWORD=
if [ -z "$PASSWORD" ]; then
  printf 'PXY Linux password (stored in %s): ' "$STORE" >&2
  STTY_STATE=$(stty -g 2>/dev/null || :)
  stty -echo 2>/dev/null || :
  IFS= read -r PASSWORD
  if [ -n "$STTY_STATE" ]; then stty "$STTY_STATE" 2>/dev/null || :; fi
  printf '\n' >&2
  [ -n "$PASSWORD" ] || { printf 'pxyadm: empty password; aborting.\n' >&2; exit 1; }
  # Verify before saving, so mistyped passwords are never persisted.
  if ! SSHPASS="$PASSWORD" sshpass -e ssh -o BatchMode=no -o PubkeyAuthentication=no \
    -o PreferredAuthentications=password -o NumberOfPasswordPrompts=1 \
    -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$REMOTE_USER@$REMOTE_HOST" true; then
    printf 'pxyadm: password verification failed; nothing saved.\n' >&2
    exit 1
  fi
  case "$STORE" in
    keychain) security add-generic-password -U -s "$SERVICE" -a "$REMOTE_USER" -w "$PASSWORD" >/dev/null ;;
    secret-service) printf '%s' "$PASSWORD" | secret-tool store --label="PXY SSH $REMOTE_HOST" application pxyadm host "$REMOTE_HOST" user "$REMOTE_USER" ;;
  esac
  printf 'pxyadm: password saved in %s.\n' "$STORE"
fi
export SSHPASS="$PASSWORD"
unset PASSWORD
exec sshpass -e ssh -o StrictHostKeyChecking=accept-new \
  -o PubkeyAuthentication=no -o PreferredAuthentications=password \
  "$REMOTE_USER@$REMOTE_HOST"
