#!/bin/sh
# PXY self-updating cross-platform SSH launcher.
set -eu

SELF=$0
case "$SELF" in
  /*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
SELF="$SELF_DIR/$(basename -- "$SELF")"
USER_BIN="${HOME}/.local/bin"
TARGET="$USER_BIN/pxyadm"

# Download-and-run bootstrap: install to a user-owned directory, never sudo.
if [ "$SELF" != "$TARGET" ]; then
  mkdir -p "$USER_BIN"
  if [ ! -f "$TARGET" ] || ! cmp -s "$SELF" "$TARGET"; then
    install -m 755 "$SELF" "$TARGET"
    printf 'pxyadm: installed in %s (no sudo).\n' "$TARGET"
  fi
  # Retire only the known legacy launcher, if owned/writable by this user.
  LEGACY=/usr/local/bin/pxyadm
  if [ -f "$LEGACY" ] && [ -w "$LEGACY" ] && [ -w /usr/local/bin ]; then
    if grep -q 'apk\|PreciseXceleratedYield' "$LEGACY" 2>/dev/null; then
      rm -f "$LEGACY" 2>/dev/null || :
    fi
  fi
  # Make the user-owned launcher first in PATH for future zsh sessions.
  case "$(uname -s)" in
    Darwin)
      PROFILE="$HOME/.zshrc"
      PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
      if [ ! -f "$PROFILE" ] || ! grep -Fqx "$PATH_LINE" "$PROFILE"; then
        printf '\\n%s\\n' "$PATH_LINE" >> "$PROFILE"
      fi
      ;;
  esac
  exec "$TARGET" "$@"
fi

# On each launch, check authenticated GitHub for a newer launcher.
if [ "${PXYADM_UPDATED:-0}" != 1 ] && command -v gh >/dev/null 2>&1; then
  TMP=$(mktemp "${TMPDIR:-/tmp}/pxyadm.XXXXXXXX") || TMP=
  if [ -n "$TMP" ]; then
    if gh api -H "Accept: application/vnd.github.raw+json" \
      "repos/PreciseXceleratedYield/PXY/contents/pxyadm?ref=main" >"$TMP" 2>/dev/null \
      && [ -s "$TMP" ] \
      && [ "$(head -n 1 "$TMP")" = '#!/bin/sh' ] \
      && grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$TMP" \
      && ! cmp -s "$TMP" "$SELF"; then
      chmod 755 "$TMP"
      if mv -f "$TMP" "$SELF"; then
        printf 'pxyadm: updated from GitHub main.\n'
        PXYADM_UPDATED=1
        export PXYADM_UPDATED
        exec "$SELF" "$@"
      fi
    fi
    [ ! -f "$TMP" ] || rm -f "$TMP"
  fi
fi

if ! command -v ssh >/dev/null 2>&1; then
  printf 'pxyadm: SSH client not found.\n' >&2
  exit 1
fi

REMOTE_USER=${PXY_SSH_USER:-pxy}
REMOTE_HOST=${PXY_SSH_HOST:-20.219.143.148}
# macOS: one-time SSH-key enrollment; Keychain remembers the key passphrase.
# The Linux account password is requested by SSH during enrollment only.
if [ "$(uname -s)" = Darwin ]; then
  KEY="$HOME/.ssh/pxy_ed25519"
  ENROLLED="$HOME/.ssh/pxy_ed25519.enrolled"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  if [ ! -f "$KEY" ] && [ ! -f "$KEY.pub" ]; then
    printf 'pxyadm: creating a dedicated SSH key. Choose a key passphrase; macOS Keychain will remember it.\\n'
    ssh-keygen -t ed25519 -f "$KEY" -C "PXY Mac SSH"
  fi
  if [ -f "$KEY" ] && [ -f "$KEY.pub" ]; then
    chmod 600 "$KEY"
    if ! ssh-add --apple-use-keychain "$KEY" 2>/dev/null; then
      ssh-add -K "$KEY" 2>/dev/null || :
    fi
    if [ ! -f "$ENROLLED" ]; then
      if ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \\
        -o IdentitiesOnly=yes -i "$KEY" "$REMOTE_USER@$REMOTE_HOST" true 2>/dev/null; then
        : > "$ENROLLED"
      else
        printf 'pxyadm: one-time setup. Enter your Linux server password to authorize this Mac.\\n'
        if cat "$KEY.pub" | ssh -o StrictHostKeyChecking=accept-new \\
          -o PreferredAuthentications=password,keyboard-interactive \\
          -o PubkeyAuthentication=no "$REMOTE_USER@$REMOTE_HOST" \\
          'umask 077; mkdir -p "$HOME/.ssh"; touch "$HOME/.ssh/authorized_keys"; chmod 700 "$HOME/.ssh"; chmod 600 "$HOME/.ssh/authorized_keys"; IFS= read -r key; grep -Fqx "$key" "$HOME/.ssh/authorized_keys" || printf "%s\\n" "$key" >> "$HOME/.ssh/authorized_keys"'; then
          : > "$ENROLLED"
          printf 'pxyadm: SSH key authorized. Future logins use the key.\\n'
        else
          printf 'pxyadm: key setup unsuccessful; falling back to normal SSH.\\n' >&2
        fi
      fi
    fi
    exec ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes \\
      -o UseKeychain=yes -i "$KEY" "$REMOTE_USER@$REMOTE_HOST"
  fi
fi
exec ssh -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
